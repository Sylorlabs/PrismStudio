// main.zag — photonic CPU designer entry point. 100% Zag, no C anywhere.
//
// Default mode talks straight to the X server over its unix socket via
// src/x11.zag (pure-Zag X11 wire protocol on the _zag_raw_syscall intrinsic).
//
// `--pipe` runs the headless line protocol on stdin/stdout (used by automated
// interaction tests):
//   in : I mx my btn wheel mods keyc k0 k1 k2 k3 k4 k5 w h
//   out: F <w> <h> <frame>   (after writing /dev/shm/zagpa_fb.bin)
//
// `--smoke [out.bmp]` builds a demo processor, runs the wave sim, renders one
// frame headless, and writes a BMP screenshot (used for CI/verification).

@import("../std/list.zag") as list
@import("workspace.zag")
@import("x11.zag")
@import("agent.zag")
@import("mcp.zag")
@import("session.zag")
@import("gpu_rt.zag")
@import("gpu_isa_display.zag")
@import("gpu_backend.zag")
@import("std:gpu")
@import("std:linux_gpu_isolation")

fn fb_path() []u8 { return "/dev/shm/zagpa_fb.bin"; }

fn arg_has(want: []u8) bool {
    let i: i32 = 1;
    while (i < _zag_argc()) {
        if (_zag_strcmp(_zag_arg(i), want) == 1) { return true; }
        i = i + 1;
    }
    return false;
}

fn arg_after(want: []u8, fallback: []u8) []u8 {
    let i: i32 = 1;
    while (i + 1 < _zag_argc()) {
        if (_zag_strcmp(_zag_arg(i), want) == 1) { return _zag_arg(i + 1); }
        i = i + 1;
    }
    return fallback;
}

fn arg_i_after(want: []u8, fallback: i32) i32 {
    let raw: []u8 = arg_after(want, "");
    if (raw.len == 0) { return fallback; }
    return _zag_str_to_i64(raw) as i32;
}

// ── stdin line reader ─────────────────────────────────────────────────────────

struct LineBuf {
    buf: list.ArrayList[u8],
    eof: bool,
}

fn read_line(lb: *LineBuf) void {
    lb.*.buf.len = 0;
    let one: list.ArrayList[u8] = list.make[u8](1);
    let running: bool = true;
    while (running) {
        let n: i32 = _zag_read_fd(0, one.data as *i8, 1);
        if (n <= 0) {
            lb.*.eof = true;
            running = false;
        } else {
            let c: i32 = one.data[0] as i32;
            if (c == 10) {
                running = false;
            } else {
                list.push[u8](&lb.*.buf, one.data[0]);
            }
        }
    }
    list.free[u8](&one);
}

// Parse whitespace-separated integers from a line into `out`.
fn parse_ints(line: []u8, out: *list.ArrayList[i64]) void {
    out.*.len = 0;
    let i: i32 = 0;
    while (i < line.len) {
        // skip spaces
        while (i < line.len && (line[i] as i32) == 32) { i = i + 1; }
        let start: i32 = i;
        while (i < line.len && (line[i] as i32) != 32) { i = i + 1; }
        if (i > start) {
            list.push[i64](out, _zag_str_to_i64(line[start..i]));
        }
    }
}

// ── smoke mode ────────────────────────────────────────────────────────────────

fn run_smoke(out_path: []u8) i32 {
    let a: *App = app_new(1440, 900);
    // `--scale N` renders the same logical layout into an N× physical buffer,
    // which is how the HiDPI present path works at runtime. Useful for
    // eyeballing that arcs/text stay smooth instead of being upscaled.
    let sc: i32 = arg_i_after("--scale", 1);
    if (sc < 1) { sc = 1; }
    if (sc > 3) { sc = 3; }
    if (sc > 1) {
        a.*.ui_scale = sc;
        fb_set_scale(&a.*.f, sc);
    }
    app_action_demo(a);
    sel_set(a, 4);   // a chamber, exercises the inspector + scope

    // run the ternary fabric for a while
    sim_recompile(a.*.sim, a.*.scene);
    let i: i32 = 0;
    while (i < 24) {
        sim_step(a.*.sim, a.*.scene);
        i = i + 1;
    }

    // synth input mid-viewport, render a few frames
    a.*.inp.mx = 700;
    a.*.inp.my = 380;
    let fi: i32 = 0;
    while (fi < 3) {
        app_frame(a, 0.016);
        fi = fi + 1;
    }
    fb_write_bmp(&a.*.f, out_path);
    _zag_print("smoke: wrote ");
    _zag_println(out_path);
    _zag_print("smoke: comps=");
    print_i32(a.*.scene.*.comps.len);
    _zag_print("smoke: guides=");
    print_i32(a.*.scene.*.guides.len);
    _zag_print("smoke: symbol=");
    print_i64(a.*.sim.*.symbol);
    _zag_print("smoke: frame_ms=");
    print_i64(a.*.frame_ms);
    return 0;
}

fn run_gpu_virtual_display(out_path: []u8, w: i32, h: i32) i32 {
    if(w<64||h<64||w>1024||h>1024){_zag_eprintln("gpu-virtual-display: dimensions outside 64..1024");return 1;}
    let d:GpuIsaDisplay=gpu_isa_display_open("examples/gpu_fill_kernel.zgk",w,h);
    let frame:FB=fb_new(w,h);
    if(!d.ok||!gpu_isa_display_begin(&d)){_zag_eprintln("gpu-virtual-display: VM initialization failed");return 1;}
    let y:i32=0;let ok:bool=true;
    while(y<h&&ok){ok=gpu_isa_display_fill(&d,y*w,w,rgb(8,12,20));y=y+1;}
    let by:i32=0;
    while(by<h&&ok){let bx:i32=0;while(bx<w&&ok){
        let bw:i32=32;if(bx+bw>w){bw=w-bx;}let bh:i32=24;if(by+bh>h){bh=h-by;}
        if(((bx/32)+(by/24))%2==0){ok=gpu_isa_display_fill_rect(&d,bx,by,bw,bh,rgb(32+(bx%160),48+(by%160),190));}
        bx=bx+32;
    }by=by+24;}
    if(!ok||!gpu_isa_display_end(&d)||!gpu_isa_display_present(&d,&frame)){_zag_eprintln("gpu-virtual-display: execution failed");return 1;}
    fb_write_bmp(&frame,out_path);
    _zag_print("gpu-virtual-display: wrote ");_zag_println(out_path);
    _zag_print("gpu-virtual-display: submissions=");println_i64(d.queue.submissions);
    _zag_print("gpu-virtual-display: decoded_instructions=");println_i64(d.queue.instructions);
    return 0;
}

fn run_gpu_virtual_shadow(out_path: []u8, w: i32, h: i32) i32 {
    if(w<320||h<240||w>1024||h>1024){_zag_eprintln("gpu-virtual-shadow: dimensions outside 320..1024");return 1;}
    _zag_eprintln("gpu-virtual-shadow: initializing CPU oracle");
    let a:*App=app_new(w,h);
    _zag_eprintln("gpu-virtual-shadow: loading reference design");
    app_action_demo(a);
    _zag_eprintln("gpu-virtual-shadow: rendering CPU oracle");
    app_frame(a,0.016);
    _zag_eprintln("gpu-virtual-shadow: executing compiler-ISA shadow");
    let d:GpuIsaDisplay=gpu_isa_display_open("examples/gpu_fill_kernel.zgk",w,h);
    let candidate:FB=fb_new(w,h);
    let ok:bool=d.ok&&gpu_isa_display_begin(&d)&&gpu_isa_display_upload_frame(&d,&a.*.f)&&
        gpu_isa_display_end(&d)&&gpu_isa_display_present(&d,&candidate)&&gpu_isa_display_equal(&a.*.f,&candidate);
    if(!ok){_zag_eprintln("gpu-virtual-shadow: full-frame comparison failed");return 1;}
    fb_write_bmp(&candidate,out_path);
    _zag_print("gpu-virtual-shadow: wrote ");_zag_println(out_path);
    _zag_print("gpu-virtual-shadow: submissions=");println_i64(d.queue.submissions);
    _zag_print("gpu-virtual-shadow: decoded_instructions=");println_i64(d.queue.instructions);
    return 0;
}

// ── interactive main loop ─────────────────────────────────────────────────────

fn run_interactive() i32 {
    let a: *App = app_new(1440, 900);
    app_action_demo(a);

    let lb: LineBuf = LineBuf{ .buf = list.make[u8](160), .eof = false };
    let ints: list.ArrayList[i64] = list.make[i64](20);
    let last_ms: i64 = _zag_clock_monotonic_ms();

    let running: bool = true;
    while (running) {
        read_line(&lb);
        if (lb.eof) {
            running = false;
        } else {
            if (lb.buf.len > 2 && (lb.buf.data[0] as i32) == 'I') {
                let line: []u8 = lb.buf.data[1..lb.buf.len];
                parse_ints(line, &ints);
                if (ints.len >= 14) {
                    let inp: *Input = &a.*.inp;
                    inp.*.prev_btn = inp.*.btn;
                    inp.*.mx = list.get[i64](ints, 0) as i32;
                    inp.*.my = list.get[i64](ints, 1) as i32;
                    inp.*.btn = list.get[i64](ints, 2) as i32;
                    inp.*.wheel = list.get[i64](ints, 3) as i32;
                    inp.*.mods = list.get[i64](ints, 4) as i32;
                    inp.*.keys.len = 0;
                    let kc: i32 = list.get[i64](ints, 5) as i32;
                    if (kc > 6) { kc = 6; }
                    let k: i32 = 0;
                    while (k < kc) {
                        list.push[i32](&inp.*.keys, list.get[i64](ints, 6 + k) as i32);
                        k = k + 1;
                    }
                    inp.*.w = list.get[i64](ints, 12) as i32;
                    inp.*.h = list.get[i64](ints, 13) as i32;

                    // F1 = load the demo design
                    if (key_hit(inp, 290)) { app_action_demo(a); }

                    let now: i64 = _zag_clock_monotonic_ms();
                    let dt: f64 = ((now - last_ms) as f64) / 1000.0;
                    if (dt > 0.1) { dt = 0.1; }
                    last_ms = now;

                    app_frame(a, dt);
                    fb_write_shm(&a.*.f, fb_path());

                    _zag_print("F ");
                    print_i64(a.*.inp.w as i64);
                    _zag_print(" ");
                    print_i64(a.*.inp.h as i64);
                    _zag_print(" ");
                    print_i64(a.*.frame);
                    _zag_print("\n");
                    _zag_flush();
                }
            }
        }
    }
    return 0;
}

// ── native X11 main loop (pure Zag; no shim, no C) ────────────────────────────

fn app_title(a: *App) []u8 {
    let base: []u8 = a.*.file_;
    if (a.*.dirty) { base = _zag_str_concat(a.*.file_, " *"); }
    return _zag_str_concat(base, " - PrismStudio");
}

// Report the GPU the pure-Zag DRM runtime detects (real device query, no
// libdrm/Mesa). Zero exit whether or not a render node is present.
fn run_gpu_info() i32 {
    let g: Gpu = gpu_open();
    if (!g.ok) {
        _zag_println("gpu: no amdgpu render node — the viewport uses the CPU rasterizer");
        return 0;
    }
    _zag_println("gpu: amdgpu render node (queried via pure-Zag DRM ioctls)");
    _zag_print("  render minor  : ");
    println_i64(g.render_minor as i64);
    _zag_print("  PCI device id : ");
    println_i64(g.device_id);
    _zag_print("  family        : ");
    println_i64(g.family);
    _zag_print("  shader engines: ");
    println_i64(g.shader_engines);
    _zag_print("  compute units : ");
    println_i64(g.cu_active);
    _zag_print("  engine clock  : ");
    print_i64(g.engine_clock_khz / 1000);
    _zag_println(" MHz");
    _zag_print("  memory clock  : ");
    print_i64(g.memory_clock_khz / 1000);
    _zag_println(" MHz");
    _zag_print("  GFX IP/rings  : ");
    print_i64(g.gfx_ip_major as i64); _zag_print(".");
    print_i64(g.gfx_ip_minor as i64); _zag_print(" / ");
    println_i64(g.gfx_rings);
    _zag_print("  compute IP/rings: ");
    print_i64(g.compute_ip_major as i64); _zag_print(".");
    print_i64(g.compute_ip_minor as i64); _zag_print(" / ");
    println_i64(g.compute_rings);
    _zag_print("  MEC/SDMA firmware: ");
    print_i64(g.fw_mec_ver); _zag_print(" / ");
    println_i64(g.fw_sdma_ver);
    _zag_print("  VRAM total/usable: ");
    print_i64(g.vram_total); _zag_print(" / ");
    println_i64(g.vram_usable);
    _zag_print("  GTT total/usable : ");
    print_i64(g.gtt_total); _zag_print(" / ");
    println_i64(g.gtt_usable);
    _zag_print("  RAS enabled mask : ");
    println_i64(g.ras_enabled);
    _zag_print("  last VM fault query/status: ");
    if (g.fault_query_ok) {
        print_i64(g.fault_addr); _zag_print(" / ");
        println_i64(g.fault_status);
    } else { _zag_println("unavailable"); }
    gpu_close(&g);
    return 0;
}

fn gpu_file_hash(path:[]u8) i64 {
    let raw:[]u8=_zag_read_file(path);if(raw.len<0){return 0;}return gfxvm_hash(raw);
}

// Read-only certification status. This fingerprints the exact live tuple and
// explains why automatic use is denied; it never allocates a BO or submits work.
fn run_gpu_cert_status() i32 {
    let g:Gpu=gpu_open();
    if(!g.ok){_zag_println("gpu-cert: denied code=10 reason=no AMDGPU render node next=use CPU or virtual ISA execution");return 0;}
    let root:[]u8=prepend_f("/sys/class/drm/renderD",fmt_i(g.render_minor as i64));
    root=append_f(root,"/device");let iso:LinuxGpuIsolation=linux_gpu_isolation_probe(root);
    let kh:i64=(gpu_file_hash("examples/gpu_fill_kernel.zgk")*3+
        gpu_file_hash("examples/gpu_depth_kernel.zgk")*5+gpu_file_hash("examples/gpu_blend_kernel.zgk")*7)%4294967296;
    let t:ZagGpuTuple=ZagGpuTuple{.device=g.device_id,.gfx_ip=(g.gfx_ip_major as i64)*100+(g.gfx_ip_minor as i64),
        .gfx_discovery=g.gfx_ip_discovery,.gfx_rings=g.gfx_rings,
        .compute_ip=(g.compute_ip_major as i64)*100+(g.compute_ip_minor as i64),
        .compute_discovery=g.compute_ip_discovery,.compute_rings=g.compute_rings,
        .mec_firmware=g.fw_mec_ver,.sdma_firmware=g.fw_sdma_ver,.kernel=kh,
        .compiler=gpu_file_hash("../zag/zag-poc/znc"),.runtime=gpu_file_hash("zagpa")};
    let c:ZagGpuCertification=ZagGpuCertification{.tuple=t,.reset_isolated=iso.destructive_test_safe,
        .memory_sync_verified=false,.kernel_log_clean=false,.fills=0,.ownership_transfers=0,
        .dispatches=0,.soak_seconds=0,.mismatches=0,.timeouts=0,.resets=0,.faults=0,.leaks=0};
    let b:ZagGpuBenefit=ZagGpuBenefit{.samples=0,.cpu_ns=0,.gpu_ns=0,.representative=false,.raw_samples_retained=false};
    let d:ZagGpuDecision=zag_gpu_auto_decide(t,c,b,200);
    let req:ZagGpuExecutionRequest=ZagGpuExecutionRequest{.tier=zag_gpu_tier_physical_bounded(),
        .display_bound=true,.reset_isolated=iso.destructive_test_safe,
        .process_isolation=iso.process_cleaner,.driver_recovery=false,
        .compiler_proved_straight_line=true,.manifest_verified=kh!=0,
        .workgroups=1,.instructions=59,.writable_bytes=4,.deadline_ms=50,
        .allow_shared_display_override=false,.acknowledge_reset_or_system_hang=false};
    let containment:ZagGpuDecision=zag_gpu_execution_decide(req);
    _zag_print("gpu-cert: tuple device=");print_i64(t.device);
    _zag_print(" gfx_ip=");print_i64(t.gfx_ip);
    _zag_print(" gfx_discovery=");print_i64(t.gfx_discovery);
    _zag_print(" gfx_rings=");print_i64(t.gfx_rings);
    _zag_print(" compute_ip=");print_i64(t.compute_ip);
    _zag_print(" compute_discovery=");print_i64(t.compute_discovery);
    _zag_print(" compute_rings=");print_i64(t.compute_rings);
    _zag_print(" mec=");print_i64(t.mec_firmware);
    _zag_print(" sdma=");print_i64(t.sdma_firmware);_zag_print(" kernels=");print_i64(t.kernel);
    _zag_print(" compiler=");print_i64(t.compiler);_zag_print(" runtime=");println_i64(t.runtime);
    _zag_print("gpu-cert: isolation=");_zag_print(linux_gpu_isolation_name(iso.level));
    _zag_print(" auto=");if(d.allowed){_zag_println("allowed");}else{_zag_print("denied code=");println_i64(d.code as i64);}
    _zag_print("gpu-cert: reason=");_zag_println(d.reason);_zag_print("gpu-cert: next=");_zag_println(d.next_action);
    _zag_print("gpu-cert: physical-containment=");if(containment.allowed){_zag_println("admitted");}else{
        _zag_print("denied code=");println_i64(containment.code as i64);}
    _zag_print("gpu-cert: containment-reason=");_zag_println(containment.reason);
    gpu_close(&g);return 0;
}

fn run_gpu_backend_status()i32{
    let name:[]u8=arg_after("--gpu-backend-status",_zag_getenv("PRISM_GPU_BACKEND"));
    let status:PrismGpuBackendStatus=prism_gpu_backend_resolve(name);
    _zag_print("gpu-backend: requested=");_zag_print(zag_gpu_backend_name(status.requested));
    _zag_print(" selected=");_zag_print(zag_gpu_backend_name(status.choice.selected));
    _zag_print(" ok=");print_i64(status.choice.ok as i64);
    _zag_print(" code=");println_i64(status.choice.code as i64);
    _zag_print("gpu-backend: reason=");_zag_println(status.choice.reason);
    _zag_print("gpu-backend: drm_probed=");print_i64(status.drm_probed as i64);
    _zag_print(" render_minor=");print_i64(status.render_minor as i64);
    _zag_print(" isolation=");_zag_println(linux_gpu_isolation_name(status.isolation_level));
    if(!status.choice.ok){return 1;}return 0;
}

fn run_x11() i32 {
    let win_w: i32 = 1680;
    let win_h: i32 = 1050;
    let a: *App = app_new(win_w, win_h);
    session_bind(a);
    app_layout_load(a);

    let x: *X11 = x11_connect(win_w, win_h, app_title(a));
    if (!x.*.ok) {
        _zag_eprintln("no X server available; try --pipe or --smoke");
        return 1;
    }
    // Start from the server-reported display density. The current compositor
    // accepts integral UI scales; the X11 boundary retains the measured
    // quarter-step recommendation so native fractional rasterization can use
    // the same source of truth without another protocol change.
    let density: X11DisplayDensity = x11_display_density(x);
    if (density.scale >= 2.75) { a.*.ui_scale = 3; }
    else if (density.scale >= 1.75) { a.*.ui_scale = 2; }
    // A large low-DPI desktop still needs a legible CAD workspace.  The
    // original density-only rule rendered the 5x9 face at its smallest size
    // on common 2K displays, making controls and design feedback unreadable.
    // Keep the logical canvas compact enough for a useful working scale while
    // preserving the explicit Settings override for users who prefer 1x.
    else if (x.*.win_w >= 1900 || x.*.win_h >= 1100) { a.*.ui_scale = 2; }
    else { a.*.ui_scale = 1; }
    a.*.title_dirty = false;

    // Physical-resolution rendering: the FB buffer is physical-sized
    // (logical_w * scale × logical_h * scale) but all drawing uses logical
    // coordinates. No separate upscale pass — primitives scale internally.
    let uscale0: i32 = a.*.ui_scale;
    a.*.inp.w = x.*.win_w / uscale0;
    a.*.inp.h = x.*.win_h / uscale0;
    fb_resize(&a.*.f, a.*.inp.w, a.*.inp.h);
    fb_set_scale(&a.*.f, uscale0);
    app_frame(a, 0.016);
    if (arg_has("--test-pattern")) { fb_test_pattern(&a.*.f); }
    if (arg_has("--dump-frame")) {
        let dump: []u8 = arg_after("--dump-frame", "out.ppm");
        fb_write_ppm(&a.*.f, dump);
        _zag_print("ui: wrote CPU framebuffer "); _zag_println(dump);
    }
    if (arg_has("--ui-debug")) {
        _zag_println("ui: renderer=cpu backend=x11");
        _zag_print("ui: window_width="); println_i64(x.*.win_w as i64);
        _zag_print("ui: window_height="); println_i64(x.*.win_h as i64);
        _zag_print("ui: framebuffer_width="); println_i64(fb_pw(&a.*.f) as i64);
        _zag_print("ui: framebuffer_height="); println_i64(fb_ph(&a.*.f) as i64);
        _zag_print("ui: logical_width="); println_i64(a.*.f.w as i64);
        _zag_print("ui: logical_height="); println_i64(a.*.f.h as i64);
        _zag_print("ui: bytes_per_pixel="); println_i64((x.*.pixmap_bpp / 8) as i64);
        _zag_print("ui: stride="); println_i64((fb_pw(&a.*.f) * (x.*.pixmap_bpp / 8)) as i64);
        _zag_print("ui: depth="); println_i64(x.*.root_depth as i64);
        _zag_print("ui: bits_per_pixel="); println_i64(x.*.pixmap_bpp as i64);
        _zag_print("ui: scanline_pad="); println_i64(x.*.scanline_pad as i64);
        _zag_print("ui: display_dpi="); println_i64(density.dpi as i64);
        _zag_print("ui: density_source="); println_i64(density.source as i64);
        _zag_print("ui: scale="); println_i64(a.*.ui_scale as i64);
        _zag_println("ui: pixel_format=0x00RRGGBB");
    }
    x11_put_frame(x, a.*.f.px.data, fb_pw(&a.*.f), fb_ph(&a.*.f));
    x11_pump(x);

    let last_ms: i64 = _zag_clock_monotonic_ms();
    let running: bool = true;
    while (running) {
        x11_pump(x);
        if (x.*.should_close || a.*.quit) {
            running = false;
        } else {
            // mirror the X input state into the app, mapping physical pixels to
            // logical (HiDPI) space so the whole UI works in logical coordinates
            let uscale: i32 = a.*.ui_scale;
            if (uscale < 1) { uscale = 1; }
            if (uscale > 3) { uscale = 3; }
            a.*.ui_scale = uscale;
            let inp: *Input = &a.*.inp;
            inp.*.prev_btn = inp.*.btn;
            inp.*.mx = x.*.mx / uscale;
            inp.*.my = x.*.my / uscale;
            inp.*.btn = x.*.btn;
            inp.*.wheel = x.*.wheel;
            inp.*.mods = x.*.mods;
            inp.*.keys.len = 0;
            let k: i32 = 0;
            while (k < x.*.keys.len) {
                list.push[i32](&inp.*.keys, list.get[i32](x.*.keys, k));
                k = k + 1;
            }
            if (inp.*.keys_down.len < 128) {
                list.free[i32](&inp.*.keys_down);
                inp.*.keys_down = list.make[i32](128);
                inp.*.keys_down.len = 128;
            }
            let kd: i32 = 0;
            while (kd < 128) {
                inp.*.keys_down.data[kd] = x.*.keys_down.data[kd];
                kd = kd + 1;
            }
            inp.*.w = x.*.win_w / uscale;
            inp.*.h = x.*.win_h / uscale;

            if (key_hit(inp, 290)) { app_action_demo(a); }   // F1: demo design

            let now: i64 = _zag_clock_monotonic_ms();
            let dt: f64 = ((now - last_ms) as f64) / 1000.0;
            if (dt > 0.1) { dt = 0.1; }
            last_ms = now;

            session_tick(a);

            let t0: i64 = _zag_clock_monotonic_ms();
            // Detect a ui_scale change from a command during this frame and
            // re-allocate the FB at the new physical resolution before drawing.
            if (a.*.ui_scale != uscale) {
                uscale = a.*.ui_scale;
                if (uscale < 1) { uscale = 1; }
                if (uscale > 3) { uscale = 3; }
                a.*.ui_scale = uscale;
                a.*.inp.w = x.*.win_w / uscale;
                a.*.inp.h = x.*.win_h / uscale;
                fb_resize(&a.*.f, a.*.inp.w, a.*.inp.h);
                fb_set_scale(&a.*.f, uscale);
                a.*.present_full = true;
                a.*.present_none = false;
            }
            app_frame(a, dt);
            if (arg_has("--test-pattern")) { fb_test_pattern(&a.*.f); a.*.present_full = true; a.*.present_none = false; }
            // a resize/expose since last present forces a whole-frame upload
            if (x.*.needs_full) {
                a.*.present_full = true;
                a.*.present_none = false;
                x.*.needs_full = false;
            }
            // Dirty-region present: upload only what changed. A static frame
            // uploads nothing; orbiting uploads just the viewport; cached panels
            // are skipped. The FB is already at physical resolution (logical *
            // scale), so no separate upscale pass is needed.
            let pw: i32 = fb_pw(&a.*.f);
            let ph: i32 = fb_ph(&a.*.f);
            if (a.*.present_full) {
                x11_put_frame(x, a.*.f.px.data, pw, ph);
            } else if (!a.*.present_none) {
                let px0: i32 = a.*.present_x0 * uscale;
                let py0: i32 = a.*.present_y0 * uscale;
                let px1: i32 = a.*.present_x1 * uscale;
                let py1: i32 = a.*.present_y1 * uscale;
                if (px0 < 0) { px0 = 0; }
                if (py0 < 0) { py0 = 0; }
                if (px1 > pw) { px1 = pw; }
                if (py1 > ph) { py1 = ph; }
                if (px1 > px0 && py1 > py0) {
                    x11_put_frame_rect(x, a.*.f.px.data, pw, ph,
                                       px0, py0, px1 - px0, py1 - py0);
                }
            }
            a.*.frame_ms = _zag_clock_monotonic_ms() - t0;
            if (a.*.title_dirty) {
                x11_set_title(x, app_title(a));
                a.*.title_dirty = false;
            }

            // pace toward ~60 fps
            let spent: i64 = _zag_clock_monotonic_ms() - now;
            if (spent < 16) { x11_sleep_ms(16 - spent); }
        }
    }
    if (a.*.dirty) { session_push(a); }
    x11_close(x);
    return 0;
}

fn run_x11_capture(path: []u8, w: i32, h: i32) i32 {
    if (w < 320 || h < 240 || w > limit_image_dimension() || h > limit_image_dimension() ||
        (w as i64) * (h as i64) > limit_image_pixels()) {
        _zag_eprintln("x11-capture: dimensions outside 320..4096");
        return 1;
    }
    let a: *App = app_new(w, h);
    if (_zag_getenv("PRISMSTUDIO_SESSION").len > 0) { session_bind(a); }
    else { app_action_demo(a); }
    let x: *X11 = x11_connect(w, h, "PrismStudio capture");
    if (!x.*.ok) { return 1; }
    a.*.inp.w = w; a.*.inp.h = h;
    let frame_ms: i64 = 0;
    let warm: i32 = 0;
    while (warm < 3) {
        let t0: i64 = _zag_clock_monotonic_ms();
        app_frame(a, 0.016);
        frame_ms = _zag_clock_monotonic_ms() - t0;
        warm = warm + 1;
    }
    x11_put_frame(x, a.*.f.px.data, w, h);
    fb_write_bmp(&a.*.f, path);
    x11_sleep_ms(40);
    x11_close(x);
    _zag_print("x11-capture: wrote "); _zag_println(path);
    _zag_print("x11-capture: frame_ms="); println_i64(frame_ms);
    return 0;
}

// ── X11 round-trip self-test ──────────────────────────────────────────────────
// Sends synthetic Motion/Key/Button/ClientMessage events to our own window via
// SendEvent and asserts the decoded input state — proves the wire protocol
// both directions against the live X server, no external tooling needed.

fn xtest_check(name_: []u8, ok: bool, fails: *i32) void {
    if (ok) { _zag_print("  ok  "); } else { _zag_print("  XX  "); fails.* = fails.* + 1; }
    _zag_println(name_);
}

fn run_x11_selftest() i32 {
    let x: *X11 = x11_connect(400, 300, "selftest");
    if (!x.*.ok) {
        _zag_eprintln("selftest: no X server");
        return 1;
    }
    let fails: i32 = 0;
    let ev: list.ArrayList[u8] = list.make[u8](32);

    // KeyPress 'q'
    let kq: i32 = x11_keycode_of(x, 113);
    ev.len = 0;
    xw8(&ev, 2); xw8(&ev, kq); xw16(&ev, 0);
    xw32(&ev, 0);
    xw32(&ev, x.*.root);
    xw32(&ev, x.*.wid);
    xw32(&ev, 0);
    xw16(&ev, 0); xw16(&ev, 0);
    xw16(&ev, 10); xw16(&ev, 10);
    xw16(&ev, 0);
    xw8(&ev, 1); xw8(&ev, 0);
    let _k: bool = x11_send_self(x, &ev, 1);

    // ButtonPress left at (200,100)
    ev.len = 0;
    xw8(&ev, 4); xw8(&ev, 1); xw16(&ev, 0);
    xw32(&ev, 0);
    xw32(&ev, x.*.root);
    xw32(&ev, x.*.wid);
    xw32(&ev, 0);
    xw16(&ev, 0); xw16(&ev, 0);
    xw16(&ev, 200); xw16(&ev, 100);
    xw16(&ev, 0);
    xw8(&ev, 1); xw8(&ev, 0);
    let _b: bool = x11_send_self(x, &ev, 4);

    // MotionNotify at (123,45) with Shift held
    ev.len = 0;
    xw8(&ev, 6); xw8(&ev, 0); xw16(&ev, 0);
    xw32(&ev, 0);                    // time
    xw32(&ev, x.*.root);
    xw32(&ev, x.*.wid);
    xw32(&ev, 0);                    // child
    xw16(&ev, 0); xw16(&ev, 0);      // root x,y
    xw16(&ev, 123); xw16(&ev, 45);   // event x,y
    xw16(&ev, 1);                    // state: Shift
    xw8(&ev, 1); xw8(&ev, 0);
    let _m: bool = x11_send_self(x, &ev, 64);

    // WM_DELETE_WINDOW ClientMessage
    ev.len = 0;
    xw8(&ev, 33); xw8(&ev, 32); xw16(&ev, 0);
    xw32(&ev, x.*.wid);
    xw32(&ev, x.*.wm_protocols);
    xw32(&ev, x.*.wm_delete);
    xw32(&ev, 0); xw32(&ev, 0); xw32(&ev, 0); xw32(&ev, 0);
    let _c: bool = x11_send_self(x, &ev, 0);

    // Ask the X server/window manager for a real resize; it must return a
    // ConfigureNotify through the normal selected StructureNotify mask.
    let _r: bool = x11_request_resize(x, 640, 480);

    // FocusIn event.
    ev.len = 0;
    xw8(&ev, 9); xw8(&ev, 0); xw8(&ev, 0); xw8(&ev, 0);
    while (ev.len < 32) { xw8(&ev, 0); }
    let _f: bool = x11_send_self(x, &ev, 0);

    // give the server a moment, then pump everything
    x11_sleep_ms(120);
    x11_pump(x);

    xtest_check("synthetic motion traversed X server", (x.*.synth_seen & 4) != 0, &fails);
    xtest_check("shift modifier decoded", (x.*.synth_motion_mods & 1) == 1, &fails);
    let got_q: bool = false;
    let ki: i32 = 0;
    while (ki < x.*.keys.len) {
        if (list.get[i32](x.*.keys, ki) == 113) { got_q = true; }
        ki = ki + 1;
    }
    xtest_check("keypress traversed X server", (x.*.synth_seen & 1) != 0 && got_q, &fails);
    xtest_check("button traversed X server", (x.*.synth_seen & 2) != 0, &fails);
    xtest_check("WM_DELETE close decoded", (x.*.synth_seen & 8) != 0 && x.*.should_close, &fails);
    xtest_check("resize decoded (640x480)", x.*.win_w == 640 && x.*.win_h == 480, &fails);
    xtest_check("focus decoded", (x.*.synth_seen & 32) != 0 && x.*.synth_focus, &fails);

    // blit a test frame through PutImage while we're here
    let fbt: list.ArrayList[i64] = list.make[i64](400 * 300);
    let pi: i32 = 0;
    while (pi < 400 * 300) {
        list.push[i64](&fbt, 58879);   // cyan
        pi = pi + 1;
    }
    x11_put_frame(x, fbt.data, 400, 300);
    xtest_check("PutImage blit accepted", true, &fails);

    x11_close(x);
    let x2: *X11 = x11_connect(320, 240, "selftest reopen");
    xtest_check("repeated open succeeds", x2.*.ok, &fails);
    x11_close(x2);
    if (fails == 0) { _zag_println("X11 SELFTEST: ALL PASS"); return 0; }
    _zag_println("X11 SELFTEST: FAILURES");
    return 1;
}

fn print_usage() void {
    _zag_println("PrismStudio — photonic processor design studio");
    _zag_println("");
    _zag_println("Usage: zagpa [mode] [options]");
    _zag_println("");
    _zag_println("Modes:");
    _zag_println("  (no flag)         Launch X11 GUI (default)");
    _zag_println("  --smoke [out.bmp] Headless render of demo design to BMP");
    _zag_println("  --pipe            Interactive pipe mode (stdin commands)");
    _zag_println("  --agent [script]  Agent protocol (script.tcmd or interactive stdin)");
    _zag_println("  --agent --once \"cmd\"  Run a single agent command");
    _zag_println("  --mcp             MCP server mode (stdio JSON-RPC)");
    _zag_println("  --mcp-install <dir>   Write mcp-config.json to <dir>");
    _zag_println("");
    _zag_println("Diagnostics:");
    _zag_println("  --x11-selftest    X11 wire-protocol round-trip selftest");
    _zag_println("  --x11-capture <out.bmp>  Capture one X11 frame to BMP");
    _zag_println("  --gpu-info        Show GPU adapter info");
    _zag_println("  --gpu-cert-status Show GPU certification status");
    _zag_println("  --gpu-backend-status  Show GPU backend availability");
    _zag_println("  --gpu-virtual-display <out.bmp>  Render via GPU to BMP");
    _zag_println("  --gpu-virtual-shadow <out.bmp>   GPU shadow-ray render to BMP");
    _zag_println("");
    _zag_println("Environment:");
    _zag_println("  PRISMSTUDIO_CAPS  Capability grant (read,inspect,simulate or all)");
    _zag_println("  DISPLAY           X11 display (default: :0)");
    _zag_println("");
    _zag_println("Help:");
    _zag_println("  --help            Show this message and exit");
}

fn main() i32 {
    let argc: i32 = _zag_argc();
    let i: i32 = 1;
    while (i < argc) {
        let arg: []u8 = _zag_arg(i);
        if (_zag_strcmp(arg, "--help") == 1 || _zag_strcmp(arg, "-h") == 1) {
            print_usage();
            return 0;
        }
        if (_zag_strcmp(arg, "--smoke") == 1) {
            let out: []u8 = "smoke_app.bmp";
            if (i + 1 < argc) { out = _zag_arg(i + 1); }
            return run_smoke(out);
        }
        if (_zag_strcmp(arg, "--pipe") == 1) {
            return run_interactive();
        }
        if (_zag_strcmp(arg, "--x11-selftest") == 1) {
            return run_x11_selftest();
        }
        if (_zag_strcmp(arg, "--x11-capture") == 1) {
            return run_x11_capture(arg_after("--x11-capture", "/tmp/prismstudio-x11.bmp"),
                arg_i_after("--width", 1280), arg_i_after("--height", 800));
        }
        if (_zag_strcmp(arg, "--gpu-info") == 1) {
            return run_gpu_info();
        }
        if (_zag_strcmp(arg, "--gpu-cert-status") == 1) {
            return run_gpu_cert_status();
        }
        if (_zag_strcmp(arg, "--gpu-backend-status") == 1) {
            return run_gpu_backend_status();
        }
        if (_zag_strcmp(arg, "--gpu-virtual-display") == 1) {
            return run_gpu_virtual_display(arg_after("--gpu-virtual-display","/tmp/prism-zag-vgpu.bmp"),
                arg_i_after("--width",640),arg_i_after("--height",360));
        }
        if (_zag_strcmp(arg, "--gpu-virtual-shadow") == 1) {
            return run_gpu_virtual_shadow(arg_after("--gpu-virtual-shadow","/tmp/prism-zag-vgpu-shadow.bmp"),
                arg_i_after("--width",640),arg_i_after("--height",360));
        }
        if (_zag_strcmp(arg, "--mcp") == 1) {
            return run_mcp();
        }
        if (_zag_strcmp(arg, "--mcp-install") == 1) {
            let root: []u8 = ".";
            if (i + 1 < argc) { root = _zag_arg(i + 1); }
            session_write_mcp_config(root);
            _zag_println("wrote mcp-config.json and .cursor/mcp.json");
            return 0;
        }
        if (_zag_strcmp(arg, "--agent") == 1) {
            let script: []u8 = "";
            let once: []u8 = "";
            let j: i32 = i + 1;
            while (j < argc) {
                let a2: []u8 = _zag_arg(j);
                if (_zag_strcmp(a2, "--once") == 1 && j + 1 < argc) {
                    once = _zag_arg(j + 1);
                    j = j + 2;
                } else if (_zag_strcmp(a2, "--script") == 1 && j + 1 < argc) {
                    script = _zag_arg(j + 1);
                    j = j + 2;
                } else if (script.len == 0 && once.len == 0 && (a2[0] as i32) != 45) {
                    script = a2;
                    j = j + 1;
                } else {
                    j = j + 1;
                }
            }
            return run_agent(script, once);
        }
        if ((arg[0] as i32) == 45) {
            let p1: []u8 = _zag_str_concat("zagpa: unknown flag '", arg);
            let msg: []u8 = _zag_str_concat(p1, "' (try --help)");
            _zag_str_free(p1);
            _zag_eprintln(msg);
            _zag_str_free(msg);
            return 2;
        }
        i = i + 1;
    }
    return run_x11();
}
