fn fa_hex_val(c: i32) i32 {
    if (c >= '0' && c <= '9') { return c - '0'; }
    if (c >= 'a' && c <= 'f') { return c - 'a' + 10; }
    return 0;
}

// Packed metric record for one glyph; 0 for anything unprintable.
// `face` is a BAKED face index (0..fa_face_count()*fa_scale_count()-1).
// Layout code should pass a logical face (0..fa_face_count()-1) which
// selects the 1x bake and yields logical-pixel metrics.
fn fa_g(face: i32, ch: i32) i64 {
    if (ch < 32 || ch > 126) { return 0; }
    let s: []u8 = fa_mets_face(face);
    let off: i32 = (ch - 32) * 16;
    let val: i64 = 0;
    let i: i32 = 0;
    while (i < 16) {
        val = (val << 4) | (fa_hex_val(s[off + i] as i32) as i64);
        i = i + 1;
    }
    return val;
}

fn fa_adv(face: i32, ch: i32) i32 { return (fa_g(face, ch) & 127) as i32; }
fn fa_bx(face: i32, ch: i32) i32 { return (((fa_g(face, ch) >> 7) & 127) as i32) - 32; }
fn fa_by(face: i32, ch: i32) i32 { return (((fa_g(face, ch) >> 14) & 127) as i32) - 16; }
fn fa_w(face: i32, ch: i32) i32 { return ((fa_g(face, ch) >> 21) & 127) as i32; }
fn fa_h(face: i32, ch: i32) i32 { return ((fa_g(face, ch) >> 28) & 127) as i32; }
fn fa_off(face: i32, ch: i32) i32 { return (fa_g(face, ch) >> 35) as i32; }

