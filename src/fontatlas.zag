fn fa_adv(face: i32, ch: i32) i32 { return (fa_g(face, ch) & 63) as i32; }
fn fa_bx(face: i32, ch: i32) i32 { return (((fa_g(face, ch) >> 6) & 63) as i32) - 16; }
fn fa_by(face: i32, ch: i32) i32 { return (((fa_g(face, ch) >> 12) & 63) as i32) - 8; }
fn fa_w(face: i32, ch: i32) i32 { return ((fa_g(face, ch) >> 18) & 63) as i32; }
fn fa_h(face: i32, ch: i32) i32 { return ((fa_g(face, ch) >> 24) & 63) as i32; }
fn fa_off(face: i32, ch: i32) i32 { return (fa_g(face, ch) >> 30) as i32; }

