// fontatlas.zag — GENERATED by tools/genfontatlas.py. Do not hand-edit.
//
// Proportional anti-aliased UI font (Fira Sans, SIL OFL) baked as 8-bit
// coverage at multiple integral UI scales. Layout uses 1x metrics
// (faces 0..fa_face_count()-1) so logical geometry is scale-invariant;
// draw_glyph picks the baked face for the current scale and blits real
// physical-resolution coverage — no nearest-neighbor replication.
//
// Logical faces (1x): 0 body 13R, 1 body 13M, 2 dense 12R, 3 section 15M,
// 4 title 18M. Scales: [1, 2, 3]. Baked face index =
//   logical_face + (scale - 1) * fa_face_count()
//
// Packed metric record (one i64 per glyph, 0 for unprintable):
//   bits 0..6   advance (7 bits, 0..127)
//   bits 7..13  bearing_x + 32 (7 bits, -32..95)
//   bits 14..20 bearing_y + 16 (7 bits, -16..111)
//   bits 21..27 width (7 bits, 0..127)
//   bits 28..34 height (7 bits, 0..127)
//   bits 35..   coverage offset (29 bits)
//
// Metrics are stored as per-face hex strings (16 chars per glyph,
// 95 glyphs per face) and decoded by fa_g via fixed-width indexing.
// Coverage lives in base64 chunks decoded once at startup (fb.zag).

fn fa_face_count() i32 { return 5; }
fn fa_scale_count() i32 { return 3; }
fn fa_cov_len() i32 { return 409739; }

fn fa_ascent(face: i32) i32 { if (face == 0) { return 13; } if (face == 1) { return 13; } if (face == 2) { return 12; } if (face == 3) { return 15; } if (face == 4) { return 17; } if (face == 5) { return 25; } if (face == 6) { return 25; } if (face == 7) { return 23; } if (face == 8) { return 29; } if (face == 9) { return 34; } if (face == 10) { return 37; } if (face == 11) { return 37; } if (face == 12) { return 34; } if (face == 13) { return 43; } if (face == 14) { return 51; } return 13; }
fn fa_descent(face: i32) i32 { if (face == 0) { return 4; } if (face == 1) { return 4; } if (face == 2) { return 4; } if (face == 3) { return 4; } if (face == 4) { return 5; } if (face == 5) { return 7; } if (face == 6) { return 7; } if (face == 7) { return 7; } if (face == 8) { return 8; } if (face == 9) { return 10; } if (face == 10) { return 11; } if (face == 11) { return 11; } if (face == 12) { return 10; } if (face == 13) { return 12; } if (face == 14) { return 15; } return 4; }
fn fa_line_h(face: i32) i32 { return fa_ascent(face) + fa_descent(face); }

fn fa_glyphs_per_face() i32 { return 95; }

// Per-face hex blob: each glyph is 16 hex chars encoding the packed i64.
fn fa_mets_face(face: i32) []u8 {
