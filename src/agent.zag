fn agent_get(a: *App, id: i64) void {
    let ci: i32 = scene_comp_index(a.*.scene, id as i32);
    if (ci < 0) {
        agent_err("unknown component id");
        return;
    }
    let c: Comp = a.*.scene.*.comps.data[ci];
    let out: []u8 = prepend_f("id=", fmt_i(c.id as i64));
    out = append_f(out, " kind=");
    out = append_f(out, kind_slug(c.kind));
    out = append_f(out, " name=");
    out = append_f(out, c.name_);
    agent_ok1f(out);
}

fn agent_place(a: *App, line: []u8, toks: *list.ArrayList[Tok]) void {
    if (toks.*.len < 5) {
        agent_err("usage: place <kind> <x> <y> <z> [rot]");
        return;
    }
    let ki: i32 = parse_kind_name(tok_slice(line, list.get[Tok](toks, 1)));
    if (ki < 0) {
        agent_err("unknown kind (plate chamber soh emitter detector)");
        return;
    }
    let x: i32 = tok_i64(line, list.get[Tok](toks, 2)) as i32;
    let y: i32 = tok_i64(line, list.get[Tok](toks, 3)) as i32;
    let z: i32 = tok_i64(line, list.get[Tok](toks, 4)) as i32;
    let rot: i32 = 0;
    if (toks.*.len >= 6) {
        rot = tok_i64(line, list.get[Tok](toks, 5)) as i32;
    }
    let id: i32 = scene_place(a.*.scene, kind_at(ki), vox(x, y, z), rot);
    if (id < 0) {
        let code: i32 = scene_can_place(a.*.scene, kind_at(ki), vox(x, y, z), rot);
        agent_err(place_err_text(code));
        return;
    }
    op_add_comp(&a.*.jrn, a.*.scene, id);
    session_after_edit(a);
    let ci: i32 = scene_comp_index(a.*.scene, id);
    let nm: []u8 = a.*.scene.*.comps.data[ci].name_;
    let msg: []u8 = prepend_f("id=", fmt_i(id as i64));
    msg = append_f(msg, " name=");
    msg = append_f(msg, nm);
    agent_mutation_ok(a, msg, id);
    _zag_str_free(msg);
}

fn agent_route(a: *App, line: []u8, toks: *list.ArrayList[Tok]) void {
    if (toks.*.len < 5) {
        agent_err("usage: route <from_comp> <from_port> <to_comp> <to_port>");
        return;
    }
    let fc: i32 = tok_i64(line, list.get[Tok](toks, 1)) as i32;
    let fp: i32 = tok_i64(line, list.get[Tok](toks, 2)) as i32;
    let tc: i32 = tok_i64(line, list.get[Tok](toks, 3)) as i32;
    let tp: i32 = tok_i64(line, list.get[Tok](toks, 4)) as i32;
    let fi: i32 = scene_comp_index(a.*.scene, fc);
    let ti: i32 = scene_comp_index(a.*.scene, tc);
    if (fi < 0 || ti < 0) {
        agent_err("unknown component in route");
        return;
    }
    let src: Comp = a.*.scene.*.comps.data[fi];
    let dst: Comp = a.*.scene.*.comps.data[ti];
    let start: Vox = comp_port_attach(src, fp);
    let goal: Vox = comp_port_attach(dst, tp);
    let path: list.ArrayList[Vox] = list.make[Vox](32);
    if (!route_guide(a.*.scene, start, goal, &path)) {
        list.free[Vox](&path);
        agent_err("no routable path");
        return;
    }
    let gid: i32 = scene_add_guide(a.*.scene, fc, fp, tc, tp, path);
    op_add_guide(&a.*.jrn, a.*.scene, gid);
    session_after_edit(a);
    let rmsg: []u8 = prepend_f("id=", fmt_i(gid as i64));
    agent_mutation_ok(a, rmsg, gid);
    _zag_str_free(rmsg);
}

fn agent_sim_state(a: *App) void {
    sim_recompile(a.*.sim, a.*.scene);
    agent_ok0();
    let i: i32 = 0;
    while (i < a.*.scene.*.comps.len) {
        let c: Comp = a.*.scene.*.comps.data[i];
        if (c.kind == Kind.Emitter || c.kind == Kind.Chamber || c.kind == Kind.Detector) {
            let t: i32 = sim_history(a.*.sim, c.id, 0);
            _zag_print("S ");
            _zag_print(c.name_);
            _zag_print(" ");
            _zag_println(trit_glyph(t));
        }
        i = i + 1;
    }
    let gi: i32 = 0;
    while (gi < a.*.scene.*.guides.len) {
        let g: Guide = a.*.scene.*.guides.data[gi];
        _zag_print("W ");
        agent_print_i("", g.id as i64);
        _zag_print(" live=");
        _zag_println(trit_glyph(g.live));
        gi = gi + 1;
    }
    _zag_print("symbol ");
    agent_println_i(a.*.sim.*.symbol);
    agent_dot();
}

fn agent_render(a: *App, path: []u8) void {
    app_frame(a, 0.0);
    fb_write_bmp(&a.*.f, path);
    agent_ok1f(s2("wrote ", path));
}

fn agent_ui_refresh(a: *App) void {
    a.*.ps_left.valid = false;
    a.*.ps_right.valid = false;
    a.*.ps_bottom.valid = false;
    app_frame(a, 0.0);
}

fn agent_ui_list(a: *App) void {
    agent_ui_refresh(a);
    agent_ok0();
    _zag_println("ui_schema 1");
    _zag_print("screen "); agent_print_i("", a.*.inp.w as i64);
    _zag_print(" "); agent_println_i(a.*.inp.h as i64);
    let i: i32 = 0;
    while (i < a.*.inp.ui_elements.len) {
        let e: UiElement = a.*.inp.ui_elements.data[i];
        _zag_print("E id="); agent_print_i("", e.id);
        _zag_print(" role="); _zag_print(e.role);
        _zag_print(" x="); agent_print_i("", e.bounds.x as i64);
        _zag_print(" y="); agent_print_i("", e.bounds.y as i64);
        _zag_print(" w="); agent_print_i("", e.bounds.w as i64);
        _zag_print(" h="); agent_print_i("", e.bounds.h as i64);
        _zag_print(" enabled="); if (e.enabled) { _zag_print("1"); } else { _zag_print("0"); }
        _zag_print(" active="); if (e.active) { _zag_print("1"); } else { _zag_print("0"); }
        _zag_print(" focused="); if (e.focused) { _zag_print("1"); } else { _zag_print("0"); }
        _zag_print(" label="); _zag_println(e.label);
        i = i + 1;
    }
    agent_dot();
}

fn agent_ui_activate(a: *App, id: i64) void {
    agent_ui_refresh(a);
    let idx: i32 = ui_find(&a.*.inp, id);
    if (idx < 0) { agent_err("E_UI_ELEMENT unknown or not currently visible"); return; }
    let e: UiElement = a.*.inp.ui_elements.data[idx];
    if (!e.enabled || e.bounds.w <= 0 || e.bounds.h <= 0) {
        agent_err("E_UI_DISABLED element is not actionable"); return;
    }
    a.*.inp.mx = e.bounds.x + e.bounds.w / 2;
    a.*.inp.my = e.bounds.y + e.bounds.h / 2;
    a.*.inp.prev_btn = 0; a.*.inp.btn = 1;
    app_frame(a, 0.0);
    a.*.inp.prev_btn = 1; a.*.inp.btn = 0;
    app_frame(a, 0.0);
    a.*.inp.prev_btn = 0; a.*.inp.keys.len = 0;
    session_after_edit(a);
    agent_mutation_ok(a, "UI element activated", 0 - 1);
}

fn agent_optimizer_open(a: *App) void {
    if (!a.*.opt_open) {
        app_action(a, cmd_optimizer());
        app_frame(a, 0.0);
    }
}

fn agent_optimizer_apply(a: *App) void {
    agent_optimizer_open(a);
    if (!a.*.opt.*.has_pending) {
        agent_err("optimizer: no pending proposal");
        return;
    }
    if (opt_apply_gui(a)) {
        a.*.opt_open = false;
        a.*.opt_details = false;
        a.*.opt_previewed = false;
        session_after_edit(a);
        agent_mutation_ok(a, "optimizer proposal applied", 0 - 1);
        return;
    }
    agent_err("optimizer: proposal stale or invalid");
}

fn agent_optimizer_decline(a: *App) void {
    agent_optimizer_open(a);
    if (!a.*.opt.*.has_pending) {
        agent_err("optimizer: no pending proposal");
        return;
    }
    opt_engine_ignore_pending(a.*.opt);
    a.*.opt_open = false;
    a.*.opt_details = false;
    session_after_edit(a);
    agent_mutation_ok(a, "optimizer proposal declined", 0 - 1);
}

fn agent_optimizer_details(a: *App) void {
    agent_optimizer_open(a);
    if (!a.*.opt.*.has_pending) {
        agent_err("optimizer: no pending proposal");
        return;
    }
    a.*.opt_details = !a.*.opt_details;
    if (a.*.opt_details) { a.*.opt_previewed = true; }
    session_after_edit(a);
    agent_mutation_ok(a, "optimizer details toggled", 0 - 1);
}

fn agent_builder_open(a: *App) void {
    if (!a.*.build_open) {
        app_action(a, cmd_builder());
        app_frame(a, 0.0);
    }
}

fn agent_builder_generate(a: *App, line: []u8, toks: *list.ArrayList[Tok]) void {
    if (toks.*.len < 8) {
        agent_err("usage: builder generate <xmin> <ymin> <zmin> <xmax> <ymax> <zmax> [plate_size]");
        return;
    }
    let plate_size: i32 = 0;
    if (toks.*.len >= 9) { plate_size = tok_i64(line, list.get[Tok](toks, 8)) as i32; }
    let env: BuildEnvelope = BuildEnvelope{
        .xmin = tok_i64(line, list.get[Tok](toks, 2)) as i32,
        .ymin = tok_i64(line, list.get[Tok](toks, 3)) as i32,
        .zmin = tok_i64(line, list.get[Tok](toks, 4)) as i32,
        .xmax = tok_i64(line, list.get[Tok](toks, 5)) as i32,
        .ymax = tok_i64(line, list.get[Tok](toks, 6)) as i32,
        .zmax = tok_i64(line, list.get[Tok](toks, 7)) as i32,
        .plate_size = plate_size,
    };
    a.*.build.*.env = env;
    agent_builder_open(a);
    let ok: bool = build_engine_generate(a.*.build, a.*.scene.*.model);
    session_after_edit(a);
    if (ok) {
        let rep: []u8 = build_report(a.*.build.*.pending);
        agent_ok1(rep);
        _zag_str_free(rep);
    } else {
        agent_err("builder: no non-degenerate engine fits the envelope");
    }
}

fn agent_builder_apply(a: *App) void {
    agent_builder_open(a);
    if (!a.*.build.*.has_pending) {
        agent_err("builder: no pending proposal");
        return;
    }
    if (build_apply_gui(a)) {
        a.*.build_open = false;
        a.*.build_details = false;
        session_after_edit(a);
        agent_mutation_ok(a, "builder proposal applied", 0 - 1);
        return;
    }
    agent_err("builder: proposal stale or invalid");
}

fn agent_builder_decline(a: *App) void {
    agent_builder_open(a);
    if (!a.*.build.*.has_pending) {
        agent_err("builder: no pending proposal");
        return;
    }
    build_engine_clear_pending(a.*.build);
    a.*.build_open = false;
    a.*.build_details = false;
    session_after_edit(a);
    agent_mutation_ok(a, "builder proposal declined", 0 - 1);
}

fn agent_builder_details(a: *App) void {
    agent_builder_open(a);
    if (!a.*.build.*.has_pending) {
        agent_err("builder: no pending proposal");
        return;
    }
    a.*.build_details = !a.*.build_details;
    session_after_edit(a);
    if (a.*.build_details) {
        let rep: []u8 = build_report(a.*.build.*.pending);
        agent_ok1(rep);
        _zag_str_free(rep);
    } else {
        agent_mutation_ok(a, "builder details hidden", 0 - 1);
    }
}

// ── component manipulation: copy/paste/duplicate/group/ungroup/rename/visibility/lock ──

fn agent_copy(a: *App) void {
    if (a.*.sel.len == 0) { agent_err("copy: nothing selected"); return; }
    app_copy(a);
    let msg: []u8 = prepend_f(fmt_i(a.*.clipboard.len as i64), " copied");
    agent_mutation_ok(a, msg, 0 - 1);
    _zag_str_free(msg);
}

fn agent_paste(a: *App) void {
    if (a.*.clipboard.len == 0) { agent_err("paste: clipboard empty"); return; }
    app_paste(a);
    let msg: []u8 = prepend_f(fmt_i(a.*.sel.len as i64), " pasted");
    agent_mutation_ok(a, msg, 0 - 1);
    _zag_str_free(msg);
}

fn agent_duplicate(a: *App) void {
    if (a.*.sel.len == 0) { agent_err("duplicate: nothing selected"); return; }
    app_duplicate(a);
    agent_mutation_ok(a, "duplicate armed (click in viewport to place)", 0 - 1);
}

fn agent_group(a: *App) void {
    if (a.*.sel.len < 2) { agent_err("group: need >=2 selected components"); return; }
    app_group_selection(a);
    agent_mutation_ok(a, "grouped", 0 - 1);
}

fn agent_ungroup(a: *App) void {
    if (a.*.sel.len == 0) { agent_err("ungroup: nothing selected"); return; }
    app_ungroup_selection(a);
    agent_mutation_ok(a, "ungrouped", 0 - 1);
}

fn agent_rename(a: *App, line: []u8, toks: *list.ArrayList[Tok]) void {
    if (toks.*.len < 3) { agent_err("usage: rename <id> <name>"); return; }
    let id: i32 = tok_i64(line, list.get[Tok](toks, 1)) as i32;
    let ci: i32 = scene_comp_index(a.*.scene, id);
    if (ci < 0) { agent_err("rename: component not found"); return; }
    let name: []u8 = tok_slice(line, list.get[Tok](toks, 2));
    if (a.*.scene.*.comps.data[ci].name_.len > 0) { _zag_str_free(a.*.scene.*.comps.data[ci].name_); }
    a.*.scene.*.comps.data[ci].name_ = _zag_strdup(name);
    scene_mark_topo_comp(a.*.scene, id);
    session_after_edit(a);
    let full: []u8 = prepend_f("renamed ", fmt_i(id as i64));
    full = append_f(full, " ");
    full = append_f(full, name);
    agent_mutation_ok(a, full, id);
    _zag_str_free(full);
}

fn agent_toggle_visibility(a: *App, line: []u8, toks: *list.ArrayList[Tok]) void {
    if (toks.*.len < 2) { agent_err("usage: visibility <id>"); return; }
    let id: i32 = tok_i64(line, list.get[Tok](toks, 1)) as i32;
    let ci: i32 = scene_comp_index(a.*.scene, id);
    if (ci < 0) { agent_err("visibility: component not found"); return; }
    a.*.scene.*.comps.data[ci].visible = !a.*.scene.*.comps.data[ci].visible;
    scene_mark_topo_comp(a.*.scene, id);
    session_after_edit(a);
    let state: []u8 = "hidden";
    if (a.*.scene.*.comps.data[ci].visible) { state = "visible"; }
    let full: []u8 = prepend_f("component ", fmt_i(id as i64));
    full = append_f(full, " ");
    full = append_f(full, state);
    agent_mutation_ok(a, full, id);
    _zag_str_free(full);
}

fn agent_toggle_lock(a: *App, line: []u8, toks: *list.ArrayList[Tok]) void {
    if (toks.*.len < 2) { agent_err("usage: lock <id>"); return; }
    let id: i32 = tok_i64(line, list.get[Tok](toks, 1)) as i32;
    let ci: i32 = scene_comp_index(a.*.scene, id);
    if (ci < 0) { agent_err("lock: component not found"); return; }
    app_toggle_lock(a, id);
    session_after_edit(a);
    let state: []u8 = "unlocked";
    if (app_is_locked(a, id)) { state = "locked"; }
    let full: []u8 = prepend_f("component ", fmt_i(id as i64));
    full = append_f(full, " ");
    full = append_f(full, state);
    agent_mutation_ok(a, full, id);
    _zag_str_free(full);
}

// ── view control: ortho/section/view presets/frame ──

fn agent_view_preset(a: *App, preset: []u8) void {
    if (_zag_strcmp(preset, "top") == 1) { app_action(a, cmd_view_top()); }
    else if (_zag_strcmp(preset, "front") == 1) { app_action(a, cmd_view_front()); }
    else if (_zag_strcmp(preset, "right") == 1) { app_action(a, cmd_view_right()); }
    else if (_zag_strcmp(preset, "perspective") == 1) { app_action(a, cmd_view_perspective()); }
    else if (_zag_strcmp(preset, "reset") == 1) { app_action(a, cmd_reset_view()); }
    else { agent_err("view: use top|front|right|perspective|reset"); return; }
    app_frame(a, 0.0);
    agent_ok1(preset);
}

fn agent_view_frame(a: *App, mode: []u8) void {
    if (_zag_strcmp(mode, "selected") == 1) { app_action(a, cmd_frame_selected()); }
    else if (_zag_strcmp(mode, "all") == 1) { app_action(a, cmd_frame_all()); }
    else { agent_err("view frame: use selected|all"); return; }
    app_frame(a, 0.0);
    agent_ok1(mode);
}

fn agent_view_toggle(a: *App, mode: []u8) void {
    if (_zag_strcmp(mode, "ortho") == 1) { app_action(a, cmd_toggle_ortho()); }
    else if (_zag_strcmp(mode, "section") == 1) { app_action(a, cmd_section_view()); }
    else if (_zag_strcmp(mode, "reduced_motion") == 1) { app_action(a, cmd_toggle_reduced_motion()); }
    else if (_zag_strcmp(mode, "object_snap") == 1) { app_action(a, cmd_toggle_object_snap()); }
    else { agent_err("view toggle: use ortho|section|reduced_motion|object_snap"); return; }
    app_frame(a, 0.0);
    agent_ok1(mode);
}

// ── incremental camera control: orbit/pan/zoom ──
// These mirror the mouse interactions (MMB drag = orbit, Shift+MMB = pan,
// scroll = zoom) but via numeric deltas, so an MCP client can navigate
// incrementally without teleporting.

fn agent_camera_orbit(a: *App, line: []u8, toks: *list.ArrayList[Tok]) void {
    if (toks.*.len < 4) { agent_err("usage: camera orbit <yaw_delta> <pitch_delta>"); return; }
    let yaw_d: f64 = tok_f64(line, list.get[Tok](toks, 2));
    let pitch_d: f64 = tok_f64(line, list.get[Tok](toks, 3));
    a.*.cam.yaw = a.*.cam.yaw + yaw_d;
    a.*.cam.pitch = a.*.cam.pitch + pitch_d;
    cam_update(&a.*.cam, zone_center(a).h);
    tiles_mark_all_dirty(&a.*.tile_cache);
    a.*.present_full = true;
    app_frame(a, 0.0);
    agent_ok1("orbited");
}

fn agent_camera_pan(a: *App, line: []u8, toks: *list.ArrayList[Tok]) void {
    if (toks.*.len < 4) { agent_err("usage: camera pan <dx> <dz>"); return; }
    let dx: f64 = tok_f64(line, list.get[Tok](toks, 2));
    let dz: f64 = tok_f64(line, list.get[Tok](toks, 3));
    // Pan in the camera's right/up basis: dx moves along right, dz along fwd (ground plane)
    let r: Vec3 = a.*.cam.right;
    let f: Vec3 = a.*.cam.fwd;
    // Project fwd onto ground plane (zero out Y) for natural panning
    let fg: Vec3 = v3(f.x, 0.0, f.z);
    let fg_n: Vec3 = vnorm(fg);
    a.*.cam.target = vadd(a.*.cam.target, vadd(vscale(r, dx), vscale(fg_n, dz)));
    cam_update(&a.*.cam, zone_center(a).h);
    tiles_mark_all_dirty(&a.*.tile_cache);
    a.*.present_full = true;
    app_frame(a, 0.0);
    agent_ok1("panned");
}

fn agent_camera_zoom(a: *App, line: []u8, toks: *list.ArrayList[Tok]) void {
    if (toks.*.len < 3) { agent_err("usage: camera zoom <factor>"); return; }
    let factor: f64 = tok_f64(line, list.get[Tok](toks, 2));
    if (factor <= 0.0) { agent_err("camera zoom: factor must be positive"); return; }
    a.*.cam.dist = a.*.cam.dist * factor;
    cam_update(&a.*.cam, zone_center(a).h);
    tiles_mark_all_dirty(&a.*.tile_cache);
    a.*.present_full = true;
    app_frame(a, 0.0);
    agent_ok1("zoomed");
}

// ── panel control ──

fn agent_panel(a: *App, line: []u8, toks: *list.ArrayList[Tok]) void {
    if (toks.*.len < 2) { agent_err("usage: panel <optimizer|builder|settings|palette> [open|close]"); return; }
    let name: Tok = list.get[Tok](toks, 1);
    let action: []u8 = "toggle";
    if (toks.*.len >= 3) { action = tok_slice(line, list.get[Tok](toks, 2)); }
    let do_open: bool = _zag_strcmp(action, "open") == 1;
    let do_close: bool = _zag_strcmp(action, "close") == 1;

    if (tok_eq(line, name, "optimizer")) {
        if (do_close && a.*.opt_open) { app_action(a, cmd_optimizer()); app_frame(a, 0.0); }
        else if (do_open || (!do_close && !a.*.opt_open)) { agent_optimizer_open(a); }
    } else if (tok_eq(line, name, "builder")) {
        if (do_close && a.*.build_open) { app_action(a, cmd_builder()); app_frame(a, 0.0); }
        else if (do_open || (!do_close && !a.*.build_open)) { agent_builder_open(a); }
    } else if (tok_eq(line, name, "settings")) {
        if (do_close && a.*.settings_open) { app_action(a, cmd_settings()); app_frame(a, 0.0); }
        else if (do_open || (!do_close && !a.*.settings_open)) { app_action(a, cmd_settings()); app_frame(a, 0.0); }
    } else if (tok_eq(line, name, "palette")) {
        app_action(a, cmd_palette());
        app_frame(a, 0.0);
    } else {
        agent_err("panel: use optimizer|builder|settings|palette");
        return;
    }
    session_after_edit(a);
    agent_mutation_ok(a, "panel toggled", 0 - 1);
}

// ── selection manipulation ──

fn agent_select_add(a: *App, line: []u8, toks: *list.ArrayList[Tok]) void {
    if (toks.*.len < 2) { agent_err("usage: select_add <id>"); return; }
    let id: i32 = tok_i64(line, list.get[Tok](toks, 1)) as i32;
    if (scene_comp_index(a.*.scene, id) < 0) { agent_err("select_add: component not found"); return; }
    sel_add(a, id);
    session_after_edit(a);
    agent_ok1("added to selection");
}

fn agent_select_remove(a: *App, line: []u8, toks: *list.ArrayList[Tok]) void {
    if (toks.*.len < 2) { agent_err("usage: select_remove <id>"); return; }
    let id: i32 = tok_i64(line, list.get[Tok](toks, 1)) as i32;
    let i: i32 = 0;
    while (i < a.*.sel.len) {
        if (list.get[i32](a.*.sel, i) == id) {
            let k: i32 = i;
            while (k + 1 < a.*.sel.len) { a.*.sel.data[k] = a.*.sel.data[k + 1]; k = k + 1; }
            a.*.sel.len = a.*.sel.len - 1;
            session_after_edit(a);
            agent_ok1("removed from selection");
            return;
        }
        i = i + 1;
    }
    agent_err("select_remove: id not in selection");
}

fn agent_select_clear(a: *App) void {
    sel_clear(a);
    session_after_edit(a);
    agent_ok1("selection cleared");
}

// ── pixel-based UI click (fallback for screenshots) ──

fn agent_ui_click(a: *App, line: []u8, toks: *list.ArrayList[Tok]) void {
    if (toks.*.len < 4) { agent_err("usage: ui click <x> <y>"); return; }
    let x: i32 = tok_i64(line, list.get[Tok](toks, 2)) as i32;
    let y: i32 = tok_i64(line, list.get[Tok](toks, 3)) as i32;
    agent_ui_refresh(a);
    a.*.inp.mx = x;
    a.*.inp.my = y;
    a.*.inp.prev_btn = 0; a.*.inp.btn = 1;
    app_frame(a, 0.0);
    a.*.inp.prev_btn = 1; a.*.inp.btn = 0;
    app_frame(a, 0.0);
    a.*.inp.prev_btn = 0; a.*.inp.keys.len = 0;
    session_after_edit(a);
    // Report what element (if any) is at the clicked position
    let idx: i32 = ui_find_at(&a.*.inp, x, y);
    if (idx >= 0) {
        let e: UiElement = a.*.inp.ui_elements.data[idx];
        let xs: []u8 = fmt_i(x as i64);
        let ys: []u8 = fmt_i(y as i64);
        let msg: []u8 = s4("clicked at (", xs, ",", ys);
        _zag_str_free(xs);
        _zag_str_free(ys);
        let m2: []u8 = s3(msg, ") element=", e.label);
        _zag_str_free(msg);
        agent_mutation_ok(a, m2, 0 - 1);
        _zag_str_free(m2);
    } else {
        let xs: []u8 = fmt_i(x as i64);
        let ys: []u8 = fmt_i(y as i64);
        let msg: []u8 = s4("clicked at (", xs, ",", ys);
        _zag_str_free(xs);
        _zag_str_free(ys);
        let m2: []u8 = s2(msg, ") no element");
        _zag_str_free(msg);
        agent_mutation_ok(a, m2, 0 - 1);
        _zag_str_free(m2);
    }
}

// ── type text into focused textfield ──

fn agent_ui_type(a: *App, line: []u8, toks: *list.ArrayList[Tok]) void {
    if (toks.*.len < 3) { agent_err("usage: ui type <text>"); return; }
    let text: []u8 = tok_slice(line, list.get[Tok](toks, 2));
    agent_ui_refresh(a);
    let i: i32 = 0;
    while (i < text.len) {
        let ch: u8 = text[i];
        list.push[u8](&a.*.inp.keys, ch);
        i = i + 1;
    }
    app_frame(a, 0.0);
    a.*.inp.keys.len = 0;
    session_after_edit(a);
    let msg: []u8 = s2("typed ", text);
    agent_mutation_ok(a, msg, 0 - 1);
    _zag_str_free(msg);
}

fn agent_model(a: *App, line: []u8, toks: *list.ArrayList[Tok]) void {
    if (toks.*.len < 2 || tok_eq(line, list.get[Tok](toks, 1), "status")) {
        agent_ok0();
        _zag_print("schema="); agent_print_i("", a.*.scene.*.model.schema_version as i64);
        _zag_print(" current="); agent_print_i("", model_schema_current() as i64);
        _zag_print(" schema_complete="); if (model_schema_complete(a.*.scene.*.model)) { _zag_println("yes"); } else { _zag_println("no"); }
        let i: i32 = 0;
        while (i < model_type_schema_count()) {
            let d: DeviceTypeSchema = model_type_schema(i);
            _zag_print("TYPE id="); _zag_print(d.id);
            _zag_print(" version="); agent_print_i("", d.version as i64);
            _zag_print(" parameters="); agent_println_i(d.parameter_count as i64);
            i = i + 1;
        }
        agent_dot(); return;
    }
    if (tok_eq(line, list.get[Tok](toks, 1), "migrate")) {
        if (toks.*.len < 3) { agent_err("usage: model migrate <version>"); return; }
        let target: i32 = tok_i64(line, list.get[Tok](toks, 2)) as i32;
        if (!model_migrate(&a.*.scene.*.model, target)) {
            agent_err("E_MODEL_MIGRATION unsupported source/target pair"); return;
        }
        scene_mark_render(a.*.scene);
        session_after_edit(a);
        let mig_msg: []u8 = prepend_f("model migrated schema=", fmt_i(target as i64));
        agent_mutation_ok(a, mig_msg, 0 - 1);
        _zag_str_free(mig_msg);
        return;
    }
    agent_err("model: use status or migrate <version>");
}

fn agent_diagnostics(a: *App, path: []u8) void {
    let text: []u8 = agent_details_text(a);
    let with_nl: []u8 = append_f(text, "\n");
    _zag_str_free(text);
    _zag_write_file(path, with_nl);
    _zag_str_free(with_nl);
    agent_ok1("diagnostics written");
}

fn agent_details_text(a: *App) []u8 {
    let out: []u8 = _zag_strdup("prismstudio_diagnostics_v1\nscene_contents=excluded_by_default\n");
    out = append_f(out, "protocol=prismstudio-agent-1\nrevision=");
    out = append_ff(out, fmt_i(a.*.session_rev));
    out = append_f(out, "\ncomponents=");
    out = append_ff(out, fmt_i(a.*.scene.*.comps.len as i64));
    out = append_f(out, "\nguides=");
    out = append_ff(out, fmt_i(a.*.scene.*.guides.len as i64));
    out = append_f(out, "\ncapability_bits=");
    out = append_ff(out, fmt_i(cap_load()));
    out = append_f(out, "\nmax_request_bytes=");
    out = append_ff(out, fmt_i(limit_agent_request_bytes() as i64));
    return out;
}

fn agent_details(a: *App) void {
    agent_ok1f(agent_details_text(a));
}

fn agent_audit_path() []u8 {
    let path: []u8 = _zag_getenv("PRISMSTUDIO_AUDIT");
    if (path.len == 0) { path = ".prismstudio/audit.log"; }
    return path;
}

fn agent_logs(a: *App, lines: i32) void {
    let raw: []u8 = _zag_read_file(agent_audit_path());
    if (raw.len == 0) {
        agent_ok1("no audit log");
        return;
    }
    if (lines <= 0) { agent_ok1(raw); return; }
    let end: i32 = raw.len;
    if (raw[raw.len - 1] == 10) { end = end - 1; }
    let seen: i32 = 0;
    let i: i32 = end;
    let start: i32 = 0;
    while (i > 0 && seen < lines) {
        i = i - 1;
        if (raw[i] == 10) {
            seen = seen + 1;
            if (seen == lines) { start = i + 1; break; }
        }
    }
    let out: []u8 = raw[start..end];
    let label: []u8 = prepend_f("audit lines=", fmt_i(lines as i64));
    label = append_f(label, "\n");
    let body: []u8 = append_f(label, out);
    agent_ok1f(body);
}

fn agent_uilog(a: *App, lines: i32) void {
    if (a.*.log.len == 0) {
        agent_ok1("no ui log");
        return;
    }
    let start: i32 = 0;
    if (lines > 0 && lines < a.*.log.len) { start = a.*.log.len - lines; }
    let i: i32 = start;
    let body: []u8 = _zag_strdup("");
    while (i < a.*.log.len) {
        if (i > start) {
            let nl: []u8 = _zag_str_concat(body, "\n");
            _zag_str_free(body);
            body = nl;
        }
        let entry: []u8 = list.get[[]u8](a.*.log, i);
        let grown: []u8 = _zag_str_concat(body, entry);
        _zag_str_free(body);
        body = grown;
        i = i + 1;
    }
    let label: []u8 = prepend_f("ui log lines=", fmt_i((a.*.log.len - start) as i64));
    label = append_f(label, "\n");
    let result: []u8 = append_f(label, body);
    _zag_str_free(body);
    agent_ok1f(result);
}

fn agent_check_device_model_version(path: []u8) bool {
    let raw: []u8 = _zag_read_file(path);
    if (raw.len < 5 || _zag_strcmp(raw[0..5], "zpa 2") != 1) { return true; }
    let pos: i32 = 0;
    while (pos < raw.len) {
        let eol: i32 = pos;
        while (eol < raw.len && (raw[eol] as i32) != 10) { eol = eol + 1; }
        let line: []u8 = raw[pos..eol];
        pos = eol + 1;
        if (line.len > 2 && (line[0] as i32) == 'm' && (line[1] as i32) == 32) {
            let i: i32 = 2;
            while (i < line.len && (line[i] as i32) == 32) { i = i + 1; }
            let start: i32 = i;
            while (i < line.len && (line[i] as i32) != 32) { i = i + 1; }
            let schema: i64 = _zag_str_to_i64(line[start..i]);
            if (schema < model_schema_min() || schema > model_schema_current()) {
                let out: []u8 = prepend_f("E_MODEL_VERSION unsupported device model schema ", fmt_i(schema));
                out = append_f(out, " supported 1..2");
                agent_errf(out);
                return false;
            }
            return true;
        }
    }
    return true;
}

fn agent_test(cmd: []u8) void {
    let rc: i32 = 0;
    if (_zag_strcmp(cmd, "engine") == 1) {
        rc = _zag_exec_cmd("./probe/engine_test >/dev/null 2>&1");
    } else if (_zag_strcmp(cmd, "smoke") == 1) {
        rc = _zag_exec_cmd("./zagpa --smoke /tmp/prismstudio_smoke.bmp >/dev/null 2>&1");
    } else if (_zag_strcmp(cmd, "build") == 1) {
        rc = _zag_exec_cmd("./build.sh >/dev/null 2>&1");
    } else {
        agent_err("unknown test (engine smoke build)");
        return;
    }
    if (rc == 0) {
        agent_ok1("passed");
    } else {
        agent_err("test failed");
    }
}

fn agent_dispatch(a: *App, line: []u8, toks: *list.ArrayList[Tok]) void {
    if (toks.*.len == 0) { return; }
    let verb: Tok = list.get[Tok](toks, 0);

    let required: i64 = cap_inspect();
    if (tok_eq(line, verb, "sim")) { required = cap_simulate(); }
    if (tok_eq(line, verb, "render")) { required = cap_export(); }
    if (tok_eq(line, verb, "render_at")) { required = cap_export(); }
    if (tok_eq(line, verb, "export")) { required = cap_export(); }
    if (tok_eq(line, verb, "diagnostics")) { required = cap_export(); }
    if (tok_eq(line, verb, "details")) { required = cap_read(); }
    if (tok_eq(line, verb, "logs") || tok_eq(line, verb, "audit")) { required = cap_read(); }
    if (tok_eq(line, verb, "uilog")) { required = cap_read(); }
    if (tok_eq(line, verb, "ui") && toks.*.len >= 2 &&
        tok_eq(line, list.get[Tok](toks, 1), "screenshot")) { required = cap_export(); }
    if (tok_eq(line, verb, "ui") && toks.*.len >= 2 &&
        tok_eq(line, list.get[Tok](toks, 1), "activate")) { required = cap_admin(); }
    if (tok_eq(line, verb, "model") && toks.*.len >= 2 &&
        tok_eq(line, list.get[Tok](toks, 1), "migrate")) { required = cap_edit(); }
    if (tok_eq(line, verb, "trace")) { required = cap_export(); }
    if (tok_eq(line, verb, "save")) { required = cap_save(); }
    if (tok_eq(line, verb, "test") || tok_eq(line, verb, "build")) { required = cap_execute(); }
    if (tok_eq(line, verb, "optimizer") && toks.*.len >= 2 &&
        (tok_eq(line, list.get[Tok](toks, 1), "apply") ||
         tok_eq(line, list.get[Tok](toks, 1), "accept") ||
         tok_eq(line, list.get[Tok](toks, 1), "decline") ||
         tok_eq(line, list.get[Tok](toks, 1), "ignore") ||
         tok_eq(line, list.get[Tok](toks, 1), "details"))) { required = cap_edit(); }
    if (tok_eq(line, verb, "builder") && toks.*.len >= 2 &&
        (tok_eq(line, list.get[Tok](toks, 1), "apply") ||
         tok_eq(line, list.get[Tok](toks, 1), "accept"))) { required = cap_edit(); }
    if (tok_eq(line, verb, "builder") && toks.*.len >= 2 &&
        (tok_eq(line, list.get[Tok](toks, 1), "generate") ||
         tok_eq(line, list.get[Tok](toks, 1), "decline") ||
         tok_eq(line, list.get[Tok](toks, 1), "ignore") ||
         tok_eq(line, list.get[Tok](toks, 1), "details"))) { required = cap_inspect(); }
    if (tok_eq(line, verb, "new") || tok_eq(line, verb, "demo") ||
        tok_eq(line, verb, "place") || tok_eq(line, verb, "place_here") ||
        tok_eq(line, verb, "place_on") || tok_eq(line, verb, "route") ||
        tok_eq(line, verb, "delete") || tok_eq(line, verb, "del") ||
        tok_eq(line, verb, "undo") || tok_eq(line, verb, "redo") ||
        tok_eq(line, verb, "move") || tok_eq(line, verb, "rotate") ||
        tok_eq(line, verb, "disconnect") || tok_eq(line, verb, "reroute") ||
        tok_eq(line, verb, "close")) { required = cap_edit(); }
    if (tok_eq(line, verb, "flash") && toks.*.len >= 2 &&
        tok_eq(line, list.get[Tok](toks, 1), "import")) { required = cap_edit(); }
    a.*.request_command = line;
    a.*.request_required = required;
    audit_append("request", line, required);
    if (agent_user_rule_matches("PRISMSTUDIO_DENY_OPS", required)) {
        audit_append("rule-denied", line, required);
        agent_err("E_RULE_DENIED operation class denied by user rule");
        return;
    }
    if (!cap_allowed(required) && !agent_user_rule_matches("PRISMSTUDIO_ALLOW_OPS", required)) {
        audit_append("denied", line, required);
        agent_err("E_CAP_DENIED explicit capability grant required");
        return;
    }
    if (!agent_scoped_grant_allowed(line, toks, required)) {
        audit_append("grant-denied", line, required);
        return;
    }
    if (agent_is_mutation(line, toks)) {
        let idem: i32 = agent_idempotency_prepare(a);
        if (idem != 0) { return; }
        if (!agent_revision_precondition(a)) {
            audit_append("revision-conflict", line, required);
            return;
        }
    }

    if (tok_eq(line, verb, "ping")) { agent_ok1("pong"); return; }
    if (tok_eq(line, verb, "help")) { agent_help(); return; }
    if (tok_eq(line, verb, "capabilities")) { agent_capabilities(a); return; }
    if (tok_eq(line, verb, "quit") || tok_eq(line, verb, "exit")) {
        agent_ok1("bye");
        a.*.quit = true;
        return;
    }
    if (tok_eq(line, verb, "new")) {
        app_new_design(a);
        a.*.file_ = _zag_strdup(session_zpa_path());
        session_after_edit(a);
        agent_mutation_ok(a, "cleared", 0 - 1);
        return;
    }
    if (tok_eq(line, verb, "demo")) {
        demo_load(a);
        session_after_edit(a);
        agent_mutation_ok(a, "demo loaded", 0 - 1);
        return;
    }
    if (tok_eq(line, verb, "view")) {
        session_agent_view();
        return;
    }
    if (tok_eq(line, verb, "camera")) {
        if (toks.*.len < 2) { agent_err("usage: camera <x> <y> <z> | camera orbit <yaw> <pitch> | camera pan <dx> <dz> | camera zoom <factor>"); return; }
        // Subcommands: orbit, pan, zoom
        let sub: Tok = list.get[Tok](toks, 1);
        if (tok_eq(line, sub, "orbit")) { agent_camera_orbit(a, line, toks); return; }
        if (tok_eq(line, sub, "pan")) { agent_camera_pan(a, line, toks); return; }
        if (tok_eq(line, sub, "zoom")) { agent_camera_zoom(a, line, toks); return; }
        // Default: teleport to <x> <y> <z>
        if (toks.*.len < 4) { agent_err("usage: camera <x> <y> <z> | camera orbit <yaw> <pitch> | camera pan <dx> <dz> | camera zoom <factor>"); return; }
        let cx: i64 = tok_i64(line, list.get[Tok](toks, 1));
        let cy: i64 = tok_i64(line, list.get[Tok](toks, 2));
        let cz: i64 = tok_i64(line, list.get[Tok](toks, 3));
        app_camera_teleport(a, cx as f64, cy as f64, cz as f64);
        let out: []u8 = prepend_f("camera x=", fmt_i(cx));
        out = append_f(out, " y=");
        out = append_ff(out, fmt_i(cy));
        out = append_f(out, " z=");
        out = append_ff(out, fmt_i(cz));
        agent_ok1f(out);
        return;
    }
    if (tok_eq(line, verb, "render_at")) {
        if (toks.*.len < 5) { agent_err("usage: render_at <out.bmp> <x> <y> <z>"); return; }
        let rpath: []u8 = tok_slice(line, list.get[Tok](toks, 1));
        if (!agent_path_allowed(rpath)) { return; }
        let rx: i64 = tok_i64(line, list.get[Tok](toks, 2));
        let ry: i64 = tok_i64(line, list.get[Tok](toks, 3));
        let rz: i64 = tok_i64(line, list.get[Tok](toks, 4));
        app_camera_teleport(a, rx as f64, ry as f64, rz as f64);
        agent_render(a, rpath);
        return;
    }
    if (tok_eq(line, verb, "pick")) {
        let cell: Vox = session_agent_pick_cell();
        if (cell.x < 0) {
            agent_err("no pick (hover viewport in GUI or use place_here after view)");
            return;
        }
        let out: []u8 = prepend_f("x=", fmt_i(cell.x as i64));
        out = append_f(out, " y=");
        out = append_ff(out, fmt_i(cell.y as i64));
        out = append_f(out, " z=");
        out = append_ff(out, fmt_i(cell.z as i64));
        agent_ok1f(out);
        return;
    }
    if (tok_eq(line, verb, "place_here")) {
        if (toks.*.len < 2) { agent_err("usage: place_here <kind> [rot]"); return; }
        let ki: i32 = parse_kind_name(tok_slice(line, list.get[Tok](toks, 1)));
        if (ki < 0) { agent_err("unknown kind"); return; }
        let cell: Vox = session_agent_pick_cell();
        if (cell.x < 0) { agent_err("no hover/ghost cell in live.bus"); return; }
        let rot: i32 = session_agent_pick_rot();
        if (toks.*.len >= 3) { rot = tok_i64(line, list.get[Tok](toks, 2)) as i32; }
        let id: i32 = scene_place(a.*.scene, kind_at(ki), cell, rot);
        if (id < 0) { agent_err(place_err_text(scene_can_place(a.*.scene, kind_at(ki), cell, rot))); return; }
        op_add_comp(&a.*.jrn, a.*.scene, id);
        session_after_edit(a);
        let ci: i32 = scene_comp_index(a.*.scene, id);
        let nm: []u8 = a.*.scene.*.comps.data[ci].name_;
        let pmsg: []u8 = prepend_f("id=", fmt_i(id as i64));
        pmsg = append_f(pmsg, " name=");
        pmsg = append_f(pmsg, nm);
        agent_mutation_ok(a, pmsg, id);
        _zag_str_free(pmsg);
        return;
    }
    if (tok_eq(line, verb, "place_on")) {
        if (toks.*.len < 5) { agent_err("usage: place_on <kind> <plate_id> <lx> <lz> [rot]"); return; }
        let ki: i32 = parse_kind_name(tok_slice(line, list.get[Tok](toks, 1)));
        if (ki < 0) { agent_err("unknown kind"); return; }
        let pid: i32 = tok_i64(line, list.get[Tok](toks, 2)) as i32;
        let pci: i32 = scene_comp_index(a.*.scene, pid);
        if (pci < 0) { agent_err("unknown plate id"); return; }
        let plate: Comp = a.*.scene.*.comps.data[pci];
        let lx: i32 = tok_i64(line, list.get[Tok](toks, 3)) as i32;
        let lz: i32 = tok_i64(line, list.get[Tok](toks, 4)) as i32;
        let rot: i32 = 0;
        if (toks.*.len >= 6) { rot = tok_i64(line, list.get[Tok](toks, 5)) as i32; }
        let origin: Vox = vox(plate.origin.x + lx, 1, plate.origin.z + lz);
        let id: i32 = scene_place(a.*.scene, kind_at(ki), origin, rot);
        if (id < 0) { agent_err(place_err_text(scene_can_place(a.*.scene, kind_at(ki), origin, rot))); return; }
        op_add_comp(&a.*.jrn, a.*.scene, id);
        session_after_edit(a);
        let ci: i32 = scene_comp_index(a.*.scene, id);
        let pmsg2: []u8 = prepend_f("id=", fmt_i(id as i64));
        pmsg2 = append_f(pmsg2, " name=");
        pmsg2 = append_f(pmsg2, a.*.scene.*.comps.data[ci].name_);
        agent_mutation_ok(a, pmsg2, id);
        _zag_str_free(pmsg2);
        return;
    }
    if (tok_eq(line, verb, "list")) {
        agent_list(a);
        return;
    }
    if (tok_eq(line, verb, "place")) {
        agent_place(a, line, toks);
        return;
    }
    if (tok_eq(line, verb, "route")) {
        agent_route(a, line, toks);
        return;
    }
    if (tok_eq(line, verb, "delete") || tok_eq(line, verb, "del")) {
        if (toks.*.len < 2) { agent_err("usage: delete <id>"); return; }
        let id: i32 = tok_i64(line, list.get[Tok](toks, 1)) as i32;
        if (scene_comp_index(a.*.scene, id) < 0) {
            agent_err("unknown component id");
            return;
        }
        op_del_comp(&a.*.jrn, a.*.scene, id);
        scene_remove(a.*.scene, id);
        session_after_edit(a);
        agent_mutation_ok(a, "deleted", id);
        return;
    }
    if (tok_eq(line, verb, "undo")) {
        if (journal_undo(&a.*.jrn, a.*.scene)) {
            sel_prune(a);
            sim_reset(a.*.sim, a.*.scene);
            app_frame_all(a);
            session_after_edit(a);
            agent_mutation_ok(a, "undo", 0 - 1);
        } else {
            agent_err("nothing to undo");
        }
        return;
    }
    if (tok_eq(line, verb, "redo")) {
        if (journal_redo(&a.*.jrn, a.*.scene)) {
            sel_prune(a);
            sim_reset(a.*.sim, a.*.scene);
            app_frame_all(a);
            session_after_edit(a);
            agent_mutation_ok(a, "redo", 0 - 1);
        } else {
            agent_err("nothing to redo");
        }
        return;
    }
    if (tok_eq(line, verb, "move")) {
        if (toks.*.len < 5) { agent_err("usage: move <id> <dx> <dy> <dz>"); return; }
        let id: i32 = tok_i64(line, list.get[Tok](toks, 1)) as i32;
        let ci: i32 = scene_comp_index(a.*.scene, id);
        if (ci < 0) { agent_err("unknown component id"); return; }
        let dx: i32 = tok_i64(line, list.get[Tok](toks, 2)) as i32;
        let dy: i32 = tok_i64(line, list.get[Tok](toks, 3)) as i32;
        let dz: i32 = tok_i64(line, list.get[Tok](toks, 4)) as i32;
        let cc: Comp = a.*.scene.*.comps.data[ci];
        let no: Vox = vox(cc.origin.x + dx, cc.origin.y + dy, cc.origin.z + dz);
        if (scene_can_place_ext(a.*.scene, cc.kind, cc.size, no, cc.rot, id) != 0) {
            agent_err("illegal move (collision or bounds)"); return;
        }
        op_move(&a.*.jrn, a.*.scene, id, vox(dx, dy, dz));
        let one: list.ArrayList[i32] = list.make[i32](1);
        list.push[i32](&one, id);
        group_move(a.*.scene, &one, vox(dx, dy, dz));
        list.free[i32](&one);
        session_after_edit(a);
        agent_mutation_ok(a, "moved", id);
        return;
    }
    if (tok_eq(line, verb, "rotate")) {
        if (toks.*.len < 2) { agent_err("usage: rotate <id> [quarters]"); return; }
        let id: i32 = tok_i64(line, list.get[Tok](toks, 1)) as i32;
        let ci: i32 = scene_comp_index(a.*.scene, id);
        if (ci < 0) { agent_err("unknown component id"); return; }
        let q: i32 = 1;
        if (toks.*.len >= 3) { q = tok_i64(line, list.get[Tok](toks, 2)) as i32; }
        if (op_rotate(&a.*.jrn, a.*.scene, id, a.*.scene.*.comps.data[ci].rot + q) != 0) {
            agent_err("rotation collides"); return;
        }
        session_after_edit(a);
        agent_mutation_ok(a, "rotated", id);
        return;
    }
    if (tok_eq(line, verb, "disconnect")) {
        if (toks.*.len < 2) { agent_err("usage: disconnect <guide_id>"); return; }
        let gid: i32 = tok_i64(line, list.get[Tok](toks, 1)) as i32;
        if (scene_guide_index(a.*.scene, gid) < 0) { agent_err("unknown guide id"); return; }
        op_del_guide(&a.*.jrn, a.*.scene, gid);
        scene_remove_guide(a.*.scene, gid);
        session_after_edit(a);
        agent_mutation_ok(a, "disconnected", gid);
        return;
    }
    if (tok_eq(line, verb, "reroute")) {
        if (toks.*.len < 2) { agent_err("usage: reroute <guide_id>"); return; }
        let gid: i32 = tok_i64(line, list.get[Tok](toks, 1)) as i32;
        let gi: i32 = scene_guide_index(a.*.scene, gid);
        if (gi < 0) { agent_err("unknown guide id"); return; }
        let g: Guide = a.*.scene.*.guides.data[gi];
        let fc: i32 = g.from_c; let fp: i32 = g.from_p;
        let tc: i32 = g.to_c; let tp: i32 = g.to_p;
        let start: Vox = comp_port_attach(a.*.scene.*.comps.data[scene_comp_index(a.*.scene, fc)], fp);
        let goal: Vox = comp_port_attach(a.*.scene.*.comps.data[scene_comp_index(a.*.scene, tc)], tp);
        op_del_guide(&a.*.jrn, a.*.scene, gid);
        scene_remove_guide(a.*.scene, gid);
        let path: list.ArrayList[Vox] = list.make[Vox](32);
        if (!route_guide(a.*.scene, start, goal, &path)) {
            list.free[Vox](&path); agent_err("reroute: no path"); return;
        }
        let ngid: i32 = scene_add_guide(a.*.scene, fc, fp, tc, tp, path);
        op_add_guide(&a.*.jrn, a.*.scene, ngid);
        session_after_edit(a);
        let rrmsg: []u8 = prepend_f("id=", fmt_i(ngid as i64));
        agent_mutation_ok(a, rrmsg, ngid);
        _zag_str_free(rrmsg);
        return;
    }
    if (tok_eq(line, verb, "inspect")) {
        let comp: []u8 = "no";
        if (model_complete(a.*.scene.*.model)) { comp = "yes"; }
        let out: []u8 = prepend_f("schema=", fmt_i(a.*.scene.*.model.schema_version as i64));
        out = append_f(out, " model_complete=");
        out = append_f(out, comp);
        out = append_f(out, " components=");
        out = append_ff(out, fmt_i(a.*.scene.*.comps.len as i64));
        out = append_f(out, " guides=");
        out = append_ff(out, fmt_i(a.*.scene.*.guides.len as i64));
        agent_ok1f(out);
        return;
    }
    if (tok_eq(line, verb, "close")) {
        scene_clear(a.*.scene);
        journal_clear(&a.*.jrn);
        sel_clear(a);
        session_after_edit(a);
        agent_mutation_ok(a, "closed", 0 - 1);
        return;
    }
    if (tok_eq(line, verb, "get")) {
        if (toks.*.len < 2) { agent_err("usage: get <id>"); return; }
        agent_get(a, tok_i64(line, list.get[Tok](toks, 1)));
        return;
    }
    if (tok_eq(line, verb, "select") || tok_eq(line, verb, "sel")) {
        if (toks.*.len < 2) { agent_err("usage: select <id>"); return; }
        sel_set(a, tok_i64(line, list.get[Tok](toks, 1)) as i32);
        agent_ok1("selected");
        return;
    }
    if (tok_eq(line, verb, "select_add")) { agent_select_add(a, line, toks); return; }
    if (tok_eq(line, verb, "select_remove")) { agent_select_remove(a, line, toks); return; }
    if (tok_eq(line, verb, "select_clear")) { agent_select_clear(a); return; }
    if (tok_eq(line, verb, "copy")) { agent_copy(a); return; }
    if (tok_eq(line, verb, "paste")) { agent_paste(a); return; }
    if (tok_eq(line, verb, "duplicate")) { agent_duplicate(a); return; }
    if (tok_eq(line, verb, "group")) { agent_group(a); return; }
    if (tok_eq(line, verb, "ungroup")) { agent_ungroup(a); return; }
    if (tok_eq(line, verb, "rename")) { agent_rename(a, line, toks); return; }
    if (tok_eq(line, verb, "visibility")) { agent_toggle_visibility(a, line, toks); return; }
    if (tok_eq(line, verb, "lock")) { agent_toggle_lock(a, line, toks); return; }
    if (tok_eq(line, verb, "panel")) { agent_panel(a, line, toks); return; }
    if (tok_eq(line, verb, "view")) {
        if (toks.*.len < 2) { agent_err("usage: view <top|front|right|perspective|reset|frame <selected|all>|toggle <ortho|section|reduced_motion|object_snap>>"); return; }
        let sub: Tok = list.get[Tok](toks, 1);
        if (tok_eq(line, sub, "top") || tok_eq(line, sub, "front") ||
            tok_eq(line, sub, "right") || tok_eq(line, sub, "perspective") ||
            tok_eq(line, sub, "reset")) { agent_view_preset(a, tok_slice(line, sub)); return; }
        if (tok_eq(line, sub, "frame")) {
            if (toks.*.len < 3) { agent_err("usage: view frame <selected|all>"); return; }
            agent_view_frame(a, tok_slice(line, list.get[Tok](toks, 2))); return;
        }
        if (tok_eq(line, sub, "toggle")) {
            if (toks.*.len < 3) { agent_err("usage: view toggle <ortho|section|reduced_motion|object_snap>"); return; }
            agent_view_toggle(a, tok_slice(line, list.get[Tok](toks, 2))); return;
        }
        agent_err("view: use top|front|right|perspective|reset|frame|toggle"); return;
    }
    if (tok_eq(line, verb, "can_place")) {
        if (toks.*.len < 5) { agent_err("usage: can_place <kind> <x> <y> <z> [rot]"); return; }
        let ki: i32 = parse_kind_name(tok_slice(line, list.get[Tok](toks, 1)));
        if (ki < 0) { agent_err("unknown kind"); return; }
        let rot: i32 = 0;
        if (toks.*.len >= 6) { rot = tok_i64(line, list.get[Tok](toks, 5)) as i32; }
        let code: i32 = scene_can_place(a.*.scene, kind_at(ki),
            vox(tok_i64(line, list.get[Tok](toks, 2)) as i32,
                tok_i64(line, list.get[Tok](toks, 3)) as i32,
                tok_i64(line, list.get[Tok](toks, 4)) as i32), rot);
        if (code == 0) { agent_ok1("yes"); }
        else { agent_err(place_err_text(code)); }
        return;
    }
    if (tok_eq(line, verb, "save")) {
        let path: []u8 = session_zpa_path();
        if (toks.*.len >= 2) { path = tok_slice(line, list.get[Tok](toks, 1)); }
        if (!agent_path_allowed(path)) { return; }
        if (design_save(a.*.scene, path)) {
            a.*.file_ = _zag_strdup(path);
            a.*.dirty = false;
            session_push(a);
            agent_mutation_ok(a, "saved", 0 - 1);
        } else { agent_err("save failed"); }
        return;
    }
    if (tok_eq(line, verb, "open")) {
        let path: []u8 = session_zpa_path();
        if (toks.*.len >= 2) { path = tok_slice(line, list.get[Tok](toks, 1)); }
        if (!agent_path_allowed(path)) { return; }
        if (!agent_check_device_model_version(path)) { return; }
        if (design_load(a.*.scene, path)) {
            if (_zag_strcmp(path, session_zpa_path()) == 1) {
                session_sync_journal(a);
            } else {
                journal_clear(&a.*.jrn);
            }
            sel_clear(a);
            a.*.file_ = _zag_strdup(path);
            a.*.dirty = false;
            app_frame_all(a);
            session_push(a);
            agent_mutation_ok(a, "opened", 0 - 1);
        } else { agent_err("open failed"); }
        return;
    }
    if (tok_eq(line, verb, "list_files")) {
        let files: list.ArrayList[[]u8] = list.make[[]u8](8);
        list_designs(&files);
        agent_ok0();
        let i: i32 = 0;
        while (i < files.len) {
            _zag_print("F ");
            _zag_println(list.get[[]u8](files, i));
            i = i + 1;
        }
        agent_dot();
        return;
    }
    if (tok_eq(line, verb, "render")) {
        if (toks.*.len < 2) { agent_err("usage: render <out.bmp>"); return; }
        let path: []u8 = tok_slice(line, list.get[Tok](toks, 1));
        if (!agent_path_allowed(path)) { return; }
        agent_render(a, path);
        return;
    }
    if (tok_eq(line, verb, "export")) {
        if (toks.*.len < 2) { agent_err("usage: export <prefix>"); return; }
        let path: []u8 = tok_slice(line, list.get[Tok](toks, 1));
        if (!agent_path_allowed(path)) { return; }
        if (export_all(a.*.scene, a.*.sim, path)) {
            agent_ok1("exported BOM netlist models report");
        } else { agent_err("E_EXPORT_FAILED artifact write failed"); }
        return;
    }
    if (tok_eq(line, verb, "trace")) {
        if (toks.*.len < 3) { agent_err("usage: trace <out.trace> <steps>"); return; }
        let path: []u8 = tok_slice(line, list.get[Tok](toks, 1));
        if (!agent_path_allowed(path)) { return; }
        let steps: i32 = tok_i64(line, list.get[Tok](toks, 2)) as i32;
        if (steps < 1 || steps > 100000) { agent_err("E_TRACE_LIMIT steps must be 1..100000"); return; }
        if (export_trace(a.*.scene, a.*.sim, path, steps)) { agent_ok1("trace exported"); }
        else { agent_err("E_TRACE_FAILED trace write failed"); }
        return;
    }
    if (tok_eq(line, verb, "diagnostics")) {
        if (toks.*.len < 2) { agent_err("usage: diagnostics <out.txt>"); return; }
        let path: []u8 = tok_slice(line, list.get[Tok](toks, 1));
        if (!agent_path_allowed(path)) { return; }
        agent_diagnostics(a, path);
        return;
    }
    if (tok_eq(line, verb, "details")) {
        agent_details(a);
        return;
    }
    if (tok_eq(line, verb, "logs") || tok_eq(line, verb, "audit")) {
        let lines: i32 = 0;
        if (toks.*.len >= 2) { lines = tok_i64(line, list.get[Tok](toks, 1)) as i32; }
        if (lines < 0) { agent_err("usage: logs [nonnegative n]"); return; }
        agent_logs(a, lines);
        return;
    }
    if (tok_eq(line, verb, "uilog")) {
        let lines: i32 = 0;
        if (toks.*.len >= 2) { lines = tok_i64(line, list.get[Tok](toks, 1)) as i32; }
        if (lines < 0) { agent_err("usage: uilog [nonnegative n]"); return; }
        agent_uilog(a, lines);
        return;
    }
    if (tok_eq(line, verb, "sim")) {
        if (toks.*.len < 2) { agent_err("usage: sim step|reset|state [n]"); return; }
        let sub: Tok = list.get[Tok](toks, 1);
        if (tok_eq(line, sub, "reset")) {
            sim_reset(a.*.sim, a.*.scene);
            agent_ok1("reset");
            return;
        }
        if (tok_eq(line, sub, "state")) {
            agent_sim_state(a);
            return;
        }
        if (tok_eq(line, sub, "step")) {
            let n: i32 = 1;
            if (toks.*.len >= 3) { n = tok_i64(line, list.get[Tok](toks, 2)) as i32; }
            if (n < 1) { n = 1; }
            if (n > limit_simulation_steps_per_request()) {
                agent_err("E_SIM_LIMIT steps must be 1..100000"); return;
            }
            sim_recompile(a.*.sim, a.*.scene);
            let i: i32 = 0;
            while (i < n) {
                sim_step(a.*.sim, a.*.scene);
                i = i + 1;
            }
            agent_ok1f(prepend_f("symbol=", fmt_i(a.*.sim.*.symbol)));
            return;
        }
        if (tok_eq(line, sub, "mode")) {
            if (toks.*.len < 3) { agent_err("usage: sim mode functional|physical"); return; }
            let mode: Tok = list.get[Tok](toks, 2);
            if (tok_eq(line, mode, "functional")) { a.*.sim.*.mode = SimMode.Functional; }
            else if (tok_eq(line, mode, "physical")) { a.*.sim.*.mode = SimMode.Physical; }
            else { agent_err("E_BAD_MODE expected functional or physical"); return; }
            sim_recompile(a.*.sim, a.*.scene);
            agent_ok1("simulation mode changed"); return;
        }
        agent_err("sim: use step, reset, or state");
        return;
    }
    if (tok_eq(line, verb, "flash")) {
        if (toks.*.len < 2) { agent_err("usage: flash import <program.fir> | flash verify"); return; }
        let sub: Tok = list.get[Tok](toks, 1);
        if (tok_eq(line, sub, "import")) {
            if (toks.*.len < 3) { agent_err("usage: flash import <program.fir>"); return; }
            let path: []u8 = tok_slice(line, list.get[Tok](toks, 2));
            if (!agent_path_allowed(path)) { return; }
            let ir: FlashIr = flash_ir_load(path);
            if (!ir.valid) { agent_err("invalid, empty, or oversized Flash FIR v1"); return; }
            app_new_design(a);
            a.*.file_ = _zag_strdup(session_zpa_path());
            if (!flash_build_scene(a.*.scene, &ir)) { agent_err("Flash FIR placement or routing failed"); return; }
            let failures: i32 = flash_verify_scene(a.*.scene, a.*.sim);
            session_after_edit(a);
            let fmsg: []u8 = prepend_f("ops=", fmt_i(ir.ops.len as i64));
            fmsg = append_f(fmsg, " components=");
            fmsg = append_ff(fmsg, fmt_i(a.*.scene.*.comps.len as i64));
            fmsg = append_f(fmsg, " verification_failures=");
            fmsg = append_ff(fmsg, fmt_i(failures as i64));
            agent_mutation_ok(a, fmsg, 0 - 1);
            _zag_str_free(fmsg);
            return;
        }
        if (tok_eq(line, sub, "verify")) {
            let failures: i32 = flash_verify_scene(a.*.scene, a.*.sim);
            if (failures < 0) { agent_err("active design is not a Flash photonic import"); }
            else if (failures == 0) { agent_ok1("Flash photonic execution verified"); }
            else { agent_errf(prepend_f("Flash mismatches=", fmt_i(failures as i64))); }
            return;
        }
        agent_err("flash: use import or verify");
        return;
    }
    if (tok_eq(line, verb, "test")) {
        if (toks.*.len < 2) { agent_err("usage: test engine|smoke|build"); return; }
        agent_test(tok_slice(line, list.get[Tok](toks, 1)));
        return;
    }
    if (tok_eq(line, verb, "build")) {
        agent_test("build");
        return;
    }
    if (tok_eq(line, verb, "status")) {
        agent_status(a);
        return;
    }
    if (tok_eq(line, verb, "coords")) {
        agent_coords(a);
        return;
    }
    if (tok_eq(line, verb, "stack")) {
        let y: i32 = 0 - 1;
        if (toks.*.len >= 2) { y = tok_i64(line, list.get[Tok](toks, 1)) as i32; }
        agent_process_stack(a, y);
        return;
    }
    if (tok_eq(line, verb, "power")) {
        agent_power(a);
        return;
    }
    if (tok_eq(line, verb, "perf")) {
        agent_perf(a);
        return;
    }
    if (tok_eq(line, verb, "kinds")) {
        agent_kinds();
        return;
    }
    if (tok_eq(line, verb, "ui")) {
        if (toks.*.len < 2) { agent_err("usage: ui list|screenshot <path>|activate <id>|click <x> <y>|type <text>"); return; }
        let sub: Tok = list.get[Tok](toks, 1);
        if (tok_eq(line, sub, "list")) { agent_ui_list(a); return; }
        if (tok_eq(line, sub, "screenshot")) {
            if (toks.*.len < 3) { agent_err("usage: ui screenshot <path>"); return; }
            let path: []u8 = tok_slice(line, list.get[Tok](toks, 2));
            if (!agent_path_allowed(path)) { return; }
            agent_render(a, path); return;
        }
        if (tok_eq(line, sub, "activate")) {
            if (toks.*.len < 3) { agent_err("usage: ui activate <id>"); return; }
            agent_ui_activate(a, tok_i64(line, list.get[Tok](toks, 2))); return;
        }
        if (tok_eq(line, sub, "click")) { agent_ui_click(a, line, toks); return; }
        if (tok_eq(line, sub, "type")) { agent_ui_type(a, line, toks); return; }
        agent_err("ui: use list, screenshot, activate, click, or type"); return;
    }
    if (tok_eq(line, verb, "optimizer")) {
        if (toks.*.len < 2) { agent_err("usage: optimizer apply|accept|decline|ignore|details"); return; }
        let sub: Tok = list.get[Tok](toks, 1);
        if (tok_eq(line, sub, "apply") || tok_eq(line, sub, "accept")) { agent_optimizer_apply(a); return; }
        if (tok_eq(line, sub, "decline") || tok_eq(line, sub, "ignore")) { agent_optimizer_decline(a); return; }
        if (tok_eq(line, sub, "details")) { agent_optimizer_details(a); return; }
        agent_err("optimizer: use apply, accept, decline, ignore, or details"); return;
    }
    if (tok_eq(line, verb, "builder")) {
        if (toks.*.len < 2) { agent_err("usage: builder generate <xmin> <ymin> <zmin> <xmax> <ymax> <zmax> [plate_size]|apply|accept|decline|ignore|details"); return; }
        let sub: Tok = list.get[Tok](toks, 1);
        if (tok_eq(line, sub, "generate")) { agent_builder_generate(a, line, toks); return; }
        if (tok_eq(line, sub, "apply") || tok_eq(line, sub, "accept")) { agent_builder_apply(a); return; }
        if (tok_eq(line, sub, "decline") || tok_eq(line, sub, "ignore")) { agent_builder_decline(a); return; }
        if (tok_eq(line, sub, "details")) { agent_builder_details(a); return; }
        agent_err("builder: use generate, apply, accept, decline, ignore, or details"); return;
    }
    if (tok_eq(line, verb, "model")) { agent_model(a, line, toks); return; }
    agent_err("unknown command (try help)");
}

fn agent_load_i32_le(buf: []u8, off: i32) i32 {
    let b0: i32 = buf[off] as i32;
    let b1: i32 = buf[off + 1] as i32;
    let b2: i32 = buf[off + 2] as i32;
    let b3: i32 = buf[off + 3] as i32;
    return b0 | (b1 << 8) | (b2 << 16) | (b3 << 24);
}

// Preview a high-impact mutation without writing: validate feasibility and report
// the projected effect, changing nothing (Section 8.1, ask-before-write). Preview
// is read-only, so it needs no mutation grant — it is how a caller inspects an
// action before requesting the grant that would actually perform it.
fn agent_preview(a: *App, line: []u8, toks: *list.ArrayList[Tok]) void {
    if (toks.*.len < 2) { agent_err("E_PREVIEW usage: preview <place|delete> ..."); return; }
    let sub: Tok = list.get[Tok](toks, 1);
    if (tok_eq(line, sub, "place")) {
        if (toks.*.len < 6) { agent_err("E_PREVIEW usage: preview place <kind> <x> <y> <z> [rot]"); return; }
        let ki: i32 = parse_kind_name(tok_slice(line, list.get[Tok](toks, 2)));
        if (ki < 0) { agent_err("E_PREVIEW unknown kind (plate chamber soh emitter detector)"); return; }
        let x: i32 = tok_i64(line, list.get[Tok](toks, 3)) as i32;
        let y: i32 = tok_i64(line, list.get[Tok](toks, 4)) as i32;
        let z: i32 = tok_i64(line, list.get[Tok](toks, 5)) as i32;
        let rot: i32 = 0;
        if (toks.*.len >= 7) { rot = tok_i64(line, list.get[Tok](toks, 6)) as i32; }
        let code: i32 = scene_can_place(a.*.scene, kind_at(ki), vox(x, y, z), rot);
        if (code == 0) {
            let out: []u8 = prepend_f("PREVIEW place ok would-add kind=", _zag_strdup(tok_slice(line, list.get[Tok](toks, 2))));
            out = append_f(out, " writes=none");
            agent_ok1f(out);
        } else {
            let out: []u8 = prepend_f("PREVIEW place blocked ", _zag_strdup(place_err_text(code)));
            out = append_f(out, " writes=none");
            agent_ok1f(out);
        }
    } else if (tok_eq(line, sub, "delete")) {
        if (toks.*.len < 3) { agent_err("E_PREVIEW usage: preview delete <id>"); return; }
        let id: i32 = tok_i64(line, list.get[Tok](toks, 2)) as i32;
        let idx: i32 = scene_comp_index(a.*.scene, id);
        if (idx < 0) { agent_ok1("PREVIEW delete blocked no-such-id writes=none"); return; }
        let nm: []u8 = a.*.scene.*.comps.data[idx].name_;
        let out: []u8 = prepend_f("PREVIEW delete ok would-remove id=", fmt_i(id as i64));
        out = append_f(out, " name=");
        out = append_f(out, nm);
        out = append_f(out, " writes=none");
        agent_ok1f(out);
    } else {
        agent_err("E_PREVIEW unknown subcommand (place delete)");
    }
}

// A cancel sentinel: presence of a readable, non-empty /tmp/prismstudio_cancel requests
// cancellation. Checked at step boundaries so cancellation is always safe.
fn agent_cancel_requested() bool {
    let c: []u8 = _zag_read_file("/tmp/prismstudio_cancel");
    return c.len > 0;
}

// Stream progress for a long simulation and support safe cancellation (Section 8.2).
// The simulation advances in-memory only; project bytes are never touched, so a
// cancel at any step boundary leaves a consistent state and no partial write.
fn agent_simstream(a: *App, line: []u8, toks: *list.ArrayList[Tok]) void {
    if (toks.*.len < 2) { agent_err("E_SIMSTREAM usage: simstream <steps>"); return; }
    let n: i64 = tok_i64(line, list.get[Tok](toks, 1));
    if (n < 0) { agent_err("E_SIMSTREAM steps must be nonnegative"); return; }
    sim_recompile(a.*.sim, a.*.scene);
    let every: i64 = n / 10;
    if (every < 1) { every = 1; }
    let k: i64 = 0;
    while (k < n) {
        if (agent_cancel_requested()) {
            let out: []u8 = prepend_f("CANCELLED step=", fmt_i(k));
            out = append_f(out, " of ");
            out = append_ff(out, fmt_i(n));
            agent_ok1f(out);
            return;
        }
        sim_step(a.*.sim, a.*.scene);
        k = k + 1;
        if (k % every == 0 || k == n) {
            let out: []u8 = prepend_f("PROGRESS ", fmt_i(k));
            out = append_f(out, "/");
            out = append_ff(out, fmt_i(n));
            agent_ok1f(out);
        }
    }
    agent_ok1f(prepend_f("DONE steps=", fmt_i(n)));
}

fn agent_dispatch_line(a: *App, line: []u8) void {
    let toks: list.ArrayList[Tok] = list.make[Tok](16);
    tokenize(line, &toks);
    if (toks.len > 0 && tok_eq(line, list.get[Tok](toks, 0), "preview")) {
        agent_preview(a, line, &toks);
    } else if (toks.len > 0 && tok_eq(line, list.get[Tok](toks, 0), "simstream")) {
        agent_simstream(a, line, &toks);
    } else if (toks.len > 0 && tok_eq(line, list.get[Tok](toks, 0), "timing")) {
        agent_ok1(timing_report(a.*.scene));
    } else if (toks.len > 0 && tok_eq(line, list.get[Tok](toks, 0), "request")) {
        if (toks.len < 4) {
            agent_err("E_REQUEST_ENVELOPE usage: request <key> <expected_revision> <command>");
        } else {
            let rev: i64 = tok_i64(line, list.get[Tok](toks, 2));
            if (tok_eq(line, list.get[Tok](toks, 2), "current")) { rev = session_read_rev(); }
            if (rev < 0) {
                agent_err("E_REQUEST_ENVELOPE expected_revision must be nonnegative");
            } else {
                a.*.request_idempotency = tok_slice(line, list.get[Tok](toks, 1));
                a.*.request_expected_rev = rev;
                a.*.request_enveloped = true;
                let inner: []u8 = line[list.get[Tok](toks, 3).off..line.len];
                let inner_toks: list.ArrayList[Tok] = list.make[Tok](16);
                tokenize(inner, &inner_toks);
                agent_dispatch(a, inner, &inner_toks);
                list.free[Tok](&inner_toks);
                a.*.request_idempotency = "";
                a.*.request_expected_rev = 0 - 1;
                a.*.request_enveloped = false;
            }
        }
    } else {
        agent_dispatch(a, line, &toks);
    }
    list.free[Tok](&toks);
}

// Run one agent command with stdout captured via pipe (for native MCP).
fn agent_capture_line(a: *App, line: []u8) []u8 {
    if (line.len > limit_agent_request_bytes()) { return "ERR E_REQUEST_LIMIT command exceeds 4096 bytes"; }
    let fds: list.ArrayList[u8] = list.make[u8](8);
    let zi: i32 = 0;
    while (zi < 8) {
        list.push[u8](&fds, 0);
        zi = zi + 1;
    }
    let prc: i64 = _zag_raw_syscall(22, fds.data as i64, 0, 0, 0, 0, 0);
    if (prc < 0) {
        list.free[u8](&fds);
        return "ERR E_CAPTURE pipe failed";
    }
    let rfd: i64 = agent_load_i32_le(fds.data[0..8], 0) as i64;
    let wfd: i64 = agent_load_i32_le(fds.data[0..8], 4) as i64;
    list.free[u8](&fds);

    let saved: i64 = _zag_raw_syscall(32, 1, 0, 0, 0, 0, 0);
    if (saved < 0) {
        _zag_raw_syscall(3, rfd, 0, 0, 0, 0, 0);
        return "ERR E_CAPTURE dup failed";
    }
    _zag_raw_syscall(33, wfd, 1, 0, 0, 0, 0);
    _zag_raw_syscall(3, wfd, 0, 0, 0, 0, 0);

    agent_dispatch_line(a, line);
    _zag_flush();

    _zag_raw_syscall(33, saved, 1, 0, 0, 0, 0);
    _zag_raw_syscall(3, saved, 0, 0, 0, 0, 0);

    let out: list.ArrayList[u8] = list.make[u8](4096);
    let chunk: list.ArrayList[u8] = list.make[u8](1024);
    let running: bool = true;
    while (running) {
        let n: i64 = _zag_read_fd(rfd, chunk.data as *i8, chunk.cap as i64);
        if (n <= 0) {
            running = false;
        } else {
            let i: i32 = 0;
            while (i < n as i32) {
                list.push[u8](&out, chunk.data[i]);
                i = i + 1;
            }
        }
    }
    _zag_raw_syscall(3, rfd, 0, 0, 0, 0, 0);
    list.free[u8](&chunk);

    while (out.len > 0 && (out.data[out.len - 1] as i32) == 10) {
        out.len = out.len - 1;
    }
    let text: []u8 = _zag_strdup(out.data[0..out.len]);
    list.free[u8](&out);
    return text;
}

fn agent_run_line(a: *App, line: []u8) void {
    if (line.len > limit_agent_request_bytes()) {
        agent_err("E_REQUEST_LIMIT command exceeds 4096 bytes");
        return;
    }
    session_pull(a);
    agent_dispatch_line(a, line);
}

fn agent_run_script(a: *App, path: []u8) void {
    let raw: []u8 = _zag_read_file(path);
    if (raw.len <= 0) {
        agent_err("cannot read script");
        return;
    }
    if (raw.len > limit_agent_script_bytes()) {
        agent_err("E_SCRIPT_LIMIT script exceeds 1048576 bytes");
        return;
    }
    let pos: i32 = 0;
    while (pos < raw.len && !a.*.quit) {
        let eol: i32 = pos;
        while (eol < raw.len && (raw[eol] as i32) != 10) { eol = eol + 1; }
        let line: []u8 = raw[pos..eol];
        pos = eol + 1;
        if (line.len > 0 && (line[0] as i32) != '#') {
            agent_run_line(a, line);
        }
    }
}

// --agent [script.tcmd]  or  --agent --once "cmd"
fn run_agent(script: []u8, once: []u8) i32 {
    let a: *App = app_new(800, 600);
    session_bind(a);
    _zag_println("OK ready prismstudio-agent-1");
    agent_flush();

    if (once.len > 0) {
        agent_run_line(a, once);
        if (a.*.quit) { return 0; }
        return 0;
    }
    if (script.len > 0) {
        agent_run_script(a, script);
        return 0;
    }

    let io: IoBuf = iobuf_new();
    let line: list.ArrayList[u8] = list.make[u8](256);
    let running: bool = true;
    while (running && !io.eof && !a.*.quit) {
        if (!ioline_read(&io, 0, &line)) {
            if (io.eof) { running = false; }
        } else if (line.len > 0) {
            agent_run_line(a, line.data[0..line.len]);
        }
    }
    list.free[u8](&line);
    iobuf_free(&io);
    return 0;
}
