// agent.zag — headless agent RPC for CLI and MCP wrappers.
//
// Protocol (stdin/stdout, one command per line):
//   Request:  <verb> [args...]
//   Response: OK [message]          — success, optional one-line payload
//             OK                    — start of multi-line block
//             <data lines>
//             .                     — end of block
//             ERR <message>         — failure
//
// Examples:
//   place plate 6 0 10 0     -> OK id=3 name=GeSn_Plate.1
//   list                     -> OK + component/guide lines + .
//   sim step 24              -> OK symbol=24
//   test engine              -> OK passed (runs ./probe/engine_test)

@import("../std/list.zag") as list
@import("ioline.zag")
@import("app.zag")

extern fn _zag_raw_syscall(num: i64, a1: i64, a2: i64, a3: i64, a4: i64, a5: i64, a6: i64) i64;
extern fn _zag_read_fd(fd: i64, buf: *i8, n: i64) i64;
@import("workspace.zag")
@import("routing.zag")
@import("sim.zag")
@import("editops.zag")
@import("demo.zag")
@import("session.zag")
@import("ternary.zag")
@import("timing.zag")
@import("flash_ir.zag")
@import("capability.zag")
@import("export.zag")
@import("limits.zag")
@import("process_stack.zag")

struct Tok {
    off: i32,
    len: i32,
}

fn tok_slice(line: []u8, t: Tok) []u8 {
    return line[t.off..t.off + t.len];
}

fn tokenize(line: []u8, out: *list.ArrayList[Tok]) void {
    out.*.len = 0;
    let i: i32 = 0;
    while (i < line.len) {
        while (i < line.len && (line[i] as i32) == 32) { i = i + 1; }
        if (i >= line.len) { return; }
        let st: i32 = i;
        while (i < line.len && (line[i] as i32) != 32) { i = i + 1; }
        list.push[Tok](out, Tok{ .off = st, .len = i - st });
    }
}

fn tok_eq(line: []u8, t: Tok, lit: []u8) bool {
    if (t.len != lit.len) { return false; }
    let i: i32 = 0;
    while (i < t.len) {
        if ((line[t.off + i] as i32) != (lit[i] as i32)) { return false; }
        i = i + 1;
    }
    return true;
}

// Agent file access is opt-in confined by PRISMSTUDIO_PROJECT_ROOT.  Paths must be
// absolute, below that root, and lexically free of parent-directory segments.
// The OS remains the final authority; this guard prevents obvious traversal
// before any read or write is attempted.
fn path_has_parent_segment(path: []u8) bool {
    let i: i32 = 0;
    while (i + 1 < path.len) {
        if ((path[i] as i32) == 46 && (path[i + 1] as i32) == 46) {
            let left: bool = i == 0 || (path[i - 1] as i32) == 47;
            let right: bool = i + 2 == path.len || (path[i + 2] as i32) == 47;
            if (left && right) { return true; }
        }
        i = i + 1;
    }
    return false;
}

fn path_under_root(path: []u8) bool {
    let root: []u8 = _zag_getenv("PRISMSTUDIO_PROJECT_ROOT");
    if (root.len == 0) { return true; }
    if (path.len == 0 || (path[0] as i32) != 47 || path_has_parent_segment(path)) { return false; }
    let n: i32 = root.len;
    while (n > 1 && (root[n - 1] as i32) == 47) { n = n - 1; }
    if (path.len < n) { return false; }
    let i: i32 = 0;
    while (i < n) {
        if ((path[i] as i32) != (root[i] as i32)) { return false; }
        i = i + 1;
    }
    return path.len == n || (path[n] as i32) == 47;
}

fn agent_path_allowed(path: []u8) bool {
    if (path_under_root(path)) { return true; }
    agent_err("E_PATH_OUTSIDE_ROOT path must remain inside PRISMSTUDIO_PROJECT_ROOT");
    return false;
}

fn parse_kind_name(s: []u8) i32 {
    if (_zag_strcmp(s, "plate") == 1) { return 0; }
    if (_zag_strcmp(s, "gesn") == 1) { return 0; }
    if (_zag_strcmp(s, "chamber") == 1) { return 1; }
    if (_zag_strcmp(s, "exec") == 1) { return 1; }
    if (_zag_strcmp(s, "soh") == 1) { return 2; }
    if (_zag_strcmp(s, "emitter") == 1) { return 3; }
    if (_zag_strcmp(s, "laser") == 1) { return 3; }
    if (_zag_strcmp(s, "wdm") == 1) { return 3; }
    if (_zag_strcmp(s, "detector") == 1) { return 4; }
    if (_zag_strcmp(s, "sensor") == 1) { return 4; }
    if (_zag_strcmp(s, "mos2") == 1) { return 4; }
    return 0 - 1;
}

fn agent_flush() void { _zag_flush(); }

fn agent_ok1(msg: []u8) void {
    _zag_print("OK ");
    _zag_println(msg);
    agent_flush();
}

fn agent_ok0() void {
    _zag_println("OK");
    agent_flush();
}

fn agent_err(msg: []u8) void {
    _zag_print("ERR ");
    if (msg.len >= 2 && (msg[0] as i32) == 'E' && (msg[1] as i32) == '_') {
        _zag_println(msg);
    } else {
        _zag_print("E_COMMAND ");
        _zag_println(msg);
    }
    agent_flush();
}

// Owned-message variant: frees msg after printing. Use when msg is heap-allocated
// (built from _zag_str_concat / fmt_i / etc.). For string literals, use agent_err.
fn agent_errf(msg: []u8) void {
    agent_err(msg);
    _zag_str_free(msg);
}

// Owned-message variant: frees msg after printing. Use when msg is heap-allocated.
// For string literals, use agent_ok1.
fn agent_ok1f(msg: []u8) void {
    agent_ok1(msg);
    _zag_str_free(msg);
}

fn agent_dot() void {
    _zag_println(".");
    agent_flush();
}

fn agent_print_i(name_: []u8, v: i64) void {
    _zag_print(name_);
    let s: []u8 = _zag_i64_to_str(v);
    _zag_print(s);
    _zag_str_free(s);
}

fn agent_println_i(v: i64) void {
    let s: []u8 = _zag_i64_to_str(v);
    _zag_println(s);
    _zag_str_free(s);
}

fn agent_print_vox(v: Vox) void {
    agent_print_i("", v.x as i64);
    _zag_print(",");
    agent_print_i("", v.y as i64);
    _zag_print(",");
    agent_print_i("", v.z as i64);
}

fn agent_print_guide_path(g: Guide) void {
    _zag_print(" path=");
    let pi: i32 = 0;
    while (pi < g.path.len) {
        if (pi > 0) { _zag_print(" "); }
        agent_print_vox(g.path.data[pi]);
        pi = pi + 1;
    }
}

fn tok_i64(line: []u8, t: Tok) i64 {
    return _zag_str_to_i64(tok_slice(line, t));
}

// Parse a float from a token. Handles optional sign, integer part, optional
// fractional part. Used by camera orbit/pan/zoom for incremental navigation.
fn tok_f64(line: []u8, t: Tok) f64 {
    let s: []u8 = tok_slice(line, t);
    let i: i32 = 0;
    let neg: bool = false;
    if (i < s.len && s[i] == 0x2D) { neg = true; i = i + 1; }   // '-'
    else if (i < s.len && s[i] == 0x2B) { i = i + 1; }          // '+'
    let val: f64 = 0.0;
    while (i < s.len && s[i] >= 0x30 && s[i] <= 0x39) {
        val = val * 10.0 + ((s[i] - 0x30) as f64);
        i = i + 1;
    }
    if (i < s.len && s[i] == 0x2E) {   // '.'
        i = i + 1;
        let frac: f64 = 0.0;
        let div: f64 = 10.0;
        while (i < s.len && s[i] >= 0x30 && s[i] <= 0x39) {
            frac = frac + ((s[i] - 0x30) as f64) / div;
            div = div * 10.0;
            i = i + 1;
        }
        val = val + frac;
    }
    if (neg) { return 0.0 - val; }
    return val;
}

fn agent_help() void {
    agent_ok0();
    _zag_println("# PrismStudio agent commands");
    _zag_println("ping | help | capabilities | quit");
    _zag_println("new | demo | open <file.zpa> | save <file.zpa> | list_files");
    _zag_println("place <kind> <x> <y> <z> [rot] | place_here <kind> [rot] | place_on <kind> <plate> <lx> <lz> [rot]");
    _zag_println("delete <id> | route <fc> <fp> <tc> <tp>");
    _zag_println("can_place <kind> <x> <y> <z> [rot] | list | get <id> | select <id>");
    _zag_println("undo | redo | view | pick | open [file.zpa] | save [file.zpa]  (default: live session)");
    _zag_println("sim step [n] | sim reset | sim state | sim mode functional|physical | render <out.bmp>");
    _zag_println("camera <x> <y> <z> | camera orbit <yaw> <pitch> | camera pan <dx> <dz> | camera zoom <factor> | render_at <out.bmp> <x> <y> <z>");
    _zag_println("status | coords | stack [y] | power | perf | kinds");
    _zag_println("flash import <program.fir> | flash verify");
    _zag_println("ui list | ui screenshot <out.bmp> | ui activate <id> | ui click <x> <y> | ui type <text>");
    _zag_println("copy | paste | duplicate | group | ungroup | rename <id> <name> | visibility <id> | lock <id>");
    _zag_println("select_add <id> | select_remove <id> | select_clear");
    _zag_println("view top|front|right|perspective|reset | view frame selected|all | view toggle ortho|section|reduced_motion|object_snap");
    _zag_println("panel <optimizer|builder|settings|palette> [open|close]");
    _zag_println("optimizer apply|accept | optimizer decline|ignore | optimizer details");
    _zag_println("builder generate <xmin> <ymin> <zmin> <xmax> <ymax> <zmax> [plate_size] | builder apply|accept | builder decline|ignore | builder details");
    _zag_println("model status | model migrate <version>");
    _zag_println("export <prefix>  (writes BOM, netlist, models, report)");
    _zag_println("trace <out.trace> <steps>  (deterministic engine trace)");
    _zag_println("diagnostics <out.txt>  (metadata only; excludes scene contents)");
    _zag_println("details | logs [n] | audit | uilog [n]");
    _zag_println("test engine | test smoke | build");
    _zag_println("PRISMSTUDIO_GRANT may narrow grants: project= session= ops= path= expires_after_ms=");
    _zag_println("PRISMSTUDIO_ALLOW_OPS and PRISMSTUDIO_DENY_OPS accept operation classes; deny wins");
    _zag_println("kinds: plate chamber soh emitter detector");
    agent_dot();
}

fn agent_capabilities(a: *App) void {
    agent_ok0();
    _zag_println("protocol prismstudio-agent-1");
    let cb: []u8 = _zag_i64_to_str(cap_load());
    _zag_print("capability_bits "); _zag_println(cb);
    _zag_str_free(cb);
    _zag_println("mutation_idempotency PRISMSTUDIO_IDEMPOTENCY");
    _zag_println("revision_precondition PRISMSTUDIO_EXPECT_REV");
    let rev_s: []u8 = _zag_i64_to_str(a.*.session_rev);
    _zag_print("revision "); _zag_println(rev_s);
    _zag_str_free(rev_s);
    let mrb: []u8 = _zag_i64_to_str(limit_agent_request_bytes() as i64);
    _zag_print("max_request_bytes "); _zag_println(mrb);
    _zag_str_free(mrb);
    if (_zag_getenv("PRISMSTUDIO_PROJECT_ROOT").len > 0) { _zag_println("project_root_scope enabled"); }
    else { _zag_println("project_root_scope disabled"); }
    if (_zag_getenv("PRISMSTUDIO_GRANT").len > 0) { _zag_println("scoped_grant enabled"); }
    else { _zag_println("scoped_grant disabled"); }
    if (_zag_getenv("PRISMSTUDIO_ALLOW_OPS").len > 0 || _zag_getenv("PRISMSTUDIO_DENY_OPS").len > 0) {
        _zag_println("user_rules enabled");
    } else {
        _zag_println("user_rules disabled");
    }
    agent_dot();
}

fn agent_status(a: *App) void {
    let play: i64 = 0;
    if (a.*.sim.*.playing) { play = 1; }
    let spd: i64 = a.*.sim.*.speed as i64;
    let out: []u8 = prepend_f("frame=", fmt_i(a.*.frame));
    out = append_f(out, " comps=");
    out = append_ff(out, fmt_i(a.*.scene.*.comps.len as i64));
    out = append_f(out, " guides=");
    out = append_ff(out, fmt_i(a.*.scene.*.guides.len as i64));
    out = append_f(out, " symbol=");
    out = append_ff(out, fmt_i(a.*.sim.*.symbol));
    out = append_f(out, " playing=");
    out = append_ff(out, fmt_i(play));
    out = append_f(out, " speed=");
    out = append_ff(out, fmt_i(spd));
    out = append_f(out, " frame_ms=");
    out = append_ff(out, fmt_i(a.*.frame_ms));
    out = append_f(out, " file=");
    out = append_f(out, a.*.file_);
    out = append_f(out, " undo=");
    out = append_ff(out, fmt_i(journal_undo_len(&a.*.jrn) as i64));
    out = append_f(out, " redo=");
    out = append_ff(out, fmt_i(journal_redo_len(&a.*.jrn) as i64));
    out = append_f(out, " revision=");
    out = append_ff(out, fmt_i(a.*.session_rev));
    agent_ok1f(out);
}

fn agent_is_mutation(line: []u8, toks: *list.ArrayList[Tok]) bool {
    if (toks.*.len == 0) { return false; }
    let verb: Tok = list.get[Tok](toks, 0);
    if (tok_eq(line, verb, "new") || tok_eq(line, verb, "demo") ||
        tok_eq(line, verb, "place") || tok_eq(line, verb, "place_here") ||
        tok_eq(line, verb, "place_on") || tok_eq(line, verb, "route") ||
        tok_eq(line, verb, "delete") || tok_eq(line, verb, "del") ||
        tok_eq(line, verb, "undo") || tok_eq(line, verb, "redo") ||
        tok_eq(line, verb, "move") || tok_eq(line, verb, "rotate") ||
        tok_eq(line, verb, "disconnect") || tok_eq(line, verb, "reroute") ||
        tok_eq(line, verb, "close") ||
        tok_eq(line, verb, "save") || tok_eq(line, verb, "open") ||
        // component manipulation (scene-modifying only)
        tok_eq(line, verb, "paste") || tok_eq(line, verb, "group") ||
        tok_eq(line, verb, "ungroup") || tok_eq(line, verb, "rename") ||
        tok_eq(line, verb, "visibility") ||
        // panel control (UI state change)
        tok_eq(line, verb, "panel")) { return true; }
    if (tok_eq(line, verb, "optimizer") && toks.*.len >= 2 &&
        (tok_eq(line, list.get[Tok](toks, 1), "apply") ||
         tok_eq(line, list.get[Tok](toks, 1), "accept") ||
         tok_eq(line, list.get[Tok](toks, 1), "decline") ||
         tok_eq(line, list.get[Tok](toks, 1), "ignore") ||
         tok_eq(line, list.get[Tok](toks, 1), "details"))) { return true; }
    if (tok_eq(line, verb, "builder") && toks.*.len >= 2 &&
        (tok_eq(line, list.get[Tok](toks, 1), "apply") ||
         tok_eq(line, list.get[Tok](toks, 1), "accept") ||
         tok_eq(line, list.get[Tok](toks, 1), "decline") ||
         tok_eq(line, list.get[Tok](toks, 1), "ignore"))) { return true; }
    if (tok_eq(line, verb, "ui") && toks.*.len >= 2 &&
        (tok_eq(line, list.get[Tok](toks, 1), "activate") ||
         tok_eq(line, list.get[Tok](toks, 1), "click") ||
         tok_eq(line, list.get[Tok](toks, 1), "type"))) { return true; }
    if (tok_eq(line, verb, "model") && toks.*.len >= 2 &&
        tok_eq(line, list.get[Tok](toks, 1), "migrate")) { return true; }
    return tok_eq(line, verb, "flash") && toks.*.len >= 2 &&
        tok_eq(line, list.get[Tok](toks, 1), "import");
}

fn agent_starts_with(s: []u8, prefix: []u8) bool {
    if (s.len < prefix.len) { return false; }
    let i: i32 = 0;
    while (i < prefix.len) {
        if (s[i] != prefix[i]) { return false; }
        i = i + 1;
    }
    return true;
}

fn agent_field_value(raw: []u8, key: []u8) []u8 {
    let i: i32 = 0;
    while (i < raw.len) {
        while (i < raw.len && (raw[i] as i32) == 32) { i = i + 1; }
        let st: i32 = i;
        while (i < raw.len && (raw[i] as i32) != 32) { i = i + 1; }
        let end: i32 = i;
        if (end > st + key.len && raw[st + key.len] == 61) {
            let same: bool = true;
            let k: i32 = 0;
            while (k < key.len) {
                if (raw[st + k] != key[k]) { same = false; }
                k = k + 1;
            }
            if (same) { return raw[st + key.len + 1..end]; }
        }
    }
    return "";
}

fn agent_class_for_required(required: i64) []u8 {
    if (required == cap_read()) { return "read"; }
    if (required == cap_inspect()) { return "inspect"; }
    if (required == cap_simulate()) { return "simulate"; }
    if (required == cap_edit()) { return "edit"; }
    if (required == cap_save()) { return "save"; }
    if (required == cap_export()) { return "export"; }
    if (required == cap_execute()) { return "execute-local"; }
    if (required == cap_admin()) { return "admin"; }
    return "unknown";
}

fn agent_list_contains_csv(raw: []u8, item: []u8) bool {
    let i: i32 = 0;
    while (i <= raw.len) {
        let st: i32 = i;
        while (i < raw.len && raw[i] != 44) { i = i + 1; }
        if (i - st == item.len) {
            let same: bool = true;
            let k: i32 = 0;
            while (k < item.len) {
                if (raw[st + k] != item[k]) { same = false; }
                k = k + 1;
            }
            if (same) { return true; }
        }
        i = i + 1;
    }
    return false;
}

fn agent_request_path(line: []u8, toks: *list.ArrayList[Tok]) []u8 {
    if (toks.*.len == 0) { return ""; }
    let verb: Tok = list.get[Tok](toks, 0);
    if ((tok_eq(line, verb, "save") || tok_eq(line, verb, "open") ||
        tok_eq(line, verb, "render") || tok_eq(line, verb, "export") ||
        tok_eq(line, verb, "trace") || tok_eq(line, verb, "diagnostics")) && toks.*.len >= 2) {
        return tok_slice(line, list.get[Tok](toks, 1));
    }
    if (tok_eq(line, verb, "flash") && toks.*.len >= 3 &&
        tok_eq(line, list.get[Tok](toks, 1), "import")) {
        return tok_slice(line, list.get[Tok](toks, 2));
    }
    return "";
}

fn agent_path_under_scope(path: []u8, scope: []u8) bool {
    if (scope.len == 0) { return true; }
    if (path.len < scope.len) { return false; }
    if (!agent_starts_with(path, scope)) { return false; }
    return path.len == scope.len || scope[scope.len - 1] == 47 || path[scope.len] == 47;
}

fn agent_scoped_grant_allowed(line: []u8, toks: *list.ArrayList[Tok], required: i64) bool {
    let raw: []u8 = _zag_getenv("PRISMSTUDIO_GRANT");
    if (raw.len == 0) { return true; }
    let project: []u8 = agent_field_value(raw, "project");
    if (project.len > 0 && _zag_strcmp(project, _zag_getenv("PRISMSTUDIO_PROJECT_ROOT")) != 1) {
        agent_err("E_GRANT_SCOPE project mismatch");
        return false;
    }
    let session: []u8 = agent_field_value(raw, "session");
    if (session.len > 0 && _zag_strcmp(session, session_zpa_path()) != 1) {
        agent_err("E_GRANT_SCOPE session mismatch");
        return false;
    }
    let ops: []u8 = agent_field_value(raw, "ops");
    if (ops.len > 0 && !agent_list_contains_csv(ops, agent_class_for_required(required))) {
        agent_err("E_GRANT_SCOPE operation denied");
        return false;
    }
    let scope_path: []u8 = agent_field_value(raw, "path");
    if (scope_path.len > 0) {
        let p: []u8 = agent_request_path(line, toks);
        if (p.len == 0 || !agent_path_under_scope(p, scope_path)) {
            agent_err("E_GRANT_SCOPE path denied");
            return false;
        }
    }
    let expires: []u8 = agent_field_value(raw, "expires_after_ms");
    if (expires.len > 0 && _zag_str_to_i64(expires) <= _zag_clock_monotonic_ms()) {
        agent_err("E_GRANT_SCOPE expired");
        return false;
    }
    return true;
}

fn agent_user_rule_matches(env_name: []u8, required: i64) bool {
    let raw: []u8 = _zag_getenv(env_name);
    if (raw.len == 0) { return false; }
    return agent_list_contains_csv(raw, agent_class_for_required(required));
}

fn agent_revision_precondition(a: *App) bool {
    let raw: []u8 = _zag_getenv("PRISMSTUDIO_EXPECT_REV");
    if (raw.len == 0 && a.*.request_expected_rev < 0) { return true; }
    let expected: i64 = a.*.request_expected_rev;
    if (expected < 0) { expected = _zag_str_to_i64(raw); }
    let current: i64 = session_read_rev();
    if (expected == current && expected == a.*.session_rev) { return true; }
    let out: []u8 = prepend_f("E_REV_CONFLICT you_sent=", fmt_i(expected));
    out = append_f(out, " current_revision=");
    out = append_ff(out, fmt_i(current));
    out = append_f(out, " (use current revision as precondition)");
    agent_errf(out);
    return false;
}

fn agent_idempotency_key_valid(key: []u8) bool {
    if (key.len == 0 || key.len > 64) { return false; }
    let i: i32 = 0;
    while (i < key.len) {
        let c: i32 = key[i] as i32;
        let ok: bool = (c >= 48 && c <= 57) || (c >= 65 && c <= 90) ||
            (c >= 97 && c <= 122) || c == 45 || c == 46 || c == 95;
        if (!ok) { return false; }
        i = i + 1;
    }
    return true;
}

fn agent_idempotency_prepare(a: *App) i32 {
    let key: []u8 = _zag_getenv("PRISMSTUDIO_IDEMPOTENCY");
    if (a.*.request_enveloped) { key = a.*.request_idempotency; }
    if (key.len == 0) {
        agent_err("E_IDEMPOTENCY_REQUIRED use request <key> <revision> <command>");
        return 0 - 1;
    }
    if (!agent_idempotency_key_valid(key)) {
        agent_err("E_IDEMPOTENCY_KEY expected 1..64 letters, digits, dot, dash, underscore");
        return 0 - 1;
    }
    let committed: i64 = session_idem_lookup(key);
    if (committed >= 0) {
        let out: []u8 = prepend_f("replay idempotency_key=", _zag_strdup(key));
        out = append_f(out, " revision=");
        out = append_ff(out, fmt_i(committed));
        agent_ok1f(out);
        return 1;
    }
    a.*.request_idempotency = key;
    return 0;
}

fn agent_mutation_ok(a: *App, msg: []u8, affected: i32) void {
    // msg is borrowed (caller retains ownership for audit_append_result below).
    let out: []u8 = prepend_f(msg, _zag_strdup(" revision="));
    out = append_ff(out, fmt_i(a.*.session_rev));
    out = append_f(out, " idempotency_key=");
    let key: []u8 = a.*.request_idempotency;
    if (key.len == 0) { key = "legacy"; }
    out = append_f(out, key);
    out = append_f(out, " undo_token=");
    out = append_ff(out, fmt_i(a.*.session_rev));
    out = append_f(out, " affected_id=");
    out = append_ff(out, fmt_i(affected as i64));
    audit_append_result(a.*.request_command, msg, a.*.request_required, a.*.session_rev, affected);
    agent_ok1f(out);
}

fn agent_coords(a: *App) void {
    let s: *Scene = a.*.scene;
    agent_ok0();
    let i: i32 = 0;
    while (i < s.*.comps.len) {
        let c: Comp = s.*.comps.data[i];
        _zag_print("C ");
        agent_print_i("", c.id as i64);
        _zag_print(" ");
        _zag_print(kind_slug(c.kind));
        _zag_print(" ");
        agent_print_i("", c.origin.x as i64);
        _zag_print(" ");
        agent_print_i("", c.origin.y as i64);
        _zag_print(" ");
        agent_print_i("", c.origin.z as i64);
        _zag_print(" rot=");
        agent_print_i("", c.rot as i64);
        _zag_println("");
        let pi: i32 = 0;
        while (pi < kind_port_count(c.kind)) {
            let p: Port = kind_port(c.kind, pi);
            let cell: Vox = comp_port_cell(c, pi);
            let attach: Vox = comp_port_attach(c, pi);
            _zag_print("P ");
            agent_print_i("", c.id as i64);
            _zag_print(" ");
            agent_print_i("", pi as i64);
            _zag_print(" ");
            _zag_print(p.label);
            _zag_print(" ");
            agent_print_i("", cell.x as i64);
            _zag_print(" ");
            agent_print_i("", cell.y as i64);
            _zag_print(" ");
            agent_print_i("", cell.z as i64);
            _zag_print(" ");
            agent_print_i("", attach.x as i64);
            _zag_print(" ");
            agent_print_i("", attach.y as i64);
            _zag_print(" ");
            let az: []u8 = _zag_i64_to_str(attach.z as i64);
            _zag_println(az);
            _zag_str_free(az);
            pi = pi + 1;
        }
        i = i + 1;
    }
    agent_dot();
}

// Print the pinned process-stack contract.  This is intentionally an
// inspection-only view: an agent gets exact Y-layer rules and provenance
// without being allowed to invent material thicknesses for an uncharacterized
// process.
fn agent_process_stack(a: *App, only_y: i32) void {
    let m: DeviceModel = a.*.scene.*.model;
    agent_ok0();
    _zag_print("process_stack schema=");
    let psv: []u8 = _zag_i64_to_str(process_stack_schema_version() as i64);
    _zag_print(psv);
    _zag_str_free(psv);
    _zag_print(" model=");
    _zag_println(m.id);
    let i: i32 = 0;
    while (i < process_layer_count()) {
        let layer: ProcessLayer = process_layer_at(i);
        if (only_y < 0 || only_y == layer.y) {
            _zag_print("Y ");
            let ys: []u8 = _zag_i64_to_str(layer.y as i64);
            _zag_print(ys);
            _zag_str_free(ys);
            _zag_print(" role="); _zag_print(process_layer_role_name(layer.role));
            _zag_print(" material="); _zag_print(layer.material);
            _zag_print(" thickness=");
            if (layer.thickness_nm.known) {
                let tv: []u8 = fmt_f1(layer.thickness_nm.value);
                _zag_print(tv);
                _zag_str_free(tv);
                _zag_print(" "); _zag_print(layer.thickness_nm.units);
            } else { _zag_print("Unknown"); }
            // PhysicalParam carries the authoritative user-visible evidence
            // class; do not duplicate it through a separate enum string path.
            _zag_print(" evidence="); _zag_print(evidence_class_name(layer.thickness_nm.confidence));
            _zag_print(" allows="); _zag_println(process_layer_content_summary(layer));
        }
        i = i + 1;
    }
    if (only_y >= process_layer_count()) {
        _zag_print("Y "); agent_print_i("", only_y as i64);
        _zag_println(" unavailable: no defined process layer");
    }
    agent_dot();
}

fn agent_power(a: *App) void {
    sim_recompile(a.*.sim, a.*.scene);
    agent_ok0();
    let i: i32 = 0;
    while (i < a.*.scene.*.comps.len) {
        let c: Comp = a.*.scene.*.comps.data[i];
        if (c.kind == Kind.Emitter) {
            let t: i32 = sim_history(a.*.sim, c.id, 0);
            _zag_print("E ");
            agent_print_i("", c.id as i64);
            _zag_print(" ");
            _zag_print(c.name_);
            _zag_print(" wl_nm=");
            agent_print_i("", c.wl_nm as i64);
            _zag_print(" live=");
            _zag_println(trit_glyph(t));
        }
        i = i + 1;
    }
    let gi: i32 = 0;
    while (gi < a.*.scene.*.guides.len) {
        let g: Guide = a.*.scene.*.guides.data[gi];
        _zag_print("W ");
        agent_print_i("", g.id as i64);
        _zag_print(" live=");
        _zag_println(trit_glyph(g.live));
        gi = gi + 1;
    }
    let ci: i32 = 0;
    while (ci < a.*.sim.*.nodes.len) {
        let n: SNode = a.*.sim.*.nodes.data[ci];
        if (n.kind == Kind.Chamber) {
            _zag_print("C ");
            agent_print_i("", n.comp_id as i64);
            _zag_print(" interference=");
            agent_print_i("", n.in_re as i64);
            _zag_print(" out=");
            _zag_println(trit_glyph(n.out_t));
        }
        ci = ci + 1;
    }
    agent_dot();
}

fn agent_perf_place(a: *App) i64 {
    let t0: i64 = _zag_clock_monotonic_ms();
    let _code: i32 = scene_can_place(a.*.scene, Kind.Plate, vox(0, 0, 0), 0);
    return _zag_clock_monotonic_ms() - t0;
}

fn agent_find_port_comp(s: *Scene, start: i32) i32 {
    let i: i32 = start;
    while (i < s.*.comps.len) {
        if (kind_port_count(s.*.comps.data[i].kind) > 0) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

fn agent_perf_route(a: *App) i64 {
    let s: *Scene = a.*.scene;
    if (s.*.comps.len < 2) { return 0; }
    let fi: i32 = agent_find_port_comp(s, 0);
    if (fi < 0) { return 0; }
    let ti: i32 = agent_find_port_comp(s, fi + 1);
    if (ti < 0) { return 0; }
    let src: Comp = s.*.comps.data[fi];
    let dst: Comp = s.*.comps.data[ti];
    let start: Vox = comp_port_attach(src, 0);
    let goal: Vox = comp_port_attach(dst, 0);
    let path: list.ArrayList[Vox] = list.make[Vox](32);
    let t0: i64 = _zag_clock_monotonic_ms();
    let _ok: bool = route_guide(s, start, goal, &path);
    let ms: i64 = _zag_clock_monotonic_ms() - t0;
    list.free[Vox](&path);
    return ms;
}

fn agent_perf_render(a: *App) i64 {
    let t0: i64 = _zag_clock_monotonic_ms();
    app_frame(a, 0.0);
    let ms: i64 = _zag_clock_monotonic_ms() - t0;
    a.*.frame_ms = ms;
    a.*.frame = a.*.frame + 1;
    return ms;
}

fn agent_perf(a: *App) void {
    let place_ms: i64 = agent_perf_place(a);
    let route_ms: i64 = agent_perf_route(a);
    let render_ms: i64 = agent_perf_render(a);
    let total_ms: i64 = place_ms + route_ms + render_ms;
    let out: []u8 = prepend_f("place_ms=", fmt_i(place_ms));
    out = append_f(out, " route_ms=");
    out = append_ff(out, fmt_i(route_ms));
    out = append_f(out, " render_ms=");
    out = append_ff(out, fmt_i(render_ms));
    out = append_f(out, " total_ms=");
    out = append_ff(out, fmt_i(total_ms));
    agent_ok1f(out);
}

