// fb.zag — software framebuffer for Zag Photonics Architect.
//
// Pixels are i64 elements holding 0x00RRGGBB in the low 4 bytes; the buffer
// is written verbatim to /dev/shm and the display shim compacts 8 -> 4 bytes.
// A parallel i64 z-buffer (fixed-point depth, larger = nearer test inverted:
// we store depth*1024, smaller wins) backs the 3D viewport region.

@import("../std/list.zag") as list
@import("../std/rt.zag")
@import("fontatlas.zag")
@import("strutil.zag")

// Typography faces (see tools/genfontatlas.py). All UI text renders from a
// proportional anti-aliased face; the old 5x9 bitmap font is retired.
fn face_body() i32 { return 0; }      // Fira Sans Regular 13 — default UI text
fn face_body_med() i32 { return 1; }  // Fira Sans Medium 13 — emphasis, active
fn face_dense() i32 { return 2; }     // Fira Sans Regular 12 — rows, status
fn face_section() i32 { return 3; }   // Fira Sans Medium 15 — panel titles
fn face_title() i32 { return 4; }     // Fira Sans Medium 18 — app title

struct FB {
    px: list.ArrayList[i64],
    zb: list.ArrayList[i64],
    w: i32,           // logical width (app coordinates)
    h: i32,           // logical height (app coordinates)
    scale: i32,       // physical pixels per logical pixel (1 = unscaled)
    // active clip rect in LOGICAL coordinates (inclusive min, exclusive max)
    cx0: i32,
    cy0: i32,
    cx1: i32,
    cy1: i32,
    // decoded 8-bit glyph coverage for every baked face (fontatlas.zag),
    // decoded once from base64 so the text hot path is a table blit.
    fcov: list.ArrayList[u8],
    // retained for API compatibility; baked coverage is deterministic, so
    // anti-aliased text no longer needs a crisp fallback mode.
    aa_text: bool,
}

// Physical dimensions of the pixel buffer.
fn fb_pw(f: *FB) i32 { return f.*.w * f.*.scale; }
fn fb_ph(f: *FB) i32 { return f.*.h * f.*.scale; }

fn fa_b64_val(c: i32) i32 {
    if (c >= 'A' && c <= 'Z') { return c - 'A'; }
    if (c >= 'a' && c <= 'z') { return c - 'a' + 26; }
    if (c >= '0' && c <= '9') { return c - '0' + 52; }
    if (c == '+') { return 62; }
    if (c == '/') { return 63; }
    return 0 - 1; // '=' padding
}

fn fb_build_atlas(f: *FB) void {
    f.*.fcov.len = 0;
    let ci: i32 = 0;
    let acc: i32 = 0;
    let bits: i32 = 0;
    while (ci < fa_chunk_count()) {
        let s: []u8 = fa_chunk(ci);
        let i: i32 = 0;
        while (i < s.len) {
            let v: i32 = fa_b64_val(s[i] as i32);
            if (v >= 0) {
                acc = (acc * 64) + v;
                bits = bits + 6;
                if (bits >= 8) {
                    bits = bits - 8;
                    list.push[u8](&f.*.fcov, ((acc >> bits) & 255) as u8);
                    acc = acc & ((1 << bits) - 1);
                }
            }
            i = i + 1;
        }
        ci = ci + 1;
    }
}

fn rgb(r: i32, g: i32, b: i32) i64 {
    return ((r * 65536) + (g * 256) + b) as i64;
}

fn col_r(c: i64) i32 { return ((c as i32) >> 16) & 255; }
fn col_g(c: i64) i32 { return ((c as i32) >> 8) & 255; }
fn col_b(c: i64) i32 { return (c as i32) & 255; }

// Linear blend: a over b with alpha 0..256.
fn mix(a: i64, b: i64, alpha: i32) i64 {
    let ia: i32 = 256 - alpha;
    let r: i32 = (col_r(a) * alpha + col_r(b) * ia) >> 8;
    let g: i32 = (col_g(a) * alpha + col_g(b) * ia) >> 8;
    let bl: i32 = (col_b(a) * alpha + col_b(b) * ia) >> 8;
    return rgb(r, g, bl);
}

// Scale color brightness by q/256.
fn shade(c: i64, q: i32) i64 {
    let r: i32 = (col_r(c) * q) >> 8;
    let g: i32 = (col_g(c) * q) >> 8;
    let b: i32 = (col_b(c) * q) >> 8;
    if (r > 255) { r = 255; }
    if (g > 255) { g = 255; }
    if (b > 255) { b = 255; }
    return rgb(r, g, b);
}

fn fb_new(w: i32, h: i32) FB {
    return fb_new_scaled(w, h, 1);
}

fn fb_new_scaled(w: i32, h: i32, scale: i32) FB {
    if (scale < 1) { scale = 1; }
    let pw: i32 = w * scale;
    let ph: i32 = h * scale;
    let f: FB = FB{
        .px = list.make[i64](pw * ph),
        .zb = list.make[i64](pw * ph),
        .w = w,
        .h = h,
        .scale = scale,
        .cx0 = 0,
        .cy0 = 0,
        .cx1 = w,
        .cy1 = h,
        .fcov = list.make[u8](fa_cov_len()),
        .aa_text = true,
    };
    f.px.len = pw * ph;
    f.zb.len = pw * ph;
    fb_build_atlas(&f);
    return f;
}

fn fb_resize(f: *FB, w: i32, h: i32) void {
    if (f.*.w == w && f.*.h == h) { return; }
    let pw: i32 = w * f.*.scale;
    let ph: i32 = h * f.*.scale;
    list.free[i64](&f.*.px);
    list.free[i64](&f.*.zb);
    f.*.px = list.make[i64](pw * ph);
    f.*.zb = list.make[i64](pw * ph);
    f.*.px.len = pw * ph;
    f.*.zb.len = pw * ph;
    f.*.w = w;
    f.*.h = h;
    fb_clip_reset(f);
}

fn fb_set_scale(f: *FB, scale: i32) void {
    if (scale < 1) { scale = 1; }
    if (f.*.scale == scale) { return; }
    let pw: i32 = f.*.w * scale;
    let ph: i32 = f.*.h * scale;
    list.free[i64](&f.*.px);
    list.free[i64](&f.*.zb);
    f.*.px = list.make[i64](pw * ph);
    f.*.zb = list.make[i64](pw * ph);
    f.*.px.len = pw * ph;
    f.*.zb.len = pw * ph;
    f.*.scale = scale;
    fb_clip_reset(f);
}

// Integer nearest-neighbor upscale of `src` into `dst` by `scale` (for HiDPI:
// render the whole UI at a logical resolution, then upscale to physical pixels).
// dst must be at least src.w*scale by src.h*scale.
fn fb_upscale(dst: *FB, src: *FB, scale: i32) void {
    let dw: i32 = src.*.w * scale;
    let dh: i32 = src.*.h * scale;
    if (dst.*.w < dw || dst.*.h < dh) { return; }
    let y: i32 = 0;
    while (y < dh) {
        let sy: i32 = y / scale;
        let srow: i32 = sy * src.*.w;
        let drow: i32 = y * dst.*.w;
        let x: i32 = 0;
        while (x < dw) {
            dst.*.px.data[drow + x] = src.*.px.data[srow + (x / scale)];
            x = x + 1;
        }
        y = y + 1;
    }
}

fn fb_clip(f: *FB, x0: i32, y0: i32, x1: i32, y1: i32) void {
    let s: i32 = f.*.scale;
    f.*.cx0 = x0 * s;
    f.*.cy0 = y0 * s;
    f.*.cx1 = x1 * s;
    f.*.cy1 = y1 * s;
    if (f.*.cx0 < 0) { f.*.cx0 = 0; }
    if (f.*.cy0 < 0) { f.*.cy0 = 0; }
    if (f.*.cx1 > fb_pw(f)) { f.*.cx1 = fb_pw(f); }
    if (f.*.cy1 > fb_ph(f)) { f.*.cy1 = fb_ph(f); }
}

fn fb_clip_reset(f: *FB) void {
    f.*.cx0 = 0;
    f.*.cy0 = 0;
    f.*.cx1 = fb_pw(f);
    f.*.cy1 = fb_ph(f);
}

fn px_set(f: *FB, x: i32, y: i32, c: i64) void {
    let s: i32 = f.*.scale;
    let px: i32 = x * s;
    let py: i32 = y * s;
    // fast path: scale 1, single pixel
    if (s == 1) {
        if (px < f.*.cx0 || px >= f.*.cx1 || py < f.*.cy0 || py >= f.*.cy1) { return; }
        f.*.px.data[py * fb_pw(f) + px] = c;
        return;
    }
    // scale > 1: fill s×s block of physical pixels
    let pw: i32 = fb_pw(f);
    let yy: i32 = 0;
    while (yy < s) {
        let ry: i32 = py + yy;
        if (ry >= f.*.cy0 && ry < f.*.cy1) {
            let base: i32 = ry * pw;
            let xx: i32 = 0;
            while (xx < s) {
                let rx: i32 = px + xx;
                if (rx >= f.*.cx0 && rx < f.*.cx1) { f.*.px.data[base + rx] = c; }
                xx = xx + 1;
            }
        }
        yy = yy + 1;
    }
}

fn px_blend(f: *FB, x: i32, y: i32, c: i64, alpha: i32) void {
    let s: i32 = f.*.scale;
    let px: i32 = x * s;
    let py: i32 = y * s;
    if (s == 1) {
        if (px < f.*.cx0 || px >= f.*.cx1 || py < f.*.cy0 || py >= f.*.cy1) { return; }
        let idx: i32 = py * fb_pw(f) + px;
        f.*.px.data[idx] = mix(c, f.*.px.data[idx], alpha);
        return;
    }
    let pw: i32 = fb_pw(f);
    let yy: i32 = 0;
    while (yy < s) {
        let ry: i32 = py + yy;
        if (ry >= f.*.cy0 && ry < f.*.cy1) {
            let base: i32 = ry * pw;
            let xx: i32 = 0;
            while (xx < s) {
                let rx: i32 = px + xx;
                if (rx >= f.*.cx0 && rx < f.*.cx1) {
                    f.*.px.data[base + rx] = mix(c, f.*.px.data[base + rx], alpha);
                }
                xx = xx + 1;
            }
        }
        yy = yy + 1;
    }
}

// Z-buffer access scaled to physical resolution. The 3D rasterizer works in
// logical coordinates; each logical cell maps to a scale×scale physical block
// that shares one z-value so depth tests are consistent within the cell.
fn zb_get(f: *FB, x: i32, y: i32) i64 {
    let s: i32 = f.*.scale;
    return f.*.zb.data[(y * s) * fb_pw(f) + (x * s)];
}

fn zb_set(f: *FB, x: i32, y: i32, z: i64) void {
    let s: i32 = f.*.scale;
    let px: i32 = x * s;
    let py: i32 = y * s;
    if (s == 1) {
        if (px < f.*.cx0 || px >= f.*.cx1 || py < f.*.cy0 || py >= f.*.cy1) { return; }
        f.*.zb.data[py * fb_pw(f) + px] = z;
        return;
    }
    let pw: i32 = fb_pw(f);
    let yy: i32 = 0;
    while (yy < s) {
        let ry: i32 = py + yy;
        if (ry >= f.*.cy0 && ry < f.*.cy1) {
            let base: i32 = ry * pw;
            let xx: i32 = 0;
            while (xx < s) {
                let rx: i32 = px + xx;
                if (rx >= f.*.cx0 && rx < f.*.cx1) { f.*.zb.data[base + rx] = z; }
                xx = xx + 1;
            }
        }
        yy = yy + 1;
    }
}

// Clear a logical rect of the z-buffer to a given value (used by vp_clear).
fn zb_clear_rect(f: *FB, x: i32, y: i32, w: i32, h: i32, z: i64) void {
    let yy: i32 = 0;
    while (yy < h) {
        let xx: i32 = 0;
        while (xx < w) {
            zb_set(f, x + xx, y + yy, z);
            xx = xx + 1;
        }
        yy = yy + 1;
    }
}

fn fill_rect(f: *FB, x: i32, y: i32, w: i32, h: i32, c: i64) void {
    let s: i32 = f.*.scale;
    let x0: i32 = x * s;
    let y0: i32 = y * s;
    let x1: i32 = (x + w) * s;
    let y1: i32 = (y + h) * s;
    if (x0 < f.*.cx0) { x0 = f.*.cx0; }
    if (y0 < f.*.cy0) { y0 = f.*.cy0; }
    if (x1 > f.*.cx1) { x1 = f.*.cx1; }
    if (y1 > f.*.cy1) { y1 = f.*.cy1; }
    let pw: i32 = fb_pw(f);
    let yy: i32 = y0;
    while (yy < y1) {
        let base: i32 = yy * pw;
        let xx: i32 = x0;
        while (xx + 4 <= x1) {
            f.*.px.data[base + xx] = c;
            f.*.px.data[base + xx + 1] = c;
            f.*.px.data[base + xx + 2] = c;
            f.*.px.data[base + xx + 3] = c;
            xx = xx + 4;
        }
        while (xx < x1) {
            f.*.px.data[base + xx] = c;
            xx = xx + 1;
        }
        yy = yy + 1;
    }
}

fn blend_rect(f: *FB, x: i32, y: i32, w: i32, h: i32, c: i64, alpha: i32) void {
    let s: i32 = f.*.scale;
    let x0: i32 = x * s;
    let y0: i32 = y * s;
    let x1: i32 = (x + w) * s;
    let y1: i32 = (y + h) * s;
    if (x0 < f.*.cx0) { x0 = f.*.cx0; }
    if (y0 < f.*.cy0) { y0 = f.*.cy0; }
    if (x1 > f.*.cx1) { x1 = f.*.cx1; }
    if (y1 > f.*.cy1) { y1 = f.*.cy1; }
    let pw: i32 = fb_pw(f);
    let yy: i32 = y0;
    while (yy < y1) {
        let base: i32 = yy * pw;
        let xx: i32 = x0;
        while (xx < x1) {
            f.*.px.data[base + xx] = mix(c, f.*.px.data[base + xx], alpha);
            xx = xx + 1;
        }
        yy = yy + 1;
    }
}

fn rect_outline(f: *FB, x: i32, y: i32, w: i32, h: i32, c: i64) void {
    fill_rect(f, x, y, w, 1, c);
    fill_rect(f, x, y + h - 1, w, 1, c);
    fill_rect(f, x, y, 1, h, c);
    fill_rect(f, x + w - 1, y, 1, h, c);
}

// ── anti-aliased rounded rectangles (modern UI chrome) ───────────────────────
// A rounded rect is straight-edge fills plus four anti-aliased quarter-disc
// corners: coverage falls off across ~1px at the arc so corners read smooth
// instead of stepped. These run inside cached panel surfaces, so the per-corner
// distance math is paid only on redraw, not every frame.

fn rr_clamp_radius(w: i32, h: i32, r: i32) i32 {
    let m: i32 = w;
    if (h < m) { m = h; }
    let rc: i32 = r;
    if (rc > m / 2) { rc = m / 2; }
    if (rc < 0) { rc = 0; }
    return rc;
}

// Fill one r-sized corner box whose arc center is (cx,cy), covering the disc.
// All inputs are LOGICAL; coordinates and radius are scaled to physical pixels
// so the arc coverage is evaluated at physical resolution (smooth at HiDPI).
fn rr_corner(f: *FB, bx: i32, by: i32, r: i32, cx: f64, cy: f64, c: i64) void {
    let s: i32 = f.*.scale;
    if (s == 1) {
        let rf: f64 = r as f64;
        let py: i32 = by;
        while (py < by + r) {
            let px: i32 = bx;
            while (px < bx + r) {
                let dx: f64 = (px as f64) + 0.5 - cx;
                let dy: f64 = (py as f64) + 0.5 - cy;
                let d: f64 = sqrt(dx * dx + dy * dy);
                let cov: f64 = rf + 0.5 - d;
                if (cov >= 1.0) { px_set(f, px, py, c); }
                else if (cov > 0.0) { px_blend(f, px, py, c, (cov * 256.0) as i32); }
                px = px + 1;
            }
            py = py + 1;
        }
        return;
    }
    // scaled path: iterate physical pixels, convert back to logical for coverage
    let rf: f64 = (r * s) as f64;
    let bxp: i32 = bx * s;
    let byp: i32 = by * s;
    let rs: i32 = r * s;
    let cxs: f64 = cx * (s as f64);
    let cys: f64 = cy * (s as f64);
    let pw: i32 = fb_pw(f);
    let py: i32 = byp;
    while (py < byp + rs) {
        let base: i32 = py * pw;
        let px: i32 = bxp;
        while (px < bxp + rs) {
            let dx: f64 = (px as f64) + 0.5 - cxs;
            let dy: f64 = (py as f64) + 0.5 - cys;
            let d: f64 = sqrt(dx * dx + dy * dy);
            let cov: f64 = rf + 0.5 - d;
            if (cov >= 1.0) {
                if (px >= f.*.cx0 && px < f.*.cx1 && py >= f.*.cy0 && py < f.*.cy1) {
                    f.*.px.data[base + px] = c;
                }
            } else if (cov > 0.0) {
                if (px >= f.*.cx0 && px < f.*.cx1 && py >= f.*.cy0 && py < f.*.cy1) {
                    f.*.px.data[base + px] = mix(c, f.*.px.data[base + px], (cov * 256.0) as i32);
                }
            }
            px = px + 1;
        }
        py = py + 1;
    }
}

fn fill_round_rect(f: *FB, x: i32, y: i32, w: i32, h: i32, r: i32, c: i64) void {
    let rc: i32 = rr_clamp_radius(w, h, r);
    if (rc <= 0) { fill_rect(f, x, y, w, h, c); return; }
    fill_rect(f, x + rc, y, w - 2 * rc, h, c);           // center band (full height)
    fill_rect(f, x, y + rc, rc, h - 2 * rc, c);          // left band
    fill_rect(f, x + w - rc, y + rc, rc, h - 2 * rc, c); // right band
    let rf: f64 = rc as f64;
    rr_corner(f, x, y, rc, (x as f64) + rf, (y as f64) + rf, c);
    rr_corner(f, x + w - rc, y, rc, (x + w - rc) as f64, (y as f64) + rf, c);
    rr_corner(f, x, y + h - rc, rc, (x as f64) + rf, (y + h - rc) as f64, c);
    rr_corner(f, x + w - rc, y + h - rc, rc, (x + w - rc) as f64, (y + h - rc) as f64, c);
}

// Translucent rounded fill (arc alpha scales with the base alpha).
fn rr_corner_blend(f: *FB, bx: i32, by: i32, r: i32, cx: f64, cy: f64, c: i64, alpha: i32) void {
    let s: i32 = f.*.scale;
    if (s == 1) {
        let rf: f64 = r as f64;
        let py: i32 = by;
        while (py < by + r) {
            let px: i32 = bx;
            while (px < bx + r) {
                let dx: f64 = (px as f64) + 0.5 - cx;
                let dy: f64 = (py as f64) + 0.5 - cy;
                let d: f64 = sqrt(dx * dx + dy * dy);
                let cov: f64 = rf + 0.5 - d;
                if (cov > 0.0) {
                    let a: i32 = alpha;
                    if (cov < 1.0) { a = (cov * (alpha as f64)) as i32; }
                    px_blend(f, px, py, c, a);
                }
                px = px + 1;
            }
            py = py + 1;
        }
        return;
    }
    let rf: f64 = (r * s) as f64;
    let bxp: i32 = bx * s;
    let byp: i32 = by * s;
    let rs: i32 = r * s;
    let cxs: f64 = cx * (s as f64);
    let cys: f64 = cy * (s as f64);
    let pw: i32 = fb_pw(f);
    let py: i32 = byp;
    while (py < byp + rs) {
        let base: i32 = py * pw;
        let px: i32 = bxp;
        while (px < bxp + rs) {
            let dx: f64 = (px as f64) + 0.5 - cxs;
            let dy: f64 = (py as f64) + 0.5 - cys;
            let d: f64 = sqrt(dx * dx + dy * dy);
            let cov: f64 = rf + 0.5 - d;
            if (cov > 0.0) {
                let a: i32 = alpha;
                if (cov < 1.0) { a = (cov * (alpha as f64)) as i32; }
                if (px >= f.*.cx0 && px < f.*.cx1 && py >= f.*.cy0 && py < f.*.cy1) {
                    f.*.px.data[base + px] = mix(c, f.*.px.data[base + px], a);
                }
            }
            px = px + 1;
        }
        py = py + 1;
    }
}

fn blend_round_rect(f: *FB, x: i32, y: i32, w: i32, h: i32, r: i32, c: i64, alpha: i32) void {
    let rc: i32 = rr_clamp_radius(w, h, r);
    if (rc <= 0) { blend_rect(f, x, y, w, h, c, alpha); return; }
    blend_rect(f, x + rc, y, w - 2 * rc, h, c, alpha);
    blend_rect(f, x, y + rc, rc, h - 2 * rc, c, alpha);
    blend_rect(f, x + w - rc, y + rc, rc, h - 2 * rc, c, alpha);
    let rf: f64 = rc as f64;
    rr_corner_blend(f, x, y, rc, (x as f64) + rf, (y as f64) + rf, c, alpha);
    rr_corner_blend(f, x + w - rc, y, rc, (x + w - rc) as f64, (y as f64) + rf, c, alpha);
    rr_corner_blend(f, x, y + h - rc, rc, (x as f64) + rf, (y + h - rc) as f64, c, alpha);
    rr_corner_blend(f, x + w - rc, y + h - rc, rc, (x + w - rc) as f64, (y + h - rc) as f64, c, alpha);
}

// 1px anti-aliased rounded border: straight edges plus arc rings.
fn rr_ring(f: *FB, bx: i32, by: i32, r: i32, cx: f64, cy: f64, c: i64) void {
    let s: i32 = f.*.scale;
    if (s == 1) {
        let rf: f64 = r as f64;
        let py: i32 = by;
        while (py < by + r) {
            let px: i32 = bx;
            while (px < bx + r) {
                let dx: f64 = (px as f64) + 0.5 - cx;
                let dy: f64 = (py as f64) + 0.5 - cy;
                let d: f64 = sqrt(dx * dx + dy * dy);
                let e: f64 = d - (rf - 0.5);
                if (e < 0.0) { e = 0.0 - e; }
                let cov: f64 = 1.0 - e;
                if (cov > 0.0) { px_blend(f, px, py, c, (cov * 256.0) as i32); }
                px = px + 1;
            }
            py = py + 1;
        }
        return;
    }
    let rf: f64 = (r * s) as f64;
    let bxp: i32 = bx * s;
    let byp: i32 = by * s;
    let rs: i32 = r * s;
    let cxs: f64 = cx * (s as f64);
    let cys: f64 = cy * (s as f64);
    let pw: i32 = fb_pw(f);
    let py: i32 = byp;
    while (py < byp + rs) {
        let base: i32 = py * pw;
        let px: i32 = bxp;
        while (px < bxp + rs) {
            let dx: f64 = (px as f64) + 0.5 - cxs;
            let dy: f64 = (py as f64) + 0.5 - cys;
            let d: f64 = sqrt(dx * dx + dy * dy);
            let e: f64 = d - (rf - 0.5);
            if (e < 0.0) { e = 0.0 - e; }
            let cov: f64 = 1.0 - e;
            if (cov > 0.0 && px >= f.*.cx0 && px < f.*.cx1 && py >= f.*.cy0 && py < f.*.cy1) {
                f.*.px.data[base + px] = mix(c, f.*.px.data[base + px], (cov * 256.0) as i32);
            }
            px = px + 1;
        }
        py = py + 1;
    }
}

fn round_rect_outline(f: *FB, x: i32, y: i32, w: i32, h: i32, r: i32, c: i64) void {
    let rc: i32 = rr_clamp_radius(w, h, r);
    if (rc <= 0) { rect_outline(f, x, y, w, h, c); return; }
    fill_rect(f, x + rc, y, w - 2 * rc, 1, c);          // top
    fill_rect(f, x + rc, y + h - 1, w - 2 * rc, 1, c);  // bottom
    fill_rect(f, x, y + rc, 1, h - 2 * rc, c);          // left
    fill_rect(f, x + w - 1, y + rc, 1, h - 2 * rc, c);  // right
    let rf: f64 = rc as f64;
    rr_ring(f, x, y, rc, (x as f64) + rf, (y as f64) + rf, c);
    rr_ring(f, x + w - rc, y, rc, (x + w - rc) as f64, (y as f64) + rf, c);
    rr_ring(f, x, y + h - rc, rc, (x as f64) + rf, (y + h - rc) as f64, c);
    rr_ring(f, x + w - rc, y + h - rc, rc, (x + w - rc) as f64, (y + h - rc) as f64, c);
}

// Soft drop shadow for floating surfaces (menus, popups, cards): a few
// expanding translucent rounded rects behind the element give a cheap blur.
fn draw_shadow(f: *FB, x: i32, y: i32, w: i32, h: i32, r: i32) void {
    blend_round_rect(f, x - 1, y + 1, w + 2, h + 3, r + 2, rgb(0, 0, 0), 40);
    blend_round_rect(f, x - 2, y + 2, w + 4, h + 5, r + 3, rgb(0, 0, 0), 26);
    blend_round_rect(f, x - 4, y + 4, w + 8, h + 8, r + 4, rgb(0, 0, 0), 14);
}

fn hline(f: *FB, x: i32, y: i32, w: i32, c: i64) void {
    fill_rect(f, x, y, w, 1, c);
}

fn vline(f: *FB, x: i32, y: i32, h: i32, c: i64) void {
    fill_rect(f, x, y, 1, h, c);
}

// Bresenham 2D line (logical coordinates; pixels scaled internally).
fn line2d(f: *FB, x0_: i32, y0_: i32, x1_: i32, y1_: i32, c: i64) void {
    let s: i32 = f.*.scale;
    let x0: i32 = x0_ * s;
    let y0: i32 = y0_ * s;
    let x1: i32 = x1_ * s;
    let y1: i32 = y1_ * s;
    let dx: i32 = x1 - x0;
    if (dx < 0) { dx = 0 - dx; }
    let dy: i32 = y1 - y0;
    if (dy < 0) { dy = 0 - dy; }
    dy = 0 - dy;
    let sx: i32 = 1;
    if (x0 > x1) { sx = 0 - 1; }
    let sy: i32 = 1;
    if (y0 > y1) { sy = 0 - 1; }
    let err: i32 = dx + dy;
    let pw: i32 = fb_pw(f);
    let running: bool = true;
    while (running) {
        if (x0 >= f.*.cx0 && x0 < f.*.cx1 && y0 >= f.*.cy0 && y0 < f.*.cy1) {
            f.*.px.data[y0 * pw + x0] = c;
        }
        if (x0 == x1 && y0 == y1) {
            running = false;
        } else {
            let e2: i32 = err * 2;
            if (e2 >= dy) {
                err = err + dy;
                x0 = x0 + sx;
            }
            if (e2 <= dx && running) {
                err = err + dx;
                y0 = y0 + sy;
            }
        }
    }
}

// ── stroke icons ────────────────────────────────────────────────────────────
// Vector-style 16×16 icons drawn from line2d + fill_rect primitives. All
// coordinates are logical; line2d scales internally so icons are crisp at
// any FB scale. Each icon is drawn centered in a 16×16 box at (x, y).

// Icon IDs — used by draw_icon to dispatch.
fn ico_select() i32 { return 0; }   // arrow cursor
fn ico_route() i32 { return 1; }    // curved path
fn ico_measure() i32 { return 2; }  // ruler
fn ico_gear() i32 { return 3; }     // settings cog
fn ico_eye() i32 { return 4; }      // visibility on
fn ico_eye_off() i32 { return 5; }  // visibility off
fn ico_lock() i32 { return 6; }     // locked
fn ico_unlock() i32 { return 7; }   // unlocked
fn ico_chevron_r() i32 { return 8; }  // collapsed
fn ico_chevron_d() i32 { return 9; }  // expanded
fn ico_plus() i32 { return 10; }
fn ico_minus() i32 { return 11; }
fn ico_warning() i32 { return 12; }   // triangle with !
fn ico_search() i32 { return 13; }    // magnifying glass
fn ico_grid() i32 { return 14; }      // grid toggle
fn ico_cube() i32 { return 15; }      // 3D cube (component)
fn ico_wave() i32 { return 16; }      // waveguide path
fn ico_play() i32 { return 17; }
fn ico_pause() i32 { return 18; }
fn ico_step() i32 { return 19; }      // step forward
fn ico_reset() i32 { return 20; }     // circular arrow

fn ico_count() i32 { return 21; }

// Draw icon `id` in a 16×16 box at (x, y) with color c.
// Split into two halves to keep the if-chain short for the codegen.
fn draw_icon_a(f: *FB, x: i32, y: i32, id: i32, c: i64) void {
    if (id == ico_select()) {
        // Arrow cursor: outline arrow pointing top-left
        line2d(f, x + 3, y + 2, x + 3, y + 13, c);
        line2d(f, x + 3, y + 2, x + 11, y + 10, c);
        line2d(f, x + 3, y + 13, x + 7, y + 9, c);
        line2d(f, x + 7, y + 9, x + 11, y + 10, c);
        fill_rect(f, x + 3, y + 2, 1, 12, c);
    } else if (id == ico_route()) {
        // Curved path with endpoints
        fill_rect(f, x + 2, y + 11, 3, 3, c);
        fill_rect(f, x + 11, y + 2, 3, 3, c);
        line2d(f, x + 3, y + 12, x + 6, y + 12, c);
        line2d(f, x + 6, y + 12, x + 9, y + 9, c);
        line2d(f, x + 9, y + 9, x + 12, y + 6, c);
        line2d(f, x + 12, y + 6, x + 12, y + 3, c);
    } else if (id == ico_measure()) {
        // Ruler: horizontal bar with tick marks
        fill_rect(f, x + 2, y + 6, 12, 5, c);
        fill_rect(f, x + 2, y + 6, 12, 1, shade(c, 160));
        fill_rect(f, x + 4, y + 6, 1, 2, shade(c, 60));
        fill_rect(f, x + 7, y + 6, 1, 3, shade(c, 60));
        fill_rect(f, x + 10, y + 6, 1, 2, shade(c, 60));
        fill_rect(f, x + 13, y + 6, 1, 3, shade(c, 60));
    } else if (id == ico_gear()) {
        // Cog: body + teeth + hub
        fill_rect(f, x + 5, y + 5, 6, 6, c);
        fill_rect(f, x + 7, y + 2, 2, 3, c);
        fill_rect(f, x + 7, y + 11, 2, 3, c);
        fill_rect(f, x + 2, y + 7, 3, 2, c);
        fill_rect(f, x + 11, y + 7, 3, 2, c);
        fill_rect(f, x + 3, y + 3, 2, 2, c);
        fill_rect(f, x + 11, y + 3, 2, 2, c);
        fill_rect(f, x + 3, y + 11, 2, 2, c);
        fill_rect(f, x + 11, y + 11, 2, 2, c);
        fill_rect(f, x + 7, y + 7, 2, 2, shade(c, 50));
    } else if (id == ico_eye()) {
        // Eye: lens + pupil
        line2d(f, x + 2, y + 8, x + 5, y + 5, c);
        line2d(f, x + 5, y + 5, x + 11, y + 5, c);
        line2d(f, x + 11, y + 5, x + 14, y + 8, c);
        line2d(f, x + 14, y + 8, x + 11, y + 11, c);
        line2d(f, x + 11, y + 11, x + 5, y + 11, c);
        line2d(f, x + 5, y + 11, x + 2, y + 8, c);
        fill_rect(f, x + 7, y + 7, 2, 2, c);
    } else if (id == ico_eye_off()) {
        // Eye with slash
        line2d(f, x + 2, y + 8, x + 5, y + 5, c);
        line2d(f, x + 5, y + 5, x + 11, y + 5, c);
        line2d(f, x + 11, y + 5, x + 14, y + 8, c);
        line2d(f, x + 14, y + 8, x + 11, y + 11, c);
        line2d(f, x + 11, y + 11, x + 5, y + 11, c);
        line2d(f, x + 5, y + 11, x + 2, y + 8, c);
        line2d(f, x + 2, y + 2, x + 13, y + 13, shade(c, 60));
    } else if (id == ico_lock()) {
        // Padlock: shackle + body
        line2d(f, x + 5, y + 7, x + 5, y + 5, c);
        line2d(f, x + 5, y + 5, x + 7, y + 3, c);
        line2d(f, x + 7, y + 3, x + 9, y + 3, c);
        line2d(f, x + 9, y + 3, x + 11, y + 5, c);
        line2d(f, x + 11, y + 5, x + 11, y + 7, c);
        fill_rect(f, x + 3, y + 7, 10, 7, c);
        fill_rect(f, x + 7, y + 9, 2, 3, shade(c, 50));
    } else if (id == ico_unlock()) {
        // Open padlock
        line2d(f, x + 5, y + 7, x + 5, y + 5, c);
        line2d(f, x + 5, y + 5, x + 7, y + 3, c);
        line2d(f, x + 7, y + 3, x + 9, y + 3, c);
        line2d(f, x + 9, y + 3, x + 11, y + 5, c);
        fill_rect(f, x + 3, y + 7, 10, 7, c);
        fill_rect(f, x + 7, y + 9, 2, 3, shade(c, 50));
    } else if (id == ico_chevron_r()) {
        // Right-pointing chevron
        line2d(f, x + 6, y + 4, x + 10, y + 8, c);
        line2d(f, x + 10, y + 8, x + 6, y + 12, c);
    } else if (id == ico_chevron_d()) {
        // Down-pointing chevron
        line2d(f, x + 4, y + 6, x + 8, y + 10, c);
        line2d(f, x + 8, y + 10, x + 12, y + 6, c);
    }
}

fn draw_icon_b(f: *FB, x: i32, y: i32, id: i32, c: i64) void {
    if (id == ico_plus()) {
        line2d(f, x + 8, y + 3, x + 8, y + 13, c);
        line2d(f, x + 3, y + 8, x + 13, y + 8, c);
    } else if (id == ico_minus()) {
        line2d(f, x + 3, y + 8, x + 13, y + 8, c);
    } else if (id == ico_warning()) {
        // Triangle with exclamation
        line2d(f, x + 8, y + 2, x + 2, y + 13, c);
        line2d(f, x + 2, y + 13, x + 14, y + 13, c);
        line2d(f, x + 14, y + 13, x + 8, y + 2, c);
        fill_rect(f, x + 7, y + 5, 2, 5, c);
        fill_rect(f, x + 7, y + 11, 2, 2, c);
    } else if (id == ico_search()) {
        // Magnifying glass
        line2d(f, x + 3, y + 3, x + 3, y + 8, c);
        line2d(f, x + 3, y + 8, x + 8, y + 8, c);
        line2d(f, x + 8, y + 8, x + 8, y + 3, c);
        line2d(f, x + 8, y + 3, x + 3, y + 3, c);
        line2d(f, x + 9, y + 9, x + 13, y + 13, c);
        line2d(f, x + 10, y + 13, x + 13, y + 13, c);
        line2d(f, x + 13, y + 10, x + 13, y + 13, c);
    } else if (id == ico_grid()) {
        // Grid squares
        line2d(f, x + 3, y + 3, x + 13, y + 3, c);
        line2d(f, x + 3, y + 8, x + 13, y + 8, c);
        line2d(f, x + 3, y + 13, x + 13, y + 13, c);
        line2d(f, x + 3, y + 3, x + 3, y + 13, c);
        line2d(f, x + 8, y + 3, x + 8, y + 13, c);
        line2d(f, x + 13, y + 3, x + 13, y + 13, c);
    } else if (id == ico_cube()) {
        // Isometric cube
        line2d(f, x + 8, y + 2, x + 14, y + 5, c);
        line2d(f, x + 14, y + 5, x + 14, y + 11, c);
        line2d(f, x + 14, y + 11, x + 8, y + 14, c);
        line2d(f, x + 8, y + 14, x + 2, y + 11, c);
        line2d(f, x + 2, y + 11, x + 2, y + 5, c);
        line2d(f, x + 2, y + 5, x + 8, y + 2, c);
        line2d(f, x + 8, y + 2, x + 8, y + 8, c);
        line2d(f, x + 8, y + 8, x + 14, y + 5, c);
        line2d(f, x + 8, y + 8, x + 2, y + 11, c);
    } else if (id == ico_wave()) {
        // Sine wave path
        line2d(f, x + 2, y + 8, x + 4, y + 5, c);
        line2d(f, x + 4, y + 5, x + 7, y + 5, c);
        line2d(f, x + 7, y + 5, x + 9, y + 11, c);
        line2d(f, x + 9, y + 11, x + 12, y + 11, c);
        line2d(f, x + 12, y + 11, x + 14, y + 8, c);
    } else if (id == ico_play()) {
        // Play triangle
        line2d(f, x + 4, y + 3, x + 4, y + 13, c);
        line2d(f, x + 4, y + 3, x + 12, y + 8, c);
        line2d(f, x + 12, y + 8, x + 4, y + 13, c);
        fill_rect(f, x + 5, y + 4, 6, 8, c);
    } else if (id == ico_pause()) {
        // Two bars
        fill_rect(f, x + 4, y + 3, 3, 11, c);
        fill_rect(f, x + 9, y + 3, 3, 11, c);
    } else if (id == ico_step()) {
        // Step forward: triangle + bar
        line2d(f, x + 3, y + 3, x + 3, y + 13, c);
        line2d(f, x + 3, y + 3, x + 10, y + 8, c);
        line2d(f, x + 10, y + 8, x + 3, y + 13, c);
        fill_rect(f, x + 4, y + 4, 5, 8, c);
        fill_rect(f, x + 12, y + 3, 2, 11, c);
    } else if (id == ico_reset()) {
        // Circular arrow
        line2d(f, x + 4, y + 4, x + 12, y + 4, c);
        line2d(f, x + 12, y + 4, x + 12, y + 10, c);
        line2d(f, x + 12, y + 10, x + 4, y + 10, c);
        line2d(f, x + 4, y + 10, x + 4, y + 6, c);
        line2d(f, x + 4, y + 6, x + 2, y + 8, c);
        line2d(f, x + 4, y + 6, x + 6, y + 8, c);
    }
}

fn draw_icon(f: *FB, x: i32, y: i32, id: i32, c: i64) void {
    draw_icon_a(f, x, y, id, c);
    draw_icon_b(f, x, y, id, c);
}

// ── text ─────────────────────────────────────────────────────────────────────
// Proportional anti-aliased text from the baked coverage atlas. `y` is the
// TOP of the line box; the baseline sits at y + fa_ascent(face). Coverage is
// 8-bit alpha baked at generation time for each integral UI scale, so
// draw_glyph blits real physical-resolution coverage — no replication.

// Blit one glyph at pen position (x, line-top y); returns the pen advance
// in LOGICAL pixels. At scale > 1 the baked face for that scale is selected
// so each physical pixel gets its own anti-aliased coverage sample.
fn draw_glyph(f: *FB, x: i32, y: i32, face: i32, ch: i32, c: i64) i32 {
    let s: i32 = f.*.scale;
    let baked: i32 = face + (s - 1) * fa_face_count();
    let g_phys: i64 = fa_g(baked, ch);
    let g_log: i64 = fa_g(face, ch);
    // advance always comes from the 1x (logical) face so pen movement
    // is in logical pixels regardless of the baked scale.
    let adv: i32 = (g_log & 127) as i32;
    if (g_phys == 0) { return adv; }
    let gw: i32 = ((g_phys >> 21) & 127) as i32;
    let gh: i32 = ((g_phys >> 28) & 127) as i32;
    let off: i32 = (g_phys >> 35) as i32;
    // physical blit origin: scale the logical pen, add the physical bearing.
    let gxp: i32 = x * s + (((g_phys >> 7) & 127) as i32) - 32;
    let gyp: i32 = y * s + (((g_phys >> 14) & 127) as i32) - 16;
    let pw: i32 = fb_pw(f);
    let row: i32 = 0;
    while (row < gh) {
        let rbase: i32 = off + row * gw;
        let ry: i32 = gyp + row;
        if (ry >= f.*.cy0 && ry < f.*.cy1) {
            let db: i32 = ry * pw;
            let col: i32 = 0;
            while (col < gw) {
                let cov: i32 = f.*.fcov.data[rbase + col] as i32;
                if (cov > 0) {
                    let rx: i32 = gxp + col;
                    if (rx >= f.*.cx0 && rx < f.*.cx1) {
                        if (cov >= 255) { f.*.px.data[db + rx] = c; }
                        else { f.*.px.data[db + rx] = mix(c, f.*.px.data[db + rx], cov + 1); }
                    }
                }
                col = col + 1;
            }
        }
        row = row + 1;
    }
    return adv;
}

fn draw_text_face(f: *FB, x: i32, y: i32, face: i32, s: []u8, c: i64) void {
    let pen: i32 = x;
    let i: i32 = 0;
    while (i < s.len) {
        pen = pen + draw_glyph(f, pen, y, face, s[i] as i32, c);
        i = i + 1;
    }
}

fn text_wf(face: i32, s: []u8) i32 {
    let w: i32 = 0;
    let i: i32 = 0;
    while (i < s.len) {
        w = w + fa_adv(face, s[i] as i32);
        i = i + 1;
    }
    return w;
}

// Vertical offset that centers a face's line box in a row of height `h`.
fn text_cy(face: i32, h: i32) i32 {
    let o: i32 = (h - fa_line_h(face)) / 2;
    if (o < 0 - 2) { o = 0 - 2; }
    return o;
}

// Compatibility wrappers: the pre-atlas API drew the default face.
fn draw_text(f: *FB, x: i32, y: i32, s: []u8, c: i64) void {
    draw_text_face(f, x, y, face_body(), s, c);
}

fn text_w(s: []u8) i32 {
    return text_wf(face_body(), s);
}

// Draw at most `maxw` pixels of text; overflow ends in an ellipsis so
// truncation is visible and text never touches a border it shouldn't.
fn draw_text_face_max(f: *FB, x: i32, y: i32, face: i32, s: []u8, c: i64, maxw: i32) void {
    if (maxw <= 0) { return; }
    if (text_wf(face, s) <= maxw) {
        draw_text_face(f, x, y, face, s, c);
        return;
    }
    let dot: i32 = fa_adv(face, '.' as i32);
    let pen: i32 = x;
    let lim: i32 = x + maxw - dot * 2;
    let i: i32 = 0;
    while (i < s.len) {
        let ch: i32 = s[i] as i32;
        if (pen + fa_adv(face, ch) > lim) {
            pen = pen + draw_glyph(f, pen, y, face, '.' as i32, c);
            pen = pen + draw_glyph(f, pen, y, face, '.' as i32, c);
            return;
        }
        pen = pen + draw_glyph(f, pen, y, face, ch, c);
        i = i + 1;
    }
}

fn draw_text_max(f: *FB, x: i32, y: i32, s: []u8, c: i64, maxw: i32) void {
    draw_text_face_max(f, x, y, face_body(), s, c, maxw);
}

// draw integer as text; returns width drawn
fn draw_int_face(f: *FB, x: i32, y: i32, face: i32, v: i64, c: i64) i32 {
    let s: []u8 = _zag_i64_to_str(v);
    draw_text_face(f, x, y, face, s, c);
    let w: i32 = text_wf(face, s);
    _zag_str_free(s);
    return w;
}

fn draw_int(f: *FB, x: i32, y: i32, v: i64, c: i64) i32 {
    return draw_int_face(f, x, y, face_body(), v, c);
}

// ── output ───────────────────────────────────────────────────────────────────

// Raw dump for the display shim: pw*ph i64 (low 4 bytes = 0RGB), tight.
fn fb_write_shm(f: *FB, path: []u8) void {
    let pw: i32 = fb_pw(f);
    let ph: i32 = fb_ph(f);
    let raw: *i8 = f.*.px.data as *i8;
    let bytes: []u8 = raw[0..pw * ph * 8];
    let rc: i32 = _zag_write_file(path, bytes);
    if (rc != 0) { _zag_eprintln("fb: /dev/shm write failed"); }
}

// Binary PPM dump: deliberately dependency-free and independent of X11.
fn fb_write_ppm(f: *FB, path: []u8) void {
    let pw: i32 = fb_pw(f);
    let ph: i32 = fb_ph(f);
    let npix: i32 = pw * ph;
    let pw_s: []u8 = _zag_i64_to_str(pw as i64);
    let ph_s: []u8 = _zag_i64_to_str(ph as i64);
    let header: []u8 = s5("P6\n", pw_s, " ", ph_s, "\n255\n");
    _zag_str_free(pw_s);
    _zag_str_free(ph_s);
    let out: list.ArrayList[u8] = list.make[u8](header.len + npix * 3);
    let hi: i32 = 0;
    while (hi < header.len) { push_u8(&out, header[hi]); hi = hi + 1; }
    let i: i32 = 0;
    while (i < npix) {
        let c: i64 = f.*.px.data[i];
        push_u8(&out, col_r(c) as u8);
        push_u8(&out, col_g(c) as u8);
        push_u8(&out, col_b(c) as u8);
        i = i + 1;
    }
    _zag_str_free(header);
    let rc: i32 = _zag_write_file(path, out.data[0..out.len]);
    if (rc != 0) { _zag_eprintln("fb: ppm write failed"); }
    list.free[u8](&out);
}

fn fb_test_pattern(f: *FB) void {
    fb_clip_reset(f);
    fill_rect(f, 0, 0, f.*.w, f.*.h, rgb(12, 12, 16));
    let x: i32 = 0;
    while (x < f.*.w) {
        if (x % 32 == 0) { vline(f, x, 0, f.*.h, rgb(48, 48, 56)); }
        x = x + 1;
    }
    let y: i32 = 0;
    while (y < f.*.h) {
        if (y % 32 == 0) { hline(f, 0, y, f.*.w, rgb(48, 48, 56)); }
        y = y + 1;
    }
    fill_rect(f, 8, 8, 64, 64, rgb(255, 0, 0));
    fill_rect(f, f.*.w - 72, 8, 64, 64, rgb(0, 255, 0));
    fill_rect(f, 8, f.*.h - 72, 64, 64, rgb(0, 0, 255));
    fill_rect(f, f.*.w - 72, f.*.h - 72, 64, 64, rgb(255, 255, 255));
    hline(f, 0, f.*.h / 2, f.*.w, rgb(255, 255, 0));
    vline(f, f.*.w / 2, 0, f.*.h, rgb(255, 255, 0));
    rect_outline(f, 0, 0, f.*.w, f.*.h, rgb(255, 0, 255));
}

// BMP screenshot (24-bit, bottom-up) for smoke verification. Writes the
// physical-resolution pixel buffer.
fn fb_write_bmp(f: *FB, path: []u8) void {
    let w: i32 = fb_pw(f);
    let h: i32 = fb_ph(f);
    let row_bytes: i32 = w * 3;
    let pad: i32 = (4 - (row_bytes % 4)) % 4;
    let data_size: i32 = (row_bytes + pad) * h;
    let file_size: i32 = 54 + data_size;

    let out: list.ArrayList[u8] = list.make[u8](file_size);
    push_u8(&out, 66);  // 'B'
    push_u8(&out, 77);  // 'M'
    push_u32le(&out, file_size);
    push_u32le(&out, 0);
    push_u32le(&out, 54);
    push_u32le(&out, 40);
    push_u32le(&out, w);
    push_u32le(&out, h);
    push_u16le(&out, 1);
    push_u16le(&out, 24);
    push_u32le(&out, 0);
    push_u32le(&out, data_size);
    push_u32le(&out, 2835);
    push_u32le(&out, 2835);
    push_u32le(&out, 0);
    push_u32le(&out, 0);

    let y: i32 = h - 1;
    while (y >= 0) {
        let x: i32 = 0;
        while (x < w) {
            let c: i64 = f.*.px.data[y * w + x];
            push_u8(&out, col_b(c) as u8);
            push_u8(&out, col_g(c) as u8);
            push_u8(&out, col_r(c) as u8);
            x = x + 1;
        }
        let p: i32 = 0;
        while (p < pad) {
            push_u8(&out, 0);
            p = p + 1;
        }
        y = y - 1;
    }
    let bytes: []u8 = out.data[0..out.len];
    let rc: i32 = _zag_write_file(path, bytes);
    if (rc != 0) { _zag_eprintln("fb: bmp write failed"); }
    list.free[u8](&out);
}

fn push_u8(out: *list.ArrayList[u8], v: u8) void {
    list.push[u8](out, v);
}

fn push_u16le(out: *list.ArrayList[u8], v: i32) void {
    push_u8(out, (v & 255) as u8);
    push_u8(out, ((v >> 8) & 255) as u8);
}

fn push_u32le(out: *list.ArrayList[u8], v: i32) void {
    push_u8(out, (v & 255) as u8);
    push_u8(out, ((v >> 8) & 255) as u8);
    push_u8(out, ((v >> 16) & 255) as u8);
    push_u8(out, ((v >> 24) & 255) as u8);
}
