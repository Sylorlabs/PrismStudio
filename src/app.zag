// app.zag — application core: state, zones, tools, input, and the command
// dispatch behind the menu bar and shortcuts.
// Four-zone workspace: toolbar (left), 3D viewport (center), outliner
// (right), signal debugger (bottom), menu bar on top, status bar underneath.

@import("../std/list.zag") as list
@import("fb.zag")
@import("math3d.zag")
@import("ui.zag")
@import("voxel.zag")
@import("components.zag")
@import("process_stack.zag")
@import("scene.zag")
@import("routing.zag")
@import("sim.zag")
@import("ternary.zag")
@import("viewport.zag")
@import("tiles.zag")
@import("editops.zag")
@import("optimizer.zag")
@import("builder.zag")
@import("uilayer.zag")
@import("flash_ir.zag")
@import("strutil.zag")

// tools
fn tool_select() i32 { return 0; }
fn tool_route() i32 { return 1; }
fn tool_place_base() i32 { return 2; }   // tool = 2 + kind_index
fn tool_measure() i32 { return 0 - 2; }  // negative: never mistaken for a place tool

// key codes from the X11 layer
fn key_esc() i32 { return 27; }
fn key_del() i32 { return 127; }
fn key_space() i32 { return 32; }
fn key_enter() i32 { return 13; }
fn key_backspace() i32 { return 8; }
fn key_home() i32 { return 21; }

// modal ids
fn modal_none() i32 { return 0; }
fn modal_open() i32 { return 1; }
fn modal_saveas() i32 { return 2; }
fn modal_keys() i32 { return 3; }
fn modal_recovery() i32 { return 4; }
fn modal_permission() i32 { return 5; }

fn access_ready() i32 { return 0; }
fn access_loading() i32 { return 1; }
fn access_disconnected() i32 { return 2; }
fn access_read_only() i32 { return 3; }

struct App {
    f: FB,
    scene: *Scene,
    sim: *Sim,
    cam: Cam,
    inp: Input,
    jrn: Journal,
    // zone splits
    left_w: i32,
    right_w: i32,
    bottom_h: i32,
    grab: i32,
    bottom_collapsed: bool,  // timeline/debugger collapsed to a thin bar
    // tools + selection
    tool: i32,
    ghost_rot: i32,
    sel: list.ArrayList[i32],   // selected component ids (last = primary)
    sel_guide: i32,
    route_c: i32,
    route_p: i32,
    hover_pc: i32,
    hover_pp: i32,
    // ghost preview (place tool)
    ghost_ok: i32,
    ghost_origin: Vox,
    // move mode (G)
    moving: bool,
    move_anchor: Vox,
    move_delta: Vox,
    move_ok: i32,
    // status-bar cursor readout
    hover_ok: bool,
    hover_cell: Vox,
    // document
    file_: []u8,
    dirty: bool,
    title_dirty: bool,
    quit: bool,
    // menus + modals
    menu: i32,          // -1 closed / 0 File / 1 Edit / 2 View / 3 Help
    modal: i32,
    modal_text: list.ArrayList[u8],
    modal_files: list.ArrayList[[]u8],
    modal_scroll: i32,
    access_state: i32,
    access_message: []u8,
    permission_decision: i32, // -1 kept read-only, 0 pending/none, 1 allowed once
    // outliner
    expand: list.ArrayList[i32],
    out_scroll: i32,
    // debugger
    speed_drag: i32,
    // console log ring
    log: list.ArrayList[[]u8],
    // frame stats
    frame: i64,
    frame_ms: i64,
    session_rev: i64,
    session_save_ms: i64,
    session_sync_now: bool,
    request_idempotency: []u8,
    request_expected_rev: i64,
    request_enveloped: bool,
    request_command: []u8,
    request_required: i64,
    cam_drag: bool,
    fly_speed: f64,
    pmx: i32,
    pmy: i32,
    tile_cache: TileCache,
    opt: *OptEngine,        // background optical-computation optimizer (Section 20)
    opt_open: bool,         // Optimizer proposal panel open
    opt_details: bool,      // proposal details expanded
    opt_previewed: bool,    // manual Apply is locked until the diff was viewed
    build: *BuildEngine,    // background engine builder (Section 22)
    build_open: bool,       // Builder panel open
    build_details: bool,    // builder details expanded
    settings_open: bool,    // Settings panel open
    palette_open: bool,     // command palette open
    palette_text: list.ArrayList[u8],
    palette_sel: i32,       // highlighted row in the filtered command list
    palette_scratch: list.ArrayList[[]u8],  // heap-owned dynamic palette labels; freed+rebuilt by palette_filtered each call
    frame_scratch: list.ArrayList[[]u8],    // heap strings with single-frame lifetime (UI catalog labels); freed at next frame build
    flash_open: bool,       // Flash FIR import/source/operation inspector
    model_open: bool,       // versioned physical-model and provenance browser
    model_param_sel: i32,
    flash_path: TextEdit,
    flash_raw: []u8,
    flash_tags: list.ArrayList[[]u8],
    flash_ops: list.ArrayList[i32],
    flash_expected: list.ArrayList[i32],
    flash_verify_errors: i32,
    box_sel: bool,          // dragging a rubber-band selection box
    box_x0: i32,
    box_y0: i32,
    clipboard: list.ArrayList[Comp],   // copied component snapshots (copy/paste)
    hover_comp: i32,                    // component under the cursor in select mode
    ui_scale: i32,                      // HiDPI factor (1/2/3): logical px -> physical
    // ── library panel (Section 3.7) ──
    lib_search: TextEdit,
    lib_tab: i32,              // 0 All, then library_tab_count()-1 categories
    lib_scroll: i32,
    lib_drag: i32,             // kind index dragged out of a card; -1 none
    // ── outliner (Section 3.9) ──
    out_search: TextEdit,
    rename_id: i32,            // comp id being renamed inline; -1 none
    rename_edit: TextEdit,
    locked: list.ArrayList[i32],       // locked component ids (uneditable)
    groups: list.ArrayList[i32],       // pairs: comp_id, group_id
    group_next: i32,
    out_drag_id: i32,          // outliner row being dragged; -1 none
    // ── context menu (Section 3.6) ──
    ctx_open: bool,
    ctx_x: i32,
    ctx_y: i32,
    ctx_comp: i32,             // right-clicked comp id; -1 for empty space
    rmb_x: i32,                // RMB press position (click vs orbit-drag)
    rmb_y: i32,
    rmb_live: bool,
    // ── inspector (Section 3.8) ──
    insp_open_t: i32,          // Transform section expanded
    insp_open_e: i32,          // Engine section expanded
    insp_open_m: i32,          // Model section expanded
    insp_open_p: i32,          // Ports section expanded
    insp_edit_field: i32,      // numeric field being typed; -1 none
    insp_edit: TextEdit,
    insp_err: []u8,            // inline validation error text
    insp_err_frame: i64,
    // ── signal timeline (Section 3.10) ──
    tl_zoom: i32,              // px per symbol (2..14)
    tl_scrub: i32,             // history offset; 0 = live edge
    tl_scroll: i32,
    tl_pin: list.ArrayList[i32],
    tl_hide: list.ArrayList[i32],
    tl_drag: i32,              // 1 while scrubbing
    tl_show_hidden: bool,
    // ── measure tool (Section 3.4) ──
    measure_n: i32,            // placed measure points (0/1/2)
    measure_a: Vox,
    measure_b: Vox,
    // ── design warnings (Section 3.4) ──
    warn_ids: list.ArrayList[i32],     // component ids with active warnings
    warn_codes: list.ArrayList[i32],   // parallel warning codes
    warn_rev: i64,                     // scene revision at last rebuild
    warn_open: bool,                   // status-bar warnings popup
    // ── view extras (Section 3.5) ──
    sect_on: bool,             // section (clip) view
    sect_y: i32,               // clip level: hide cells above this y
    // ── polish (Section 3.11) ──
    sel_frame: i64,            // frame of last selection change (outline fade)
    invalid_frame: i64,        // frame of last rejected action (flash)
    invalid_text: []u8,
    // double-click tracking
    click_frame: i64,
    click_x: i32,
    click_y: i32,
    // object/alignment snapping (Section 3.4)
    snap_obj: bool,
    snap_ax: i32,              // aligned x lattice line while placing (-1000000 none)
    snap_az: i32,
    // retained panel surfaces (Section 3.12)
    ps_left: PanelSurface,
    ps_right: PanelSurface,
    ps_bottom: PanelSurface,
    anim_live_prev: bool,      // an ease was mid-flight last frame
    log_rev: i64,              // bumps on every app_log append
    pulse_frame: i64,          // frame of the last sim step (beam pulse, 3.11)
    // dirty-region presentation: the union of screen rectangles that changed
    // this frame. present_full forces a whole-frame upload; present_none skips
    // the upload entirely (nothing visibly changed). Consumed by the X11 loop.
    present_x0: i32,
    present_y0: i32,
    present_x1: i32,
    present_y1: i32,
    present_full: bool,
    present_none: bool,
    pl_draws_prev: i64,
    pr_draws_prev: i64,
    pb_draws_prev: i64,
    present_sym_prev: i64,     // sim symbol at last present-decision
    present_rev_prev: i64,     // scene render_rev at last present-decision
}

fn layout_left_min(w: i32) i32 { return clampi(w / 5, 64, 170); }
fn layout_right_min(w: i32) i32 { return clampi(w / 4, 80, 220); }
fn layout_bottom_min(h: i32) i32 { return clampi(h / 4, 60, 130); }

// Keep all panels and a useful center viewport inside the current logical
// framebuffer. This is run on every frame because an X11 resize can make a
// previously valid desktop layout invalid without touching a splitter.
fn app_layout_constrain(a: *App) void {
    a.*.left_w = clampi(a.*.left_w, layout_left_min(a.*.inp.w), a.*.inp.w / 4);
    a.*.right_w = clampi(a.*.right_w, layout_right_min(a.*.inp.w), a.*.inp.w / 3);
    a.*.bottom_h = clampi(a.*.bottom_h, layout_bottom_min(a.*.inp.h), (a.*.inp.h * 2) / 5);
}

fn app_new(w: i32, h: i32) *App {
    let default_left: i32 = clampi(w / 5, layout_left_min(w), 224);
    let default_right: i32 = clampi(w / 4, layout_right_min(w), 306);
    let default_bottom: i32 = clampi(h / 4, layout_bottom_min(h), 236);
    let a: *App = new(App{
        .f = fb_new(w, h),
        .scene = scene_new(),
        .sim = sim_new(),
        .cam = cam_new(),
        .inp = input_new(),
        .jrn = journal_new(),
        .left_w = default_left,
        .right_w = default_right,
        .bottom_h = default_bottom,
        .grab = 0,
        .bottom_collapsed = false,
        .tool = 0,
        .ghost_rot = 0,
        .sel = list.make[i32](8),
        .sel_guide = 0 - 1,
        .route_c = 0 - 1,
        .route_p = 0,
        .hover_pc = 0 - 1,
        .hover_pp = 0,
        .ghost_ok = 0 - 1,
        .ghost_origin = vox(0, 0, 0),
        .moving = false,
        .move_anchor = vox(0, 0, 0),
        .move_delta = vox(0, 0, 0),
        .move_ok = 0,
        .hover_ok = false,
        .hover_cell = vox(0, 0, 0),
        .file_ = _zag_strdup("untitled.zpa"),   // always heap-owned: free before reassign
        .dirty = false,
        .title_dirty = true,
        .quit = false,
        .menu = 0 - 1,
        .modal = 0,
        .modal_text = list.make[u8](32),
        .modal_files = list.make[[]u8](8),
        .modal_scroll = 0,
        .access_state = access_ready(),
        .access_message = "",
        .permission_decision = 0,
        .expand = list.make[i32](8),
        .out_scroll = 0,
        .speed_drag = 0,
        .log = list.make[[]u8](8),
        .frame = 0,
        .frame_ms = 0,
        .session_rev = 0,
        .session_save_ms = 0,
        .session_sync_now = false,
        .request_idempotency = "",
        .request_expected_rev = 0 - 1,
        .request_enveloped = false,
        .request_command = "",
        .request_required = 0,
        .cam_drag = false,
        .fly_speed = 18.0,
        .pmx = 0,
        .pmy = 0,
        .tile_cache = tiles_cache_new(),
        .opt = opt_engine_new(),
        .opt_open = false,
        .opt_details = false,
        .opt_previewed = false,
        .build = build_engine_new(),
        .build_open = false,
        .build_details = false,
        .settings_open = false,
        .palette_open = false,
        .palette_text = list.make[u8](32),
        .palette_sel = 0,
        .palette_scratch = list.make[[]u8](8),
        .frame_scratch = list.make[[]u8](8),
        .flash_open = false,
        .model_open = false,
        .model_param_sel = 0,
        .flash_path = textedit_new(),
        .flash_raw = _zag_strdup(""),            // always heap-owned: free before reassign
        .flash_tags = list.make[[]u8](16),
        .flash_ops = list.make[i32](16),
        .flash_expected = list.make[i32](16),
        .flash_verify_errors = 0 - 1,
        .box_sel = false,
        .box_x0 = 0,
        .box_y0 = 0,
        .clipboard = list.make[Comp](8),
        .hover_comp = 0 - 1,
        .ui_scale = 1,
        .lib_search = textedit_new(),
        .lib_tab = 0,
        .lib_scroll = 0,
        .lib_drag = 0 - 1,
        .out_search = textedit_new(),
        .rename_id = 0 - 1,
        .rename_edit = textedit_new(),
        .locked = list.make[i32](8),
        .groups = list.make[i32](8),
        .group_next = 1,
        .out_drag_id = 0 - 1,
        .ctx_open = false,
        .ctx_x = 0,
        .ctx_y = 0,
        .ctx_comp = 0 - 1,
        .rmb_x = 0,
        .rmb_y = 0,
        .rmb_live = false,
        .insp_open_t = 1,
        .insp_open_e = 1,
        .insp_open_m = 1,
        .insp_open_p = 1,
        .insp_edit_field = 0 - 1,
        .insp_edit = textedit_new(),
        // insp_err is always heap-owned (see insp_err_set/clear); a literal
        // here would be freed later and corrupt the allocator.
        .insp_err = _zag_strdup(""),
        .insp_err_frame = 0 - 1000,
        .tl_zoom = 7,
        .tl_scrub = 0,
        .tl_scroll = 0,
        .tl_pin = list.make[i32](4),
        .tl_hide = list.make[i32](4),
        .tl_drag = 0,
        .tl_show_hidden = false,
        .measure_n = 0,
        .measure_a = vox(0, 0, 0),
        .measure_b = vox(0, 0, 0),
        .warn_ids = list.make[i32](8),
        .warn_codes = list.make[i32](8),
        .warn_rev = 0 - 1,
        .warn_open = false,
        .sect_on = false,
        .sect_y = 4,
        .sel_frame = 0 - 1000,
        .invalid_frame = 0 - 1000,
        .invalid_text = _zag_strdup(""),         // always heap-owned: free before reassign
        .click_frame = 0 - 1000,
        .click_x = 0,
        .click_y = 0,
        .snap_obj = true,
        .snap_ax = 0 - 1000000,
        .snap_az = 0 - 1000000,
        .ps_left = ps_new(),
        .ps_right = ps_new(),
        .ps_bottom = ps_new(),
        .anim_live_prev = true,
        .log_rev = 0,
        .pulse_frame = 0 - 1000,
        .present_x0 = 0,
        .present_y0 = 0,
        .present_x1 = 0,
        .present_y1 = 0,
        .present_full = true,
        .present_none = false,
        .pl_draws_prev = 0,
        .pr_draws_prev = 0,
        .pb_draws_prev = 0,
        .present_sym_prev = 0 - 1,
        .present_rev_prev = 0 - 1,
    });
    a.*.inp.w = w;
    a.*.inp.h = h;
    let i: i32 = 0;
    while (i < 6) {
        list.push[i32](&a.*.expand, 1);
        i = i + 1;
    }
    textedit_set(&a.*.flash_path, "examples/flash_reference.fir");
    app_log(a, "ready");
    return a;
}

fn app_layout_path() []u8 {
    let env: []u8 = _zag_getenv("PRISMSTUDIO_LAYOUT");
    if (env.len > 0) { return env; }
    return ".prismstudio/layout.cfg";
}

fn app_layout_load(a: *App) void {
    let raw: []u8 = _zag_read_file(app_layout_path());
    // len == -1 is the open-failure sentinel (no buffer); len == 0 is a real,
    // owned 64 KiB buffer for an empty file. Free on every non-failure path.
    if (raw.len < 0) { return; }
    if (raw.len == 0) { _zag_str_free(raw); return; }
    let vals: list.ArrayList[i64] = list.make[i64](18);
    let pos: i32 = 0;
    while (pos < raw.len && vals.len < 18) {
        while (pos < raw.len && ((raw[pos] as i32) == 32 || (raw[pos] as i32) == 10)) { pos = pos + 1; }
        let st: i32 = pos;
        while (pos < raw.len && (raw[pos] as i32) != 32 && (raw[pos] as i32) != 10) { pos = pos + 1; }
        if (pos > st) { list.push[i64](&vals, _zag_str_to_i64(raw[st..pos])); }
    }
    if (vals.len >= 3) {
        // clamps keep the viewport visually dominant at any drag (Section 3.2)
        a.*.left_w = clampi(vals.data[0] as i32, layout_left_min(a.*.inp.w), a.*.inp.w / 4);
        a.*.right_w = clampi(vals.data[1] as i32, layout_right_min(a.*.inp.w), a.*.inp.w / 3);
        a.*.bottom_h = clampi(vals.data[2] as i32, layout_bottom_min(a.*.inp.h), (a.*.inp.h * 2) / 5);
    }
    // optional trailing preferences (older files stop at three values)
    if (vals.len >= 5) {
        a.*.inp.reduced_motion = vals.data[3] != 0;
        a.*.snap_obj = vals.data[4] != 0;
    }
    if (vals.len >= 6) { a.*.tl_zoom = clampi(vals.data[5] as i32, 2, 14); }
    if (vals.len >= 9) {
        a.*.opt.*.enabled = vals.data[6] != 0;
        a.*.opt.*.auto_apply = vals.data[7] != 0;
        a.*.opt.*.min_gain_pct = clampi(vals.data[8] as i32, 1, 100);
    }
    if (vals.len >= 11) {
        a.*.opt.*.family_dead_path = vals.data[9] != 0;
        a.*.opt.*.family_const_collapse = vals.data[10] != 0;
    }
    if (vals.len >= 14) {
        a.*.opt.*.cpu_budget_pct = clampi(vals.data[11] as i32, 1, 20);
        a.*.opt.*.quiet_start_hour = clampi(vals.data[12] as i32, 0, 23);
        a.*.opt.*.quiet_end_hour = clampi(vals.data[13] as i32, 0, 23);
    }
    if (vals.len >= 18) {
        a.*.opt.*.family_cse = vals.data[14] != 0;
        a.*.opt.*.family_factoring = vals.data[15] != 0;
        a.*.opt.*.family_route = vals.data[16] != 0;
        a.*.opt.*.family_placement = vals.data[17] != 0;
    }
    _zag_str_free(raw);
    list.free[i64](&vals);
}

// Autosave of panel/prefs state. This runs on the autosave loop for the whole
// session: it must allocate exactly one transient line and free it (the old
// 22-concat chain leaked every intermediate and every i64_to_str per save).
fn app_layout_save(a: *App) bool {
    let vals: list.ArrayList[i64] = list.make[i64](22);
    list.push[i64](&vals, a.*.left_w as i64);
    list.push[i64](&vals, a.*.right_w as i64);
    list.push[i64](&vals, a.*.bottom_h as i64);
    if (a.*.inp.reduced_motion) { list.push[i64](&vals, 1); } else { list.push[i64](&vals, 0); }
    if (a.*.snap_obj) { list.push[i64](&vals, 1); } else { list.push[i64](&vals, 0); }
    list.push[i64](&vals, a.*.tl_zoom as i64);
    if (a.*.opt.*.enabled) { list.push[i64](&vals, 1); } else { list.push[i64](&vals, 0); }
    if (a.*.opt.*.auto_apply) { list.push[i64](&vals, 1); } else { list.push[i64](&vals, 0); }
    list.push[i64](&vals, a.*.opt.*.min_gain_pct as i64);
    if (a.*.opt.*.family_dead_path) { list.push[i64](&vals, 1); } else { list.push[i64](&vals, 0); }
    if (a.*.opt.*.family_const_collapse) { list.push[i64](&vals, 1); } else { list.push[i64](&vals, 0); }
    list.push[i64](&vals, a.*.opt.*.cpu_budget_pct as i64);
    list.push[i64](&vals, a.*.opt.*.quiet_start_hour as i64);
    list.push[i64](&vals, a.*.opt.*.quiet_end_hour as i64);
    if (a.*.opt.*.family_cse) { list.push[i64](&vals, 1); } else { list.push[i64](&vals, 0); }
    if (a.*.opt.*.family_factoring) { list.push[i64](&vals, 1); } else { list.push[i64](&vals, 0); }
    if (a.*.opt.*.family_route) { list.push[i64](&vals, 1); } else { list.push[i64](&vals, 0); }
    if (a.*.opt.*.family_placement) { list.push[i64](&vals, 1); } else { list.push[i64](&vals, 0); }
    let line: []u8 = join_i64s_sp(&vals);
    list.free[i64](&vals);
    let body: []u8 = s2(line, "\n");
    _zag_str_free(line);
    let ok: bool = atomic_write_file(app_layout_path(), body);
    _zag_str_free(body);
    return ok;
}

// Status-log ring (last 5 messages).
// OWNERSHIP INVARIANT: every entry in a.*.log is heap-owned by the ring.
// app_log copies `msg` (callers keep ownership of whatever they built and must
// free it); eviction frees the dropped entry. Never push a raw concat result
// into a.*.log directly — that invariant has leaked before.
fn app_log(a: *App, msg: []u8) void {
    a.*.log_rev = a.*.log_rev + 1;
    if (a.*.log.len >= 5) {
        _zag_str_free(a.*.log.data[0]);
        let i: i32 = 0;
        while (i + 1 < a.*.log.len) {
            a.*.log.data[i] = a.*.log.data[i + 1];
            i = i + 1;
        }
        a.*.log.len = a.*.log.len - 1;
    }
    list.push[[]u8](&a.*.log, _zag_strdup(msg));
}

fn app_mark_dirty(a: *App) void {
    if (!a.*.dirty) {
        a.*.dirty = true;
        a.*.title_dirty = true;
    }
}

// Inspector inline-error ownership invariant: a.*.insp_err is ALWAYS
// heap-owned. Mutate it only through these two helpers; assigning a literal or
// a raw concat result directly either leaks or double-frees (both have shipped
// before). `msg` is borrowed (copied), so callers free their own temporaries.
fn insp_err_set(a: *App, msg: []u8) void {
    _zag_str_free(a.*.insp_err);
    a.*.insp_err = _zag_strdup(msg);
    a.*.insp_err_frame = a.*.frame;
}

fn insp_err_clear(a: *App) void {
    _zag_str_free(a.*.insp_err);
    a.*.insp_err = _zag_strdup("");
}

// Parks a heap string in the frame-lifetime registry and returns it. Strings
// registered into the UI catalog (ui_register) are read by automation AFTER
// the frame finishes drawing, so a dynamically built label must outlive its
// draw call: park it here and it is freed at the start of the next frame
// build. Registering an unparked built string is a use-after-free on the
// agent `ui list` path — this has shipped as a bug class before.
fn ui_park(a: *App, s: []u8) []u8 {
    list.push[[]u8](&a.*.frame_scratch, s);
    return s;
}

// ── selection ─────────────────────────────────────────────────────────────────

fn sel_clear(a: *App) void {
    if (a.*.sel.len > 0 || a.*.sel_guide >= 0) { a.*.sel_frame = a.*.frame; }
    a.*.sel.len = 0;
    a.*.sel_guide = 0 - 1;
}

fn sel_has(a: *App, id: i32) bool {
    let i: i32 = 0;
    while (i < a.*.sel.len) {
        if (list.get[i32](a.*.sel, i) == id) { return true; }
        i = i + 1;
    }
    return false;
}

fn sel_set(a: *App, id: i32) void {
    a.*.sel.len = 0;
    list.push[i32](&a.*.sel, id);
    a.*.sel_guide = 0 - 1;
    a.*.sel_frame = a.*.frame;
}

fn sel_toggle(a: *App, id: i32) void {
    let i: i32 = 0;
    while (i < a.*.sel.len) {
        if (list.get[i32](a.*.sel, i) == id) {
            // remove: shift left
            let k: i32 = i;
            while (k + 1 < a.*.sel.len) {
                a.*.sel.data[k] = a.*.sel.data[k + 1];
                k = k + 1;
            }
            a.*.sel.len = a.*.sel.len - 1;
            return;
        }
        i = i + 1;
    }
    list.push[i32](&a.*.sel, id);
    a.*.sel_guide = 0 - 1;
    a.*.sel_frame = a.*.frame;
}

fn sel_add(a: *App, id: i32) void {
    if (!sel_has(a, id)) {
        list.push[i32](&a.*.sel, id);
        a.*.sel_frame = a.*.frame;
    }
    a.*.sel_guide = 0 - 1;
}

fn sel_primary(a: *App) i32 {
    if (a.*.sel.len == 0) { return 0 - 1; }
    return list.get[i32](a.*.sel, a.*.sel.len - 1);
}

// Select every component whose projected center falls inside the screen-space
// box (x0,y0)-(x1,y1). `add` keeps the current selection; otherwise it replaces.
fn app_box_select(a: *App, x0: i32, y0: i32, x1: i32, y1: i32, add: bool) void {
    let vp: Rect = zone_center(a);
    if (!add) { sel_clear(a); }
    let lo_x: i32 = imin(x0, x1);
    let hi_x: i32 = imax(x0, x1);
    let lo_y: i32 = imin(y0, y1);
    let hi_y: i32 = imax(y0, y1);
    let i: i32 = 0;
    while (i < a.*.scene.*.comps.len) {
        let c: Comp = a.*.scene.*.comps.data[i];
        let e: Vox = comp_ext(c);
        let ctr: Vec3 = v3(
            (c.origin.x as f64) + (e.x as f64) * 0.5,
            (c.origin.y as f64) + (e.y as f64) * 0.5,
            (c.origin.z as f64) + (e.z as f64) * 0.5,
        );
        let p: P3 = vp_proj(a.*.cam, vp, ctr);
        if (p.ok && (p.x as i32) >= lo_x && (p.x as i32) <= hi_x &&
            (p.y as i32) >= lo_y && (p.y as i32) <= hi_y) {
            sel_add(a, c.id);
        }
        i = i + 1;
    }
}

// drop ids that no longer exist (after deletes/undo)
fn sel_prune(a: *App) void {
    let i: i32 = 0;
    while (i < a.*.sel.len) {
        if (scene_comp_index(a.*.scene, list.get[i32](a.*.sel, i)) < 0) {
            let k: i32 = i;
            while (k + 1 < a.*.sel.len) {
                a.*.sel.data[k] = a.*.sel.data[k + 1];
                k = k + 1;
            }
            a.*.sel.len = a.*.sel.len - 1;
        } else {
            i = i + 1;
        }
    }
    if (a.*.sel_guide >= 0) {
        if (scene_guide_index(a.*.scene, a.*.sel_guide) < 0) { a.*.sel_guide = 0 - 1; }
    }
}

// ── locks (Section 3.9) ───────────────────────────────────────────────────────

fn app_is_locked(a: *App, id: i32) bool {
    let i: i32 = 0;
    while (i < a.*.locked.len) {
        if (list.get[i32](a.*.locked, i) == id) { return true; }
        i = i + 1;
    }
    return false;
}

fn app_toggle_lock(a: *App, id: i32) void {
    let i: i32 = 0;
    while (i < a.*.locked.len) {
        if (list.get[i32](a.*.locked, i) == id) {
            let k: i32 = i;
            while (k + 1 < a.*.locked.len) {
                a.*.locked.data[k] = a.*.locked.data[k + 1];
                k = k + 1;
            }
            a.*.locked.len = a.*.locked.len - 1;
            return;
        }
        i = i + 1;
    }
    list.push[i32](&a.*.locked, id);
}

fn app_sel_any_locked(a: *App) bool {
    let i: i32 = 0;
    while (i < a.*.sel.len) {
        if (app_is_locked(a, list.get[i32](a.*.sel, i))) { return true; }
        i = i + 1;
    }
    return false;
}

// ── grouping (Section 3.6) ────────────────────────────────────────────────────
// Pairs (comp_id, group_id); selecting any member selects the whole group.

fn app_group_of(a: *App, id: i32) i32 {
    let i: i32 = 0;
    while (i + 1 < a.*.groups.len) {
        if (list.get[i32](a.*.groups, i) == id) { return list.get[i32](a.*.groups, i + 1); }
        i = i + 2;
    }
    return 0 - 1;
}

fn app_group_drop(a: *App, id: i32) void {
    let i: i32 = 0;
    while (i + 1 < a.*.groups.len) {
        if (list.get[i32](a.*.groups, i) == id) {
            let k: i32 = i;
            while (k + 2 < a.*.groups.len) {
                a.*.groups.data[k] = a.*.groups.data[k + 2];
                k = k + 1;
            }
            a.*.groups.len = a.*.groups.len - 2;
            return;
        }
        i = i + 2;
    }
}

// select every member of `gid` (used by group-aware clicks)
fn sel_add_group(a: *App, gid: i32) void {
    let i: i32 = 0;
    while (i + 1 < a.*.groups.len) {
        if (list.get[i32](a.*.groups, i + 1) == gid) {
            sel_add(a, list.get[i32](a.*.groups, i));
        }
        i = i + 2;
    }
}

fn app_group_selection(a: *App) void {
    if (a.*.sel.len < 2) {
        app_log(a, "group: select two or more parts first");
        return;
    }
    let gid: i32 = a.*.group_next;
    a.*.group_next = a.*.group_next + 1;
    let i: i32 = 0;
    while (i < a.*.sel.len) {
        let id: i32 = list.get[i32](a.*.sel, i);
        app_group_drop(a, id);
        list.push[i32](&a.*.groups, id);
        list.push[i32](&a.*.groups, gid);
        i = i + 1;
    }
        let __log_n: []u8 = _zag_i64_to_str(a.*.sel.len as i64);
        let __log_g: []u8 = s2(__log_n, " parts grouped");
        _zag_str_free(__log_n);
        app_log(a, __log_g);
        _zag_str_free(__log_g);
}

fn app_ungroup_selection(a: *App) void {
    let n: i32 = 0;
    let i: i32 = 0;
    while (i < a.*.sel.len) {
        let id: i32 = list.get[i32](a.*.sel, i);
        if (app_group_of(a, id) >= 0) { app_group_drop(a, id); n = n + 1; }
        i = i + 1;
    }
    if (n > 0) { app_log(a, "ungrouped"); }
}

// ── invalid-action feedback (Section 3.11) ───────────────────────────────────

// invalid_text is always heap-owned (see app_new init). Free the previous
// value before storing a strdup of the borrowed msg.
fn app_invalid(a: *App, msg: []u8) void {
    a.*.invalid_frame = a.*.frame;
    _zag_str_free(a.*.invalid_text);
    a.*.invalid_text = _zag_strdup(msg);
    app_log(a, msg);
}

// ── design warnings (Section 3.4) ────────────────────────────────────────────
// warning codes: 1 input port not driven, 2 output port unconnected

fn warn_text(code: i32) []u8 {
    if (code == 1) { return "input not driven"; }
    return "output unconnected";
}

// Rebuild the warnings list when the design changed. Only facts the engine
// knows are reported: port connectivity of active parts. Never fabricated.
fn app_warnings_rebuild(a: *App) void {
    if (a.*.warn_rev == a.*.scene.*.render_rev) { return; }
    a.*.warn_rev = a.*.scene.*.render_rev;
    a.*.warn_ids.len = 0;
    a.*.warn_codes.len = 0;
    let s: *Scene = a.*.scene;
    let i: i32 = 0;
    while (i < s.*.comps.len) {
        let c: Comp = s.*.comps.data[i];
        let np: i32 = kind_port_count(c.kind);
        let pi: i32 = 0;
        while (pi < np) {
            if (!scene_port_in_use(s, c.id, pi)) {
                let p: Port = kind_port(c.kind, pi);
                let code: i32 = 1;
                if (p.is_output) { code = 2; }
                list.push[i32](&a.*.warn_ids, c.id);
                list.push[i32](&a.*.warn_codes, code);
            }
            pi = pi + 1;
        }
        i = i + 1;
    }
}

fn app_comp_warning(a: *App, id: i32) i32 {
    let i: i32 = 0;
    while (i < a.*.warn_ids.len) {
        if (list.get[i32](a.*.warn_ids, i) == id) { return list.get[i32](a.*.warn_codes, i); }
        i = i + 1;
    }
    return 0;
}

// ── double-click tracking ─────────────────────────────────────────────────────

fn app_dblclick(a: *App) bool {
    let is2: bool = (a.*.frame - a.*.click_frame) < 18 &&
        iabs(a.*.inp.mx - a.*.click_x) <= 4 && iabs(a.*.inp.my - a.*.click_y) <= 4;
    a.*.click_frame = a.*.frame;
    a.*.click_x = a.*.inp.mx;
    a.*.click_y = a.*.inp.my;
    return is2;
}

// ── zone layout ───────────────────────────────────────────────────────────────

fn menu_h() i32 { return 30; }
fn status_h() i32 { return 26; }
fn rail_w() i32 { return 36; }  // tool rail width (icon strip)

fn zone_menu(a: *App) Rect {
    return rect(0, 0, a.*.inp.w, menu_h());
}

// Menu-bar Settings gear and Optimizer button, anchored to the right edge.
fn zone_settings_gear(a: *App) Rect {
    return rect(a.*.inp.w - 30, 0, 26, menu_h());
}

fn zone_opt_btn(a: *App) Rect {
    let g: Rect = zone_settings_gear(a);
    // Width derived from label: text_w("opt") = 3*6 = 18, plus pad_text()*2+2 = 10 → 28px.
    // The 4px gap to the settings gear is explicit rather than baked into the offset.
    let bw: i32 = 64;
    return rect(g.x - (bw + 4), g.y, bw, g.h);
}

// Builder button sits to the left of the Optimizer button, with the same
// 4px gap. Width derived from label "build" = 5*6 = 30 + pad = 40px.
fn zone_build_btn(a: *App) Rect {
    let o: Rect = zone_opt_btn(a);
    let bw: i32 = 52;
    return rect(o.x - (bw + 4), o.y, bw, o.h);
}

fn zone_status(a: *App) Rect {
    return rect(0, a.*.inp.h - status_h(), a.*.inp.w, status_h());
}

fn zone_bottom(a: *App) Rect {
    if (a.*.bottom_collapsed) { return rect(0, a.*.inp.h - status_h() - 20, a.*.inp.w, 20); }
    return rect(0, a.*.inp.h - status_h() - a.*.bottom_h, a.*.inp.w, a.*.bottom_h);
}

fn zone_rail(a: *App) Rect {
    return rect(0, menu_h(), rail_w(), a.*.inp.h - menu_h() - status_h());
}

fn zone_left(a: *App) Rect {
    return rect(rail_w(), menu_h(), a.*.left_w, a.*.inp.h - menu_h() - status_h() - a.*.bottom_h);
}

fn zone_right(a: *App) Rect {
    return rect(a.*.inp.w - a.*.right_w, menu_h(), a.*.right_w, a.*.inp.h - menu_h() - status_h() - a.*.bottom_h);
}

fn zone_center(a: *App) Rect {
    return rect(rail_w() + a.*.left_w, menu_h(), a.*.inp.w - rail_w() - a.*.left_w - a.*.right_w, a.*.inp.h - menu_h() - status_h() - a.*.bottom_h);
}

fn app_splitters(a: *App) void {
    let inp: *Input = &a.*.inp;
    let zl: Rect = zone_left(a);
    let zr: Rect = zone_right(a);
    let zb: Rect = zone_bottom(a);
    let grip: i32 = 5;
    let lh: Rect = rect(zl.w - grip, zl.y, grip * 2, zl.h);
    let rh: Rect = rect(zr.x - grip, zr.y, grip * 2, zr.h);
    let bh: Rect = rect(0, zb.y - grip, inp.*.w, grip * 2);

    if (a.*.grab == 0 && btn_pressed(inp, 0) && inp.*.capture == 0) {
        if (rect_has(lh, inp.*.mx, inp.*.my)) { a.*.grab = 1; }
        if (rect_has(rh, inp.*.mx, inp.*.my)) { a.*.grab = 2; }
        if (rect_has(bh, inp.*.mx, inp.*.my)) { a.*.grab = 3; }
    }
    if (!btn_down(inp, 0)) {
        if (a.*.grab != 0) { let _saved_layout: bool = app_layout_save(a); }
        a.*.grab = 0;
    }
    // clamps keep the viewport visually dominant at any drag (Section 3.2)
    if (a.*.grab == 1) { a.*.left_w = clampi(inp.*.mx - rail_w(), layout_left_min(inp.*.w), inp.*.w / 4); }
    if (a.*.grab == 2) { a.*.right_w = clampi(inp.*.w - inp.*.mx, layout_right_min(inp.*.w), inp.*.w / 3); }
    if (a.*.grab == 3) { a.*.bottom_h = clampi(inp.*.h - inp.*.my - status_h(), layout_bottom_min(inp.*.h), (inp.*.h * 2) / 5); }
    if (a.*.grab != 0) { inp.*.capture = 1; }
}

// ── camera framing ────────────────────────────────────────────────────────────

fn app_frame_all(a: *App) void {
    let s: *Scene = a.*.scene;
    if (s.*.comps.len == 0) {
        a.*.cam.target = v3(24.0, 1.0, 24.0);
        a.*.cam.dist = 44.0;
        return;
    }
    let mnx: f64 = 100000.0;
    let mny: f64 = 100000.0;
    let mnz: f64 = 100000.0;
    let mxx: f64 = 0.0 - 100000.0;
    let mxy: f64 = 0.0 - 100000.0;
    let mxz: f64 = 0.0 - 100000.0;
    let i: i32 = 0;
    while (i < s.*.comps.len) {
        let c: Comp = s.*.comps.data[i];
        let lo: Vec3 = comp_bounds_min(c);
        let hi: Vec3 = comp_bounds_max(c);
        mnx = fmin(mnx, lo.x);
        mny = fmin(mny, lo.y);
        mnz = fmin(mnz, lo.z);
        mxx = fmax(mxx, hi.x);
        mxy = fmax(mxy, hi.y);
        mxz = fmax(mxz, hi.z);
        i = i + 1;
    }
    a.*.cam.target = v3((mnx + mxx) * 0.5, (mny + mxy) * 0.5, (mnz + mxz) * 0.5);
    let span: f64 = fmax(mxx - mnx, fmax(mxy - mny, mxz - mnz));
    // Fit is a working view, not a distant overview.  The old 1.35 factor
    // left sparse photonic layouts as tiny islands in a largely empty grid.
    // 1.05 keeps the design legible while the navigation renderer switches to
    // a lightweight, still-readable LOD during active camera motion.
    a.*.cam.dist = clampf(span * 1.05 + 8.0, 10.0, 200.0);
}

// Reset view (Section 3.5): the exact default camera, including projection.
fn app_reset_view(a: *App) void {
    a.*.cam = cam_new();
    app_log(a, "view reset");
}

// Move the camera eye to an exact world coordinate while preserving its
// current look direction, projection, and orbit distance.
fn app_camera_teleport(a: *App, x: f64, y: f64, z: f64) void {
    cam_update(&a.*.cam, zone_center(a).h);
    let desired: Vec3 = v3(x, y, z);
    let delta: Vec3 = vsub(desired, a.*.cam.eye);
    a.*.cam.target = vadd(a.*.cam.target, delta);
    cam_update(&a.*.cam, zone_center(a).h);
    tiles_mark_all_dirty(&a.*.tile_cache);
    a.*.present_full = true;
    a.*.present_none = false;
    a.*.session_sync_now = true;
}

fn app_frame_selected(a: *App) void {
    let pid: i32 = sel_primary(a);
    if (pid < 0) {
        app_frame_all(a);
        return;
    }
    let ci: i32 = scene_comp_index(a.*.scene, pid);
    if (ci < 0) { return; }
    let c: Comp = a.*.scene.*.comps.data[ci];
    let e: Vox = comp_ext(c);
    a.*.cam.target = v3(
        (c.origin.x as f64) + (e.x as f64) * 0.5,
        (c.origin.y as f64) + (e.y as f64) * 0.5,
        (c.origin.z as f64) + (e.z as f64) * 0.5,
    );
    let span: i32 = imax(e.x, imax(e.y, e.z));
    a.*.cam.dist = 6.0 + (span as f64) * 2.2;
}

// ── editing commands (menu + shortcuts share these) ───────────────────────────

fn app_current_kind(a: *App) Kind {
    return kind_at(a.*.tool - tool_place_base());
}

fn app_cancel(a: *App) void {
    a.*.tool = tool_select();
    a.*.route_c = 0 - 1;
    a.*.ghost_ok = 0 - 1;
    a.*.moving = false;
    a.*.menu = 0 - 1;
    a.*.modal = modal_none();
}

fn app_delete_selection(a: *App) void {
    if (a.*.sel_guide >= 0) {
        op_del_guide(&a.*.jrn, a.*.scene, a.*.sel_guide);
        scene_remove_guide(a.*.scene, a.*.sel_guide);
        a.*.sel_guide = 0 - 1;
        app_mark_dirty(a);
        app_log(a, "waveguide removed");
        return;
    }
    if (app_sel_any_locked(a)) {
        app_invalid(a, "delete blocked: selection contains locked parts");
        return;
    }
    let n: i32 = a.*.sel.len;
    let i: i32 = 0;
    while (i < n) {
        let id: i32 = list.get[i32](a.*.sel, i);
        op_del_comp(&a.*.jrn, a.*.scene, id);
        scene_remove(a.*.scene, id);
        i = i + 1;
    }
    if (n > 0) {
        app_mark_dirty(a);
        if (n == 1) { app_log(a, "1 component removed"); }
        else { let __log_nr: []u8 = _zag_i64_to_str(n as i64);
        let __log_r: []u8 = s2(__log_nr, " components removed");
        _zag_str_free(__log_nr);
        app_log(a, __log_r);
        _zag_str_free(__log_r); }
    }
    sel_clear(a);
}

// Current output trit of the primary-selected active component (emitter/chamber/
// detector), or signal_unknown() when nothing live is selected. Drives the
// inspector's live beam-state readout.
fn sel_output_trit(a: *App) i32 {
    let pid: i32 = sel_primary(a);
    if (pid < 0) { return signal_unknown(); }
    let ci: i32 = scene_comp_index(a.*.scene, pid);
    if (ci < 0) { return signal_unknown(); }
    let k: Kind = a.*.scene.*.comps.data[ci].kind;
    if (k == Kind.Emitter || k == Kind.Chamber || k == Kind.Detector) {
        return sim_history(a.*.sim, pid, 0);
    }
    return signal_unknown();
}

// Copy the current component selection into the clipboard (snapshots only).
fn app_copy(a: *App) void {
    a.*.clipboard.len = 0;
    let i: i32 = 0;
    while (i < a.*.sel.len) {
        let ci: i32 = scene_comp_index(a.*.scene, list.get[i32](a.*.sel, i));
        if (ci >= 0) {
            let c: Comp = a.*.scene.*.comps.data[ci];
            c.name_ = "";
            list.push[Comp](&a.*.clipboard, c);
        }
        i = i + 1;
    }
    if (a.*.clipboard.len > 0) {
        let __log_nc: []u8 = _zag_i64_to_str(a.*.clipboard.len as i64);
        let __log_c: []u8 = s2(__log_nc, " copied");
        _zag_str_free(__log_nc);
        app_log(a, __log_c);
        _zag_str_free(__log_c);
    }
}

// Paste clipboard components at a fixed offset; each placeable copy is a journaled
// add and becomes the new selection. Copies that would collide are skipped.
fn app_paste(a: *App) void {
    if (a.*.clipboard.len == 0) { return; }
    let delta: Vox = vox(2, 0, 0);
    sel_clear(a);
    let placed: i32 = 0;
    let i: i32 = 0;
    while (i < a.*.clipboard.len) {
        let c: Comp = a.*.clipboard.data[i];
        let no: Vox = vox_add(c.origin, delta);
        let nid: i32 = scene_place(a.*.scene, c.kind, no, c.rot);
        if (nid > 0) {
            let ci: i32 = scene_comp_index(a.*.scene, nid);
            if (ci >= 0) {
                a.*.scene.*.comps.data[ci].wl_nm = c.wl_nm;
                a.*.scene.*.comps.data[ci].preset = c.preset;
                a.*.scene.*.comps.data[ci].logic_op = c.logic_op;
                a.*.scene.*.comps.data[ci].size = c.size;
                scene_mark_topo_comp(a.*.scene, nid);
            }
            op_add_comp(&a.*.jrn, a.*.scene, nid);
            sel_add(a, nid);
            // advance the clipboard so the next paste marches further along
            a.*.clipboard.data[i].origin = no;
            placed = placed + 1;
        }
        i = i + 1;
    }
    if (placed > 0) {
        app_mark_dirty(a);
        let __log_np: []u8 = _zag_i64_to_str(placed as i64);
        let __log_p: []u8 = s2(__log_np, " pasted");
        _zag_str_free(__log_np);
        app_log(a, __log_p);
        _zag_str_free(__log_p);
    } else {
        app_log(a, "paste: no room at the offset");
    }
}

fn app_undo(a: *App) void {
    if (journal_undo(&a.*.jrn, a.*.scene)) {
        sel_prune(a);
        sim_reset(a.*.sim, a.*.scene);
        app_frame_all(a);
        a.*.session_sync_now = true;
        app_log(a, "undo");
    }
}

fn app_redo(a: *App) void {
    if (journal_redo(&a.*.jrn, a.*.scene)) {
        sel_prune(a);
        sim_reset(a.*.sim, a.*.scene);
        app_frame_all(a);
        a.*.session_sync_now = true;
        app_log(a, "redo");
    }
}

fn app_duplicate(a: *App) void {
    let pid: i32 = sel_primary(a);
    if (pid < 0) { return; }
    let ci: i32 = scene_comp_index(a.*.scene, pid);
    if (ci < 0) { return; }
    let c: Comp = a.*.scene.*.comps.data[ci];
    a.*.tool = tool_place_base() + kind_index(c.kind);
    a.*.ghost_rot = c.rot;
    app_log(a, "duplicate: click to place the copy");
}

fn app_start_move(a: *App) void {
    if (a.*.sel.len == 0) { return; }
    if (app_sel_any_locked(a)) {
        app_invalid(a, "move blocked: selection contains locked parts");
        return;
    }
    a.*.moving = true;
    a.*.move_delta = vox(0, 0, 0);
    // anchor at the primary component's origin
    let ci: i32 = scene_comp_index(a.*.scene, sel_primary(a));
    if (ci >= 0) { a.*.move_anchor = a.*.scene.*.comps.data[ci].origin; }
}

fn app_commit_move(a: *App) void {
    if (!a.*.moving) { return; }
    let d: Vox = a.*.move_delta;
    if (d.x != 0 || d.z != 0) {
        if (group_can_move(a.*.scene, &a.*.sel, d) == 0) {
            let i: i32 = 0;
            while (i < a.*.sel.len) {
                op_move(&a.*.jrn, a.*.scene, list.get[i32](a.*.sel, i), d);
                i = i + 1;
            }
            group_move(a.*.scene, &a.*.sel, d);
            app_mark_dirty(a);
            app_log(a, "moved");
        } else {
            app_log(a, "move blocked: destination fails placement rules");
        }
    }
    a.*.moving = false;
}

fn app_new_design(a: *App) void {
    scene_clear(a.*.scene);
    journal_clear(&a.*.jrn);
    sel_clear(a);
    _zag_str_free(a.*.file_);
    a.*.file_ = _zag_strdup("untitled.zpa");
    a.*.dirty = true;
    a.*.title_dirty = true;
    a.*.session_sync_now = true;
    app_log(a, "new design");
}

fn app_save(a: *App) void {
    if (design_save(a.*.scene, a.*.file_)) {
        let bytes: []u8 = _zag_read_file(a.*.file_);
        let opt_path: []u8 = s2(a.*.file_, ".opt");
        let _campaign: bool = opt_campaign_save_full(a.*.opt,
            opt_path, design_bytes_hash(bytes));
        _zag_str_free(opt_path);
        a.*.dirty = false;
        a.*.title_dirty = true;
        let __log_s: []u8 = s2("saved ", a.*.file_);
        app_log(a, __log_s);
        _zag_str_free(__log_s);
    } else {
        app_log(a, "save failed");
    }
}

fn app_open_file(a: *App, path: []u8) void {
    if (design_load(a.*.scene, path)) {
        journal_clear(&a.*.jrn);
        sel_clear(a);
        _zag_str_free(a.*.file_);
        a.*.file_ = _zag_strdup(path);
        let bytes: []u8 = _zag_read_file(path);
        let opt_path: []u8 = s2(path, ".opt");
        let _campaign: bool = opt_campaign_load_full(a.*.opt,
            opt_path, design_bytes_hash(bytes), a.*.scene);
        _zag_str_free(opt_path);
        a.*.dirty = true;
        a.*.title_dirty = true;
        a.*.session_sync_now = true;
        app_frame_all(a);
            let __log_o2: []u8 = s2("opened ", path);
            app_log(a, __log_o2);
            _zag_str_free(__log_o2);
    } else {
        let __log_co: []u8 = s2("cannot open ", path);
        app_log(a, __log_co);
        _zag_str_free(__log_co);
    }
}

fn app_flash_import(a: *App, path: []u8) bool {
    let ir: FlashIr = flash_ir_load(path);
    if (!ir.valid) {
        a.*.flash_verify_errors = 0 - 1;
        app_invalid(a, "invalid or unsupported Flash FIR");
        let __log_f: []u8 = s2("cannot import Flash FIR ", path);
        app_log(a, __log_f);
        _zag_str_free(__log_f);
        list.free[FlashOp](&ir.ops);
        return false;
    }
    scene_clear(a.*.scene);
    if (!flash_build_scene(a.*.scene, &ir)) {
        app_invalid(a, "Flash FIR could not be placed or routed");
        list.free[FlashOp](&ir.ops);
        return false;
    }
    free_str_list(&a.*.flash_tags);
    a.*.flash_ops.len = 0; a.*.flash_expected.len = 0;
    let i: i32 = 0;
    while (i < ir.ops.len) {
        list.push[[]u8](&a.*.flash_tags, _zag_strdup(ir.ops.data[i].tag));
        list.push[i32](&a.*.flash_ops, ir.ops.data[i].lattice_op);
        list.push[i32](&a.*.flash_expected, ir.ops.data[i].expected);
        i = i + 1;
    }
    _zag_str_free(a.*.flash_raw);
    a.*.flash_raw = _zag_strdup(ir.raw);
    a.*.flash_verify_errors = flash_verify_scene(a.*.scene, a.*.sim);
    journal_clear(&a.*.jrn); sel_clear(a); app_frame_all(a);
    _zag_str_free(a.*.file_);
    a.*.file_ = _zag_strdup("untitled-flash.zpa");
    a.*.dirty = true; a.*.title_dirty = true; a.*.session_sync_now = true;
    let __log_i: []u8 = s2("imported Flash FIR ", path);
        app_log(a, __log_i);
        _zag_str_free(__log_i);
    list.free[FlashOp](&ir.ops);
    return true;
}

fn app_show_open(a: *App) void {
    a.*.modal = modal_open();
    a.*.modal_scroll = 0;
    list_designs(&a.*.modal_files);
}

fn app_show_saveas(a: *App) void {
    a.*.modal = modal_saveas();
    a.*.modal_text.len = 0;
    let cur: []u8 = a.*.file_;
    let i: i32 = 0;
    while (i < cur.len) {
        list.push[u8](&a.*.modal_text, cur[i]);
        i = i + 1;
    }
}

fn app_recovery_base() []u8 {
    let p: []u8 = _zag_getenv("PRISMSTUDIO_SESSION");
    if (p.len > 0) { return p; }
    return ".prismstudio/live.zpa";
}

// Owned recovery-snapshot path. Caller frees (app_show_recovery stores it in
// modal_files and list/free discipline applies there).
fn app_recovery_path(slot: i32) []u8 {
    let ns: []u8 = _zag_i64_to_str(slot as i64);
    let tail: []u8 = s2(ns, ".zpa");
    _zag_str_free(ns);
    let head: []u8 = s2(app_recovery_base(), ".recovery.");
    let r: []u8 = s2(head, tail);
    _zag_str_free(head);
    _zag_str_free(tail);
    return r;
}

fn app_show_recovery(a: *App) void {
    free_str_list(&a.*.modal_files);
    let i: i32 = 1;
    while (i <= 3) {
        let p: []u8 = app_recovery_path(i);
        if (_zag_file_exists(p) == 1) { list.push[[]u8](&a.*.modal_files, p); }
        else { _zag_str_free(p); }
        i = i + 1;
    }
    a.*.modal = modal_recovery();
    a.*.modal_scroll = 0;
}

fn app_recover_file(a: *App, path: []u8) bool {
    if (!design_load(a.*.scene, path)) {
        app_invalid(a, "recovery snapshot is corrupt");
        return false;
    }
    journal_clear(&a.*.jrn); sel_clear(a); sim_reset(a.*.sim, a.*.scene); app_frame_all(a);
    _zag_str_free(a.*.file_);
    a.*.file_ = _zag_strdup("recovered.zpa");
    a.*.dirty = true; a.*.title_dirty = true; a.*.session_sync_now = false;
    a.*.modal = modal_none();
    let __log_rec: []u8 = s2("recovered snapshot ", path);
        app_log(a, __log_rec);
        _zag_str_free(__log_rec);
    return true;
}

fn app_set_access_state(a: *App, state: i32, message: []u8) void {
    a.*.access_state = state;
    a.*.access_message = message;
    a.*.present_full = true;
}

fn app_request_write_access(a: *App) void {
    a.*.permission_decision = 0;
    a.*.modal = modal_permission();
}

fn app_permission_allow_once(a: *App) void {
    a.*.permission_decision = 1;
    app_set_access_state(a, access_ready(), "write access allowed for this session");
    a.*.modal = modal_none();
    app_log(a, "write permission allowed once");
}

fn app_permission_keep_read_only(a: *App) void {
    a.*.permission_decision = 0 - 1;
    app_set_access_state(a, access_read_only(), "inspect-only; edits remain blocked by host policy");
    a.*.modal = modal_none();
    app_log(a, "write permission denied; remaining read-only");
}

// ── viewport interaction ──────────────────────────────────────────────────────

// ── clickable orientation gizmo ───────────────────────────────────────────────
// Our own 6-way axis gizmo: it reflects the live camera orientation (balls are
// placed by the camera basis) and snaps the view to any axis on click.
fn gizmo_r() i32 { return 24; }
fn gizmo_cx(a: *App) i32 { let vp: Rect = zone_center(a); return vp.x + vp.w - 44; }
fn gizmo_cy(a: *App) i32 { let vp: Rect = zone_center(a); return vp.y + 44; }

fn gizmo_axis(i: i32) Vec3 {
    if (i == 0) { return v3(1.0, 0.0, 0.0); }
    if (i == 1) { return v3(0.0 - 1.0, 0.0, 0.0); }
    if (i == 2) { return v3(0.0, 1.0, 0.0); }
    if (i == 3) { return v3(0.0, 0.0 - 1.0, 0.0); }
    if (i == 4) { return v3(0.0, 0.0, 1.0); }
    return v3(0.0, 0.0, 0.0 - 1.0);
}

// Screen position (x,y) of axis ball i, with view depth carried in z (z<=0 faces
// the viewer). Uses the camera basis, so the gizmo rotates with the view.
fn gizmo_ball(a: *App, i: i32) P3 {
    let d: Vec3 = gizmo_axis(i);
    let sx: f64 = vdot(d, a.*.cam.right);
    let sy: f64 = vdot(d, a.*.cam.up);
    let sz: f64 = vdot(d, a.*.cam.fwd);
    return P3{
        .x = (gizmo_cx(a) as f64) + sx * (gizmo_r() as f64),
        .y = (gizmo_cy(a) as f64) - sy * (gizmo_r() as f64),
        .z = sz,
        .ok = true,
    };
}

// Axis ball under (mx,my), preferring the front-most; -1 if none.
fn gizmo_hit(a: *App, mx: i32, my: i32) i32 {
    let best: i32 = 0 - 1;
    let best_z: f64 = 1000.0;
    let i: i32 = 0;
    while (i < 6) {
        let b: P3 = gizmo_ball(a, i);
        let dx: f64 = (mx as f64) - b.x;
        let dy: f64 = (my as f64) - b.y;
        if (dx * dx + dy * dy <= 81.0) {   // 9 px hit radius
            if (b.z < best_z) { best_z = b.z; best = i; }
        }
        i = i + 1;
    }
    return best;
}

// Snap the camera to look along the chosen axis (pitch clamps handle up/down).
fn gizmo_apply(a: *App, i: i32) void {
    if (i == 0) { a.*.cam.yaw = 0.0; a.*.cam.pitch = 0.02; }
    if (i == 1) { a.*.cam.yaw = pi(); a.*.cam.pitch = 0.02; }
    if (i == 2) { a.*.cam.pitch = 1.52; }
    if (i == 3) { a.*.cam.pitch = 0.02; }
    if (i == 4) { a.*.cam.yaw = pi_half(); a.*.cam.pitch = 0.02; }
    if (i == 5) { a.*.cam.yaw = 0.0 - pi_half(); a.*.cam.pitch = 0.02; }
    app_log(a, "view aligned to axis");
}

fn app_viewport_input(a: *App, dt: f64) void {
    let inp: *Input = &a.*.inp;
    let vp: Rect = zone_center(a);
    let over: bool = rect_has(vp, inp.*.mx, inp.*.my) && inp.*.capture == 0;
    a.*.ghost_ok = 0 - 1;
    a.*.hover_pc = 0 - 1;
    a.*.hover_ok = false;
    a.*.snap_ax = 0 - 1000000;
    a.*.snap_az = 0 - 1000000;

    // RMB: a short press-and-release is a context menu; a drag orbits.
    if (over && btn_pressed(inp, 2)) {
        a.*.rmb_live = true;
        a.*.rmb_x = inp.*.mx;
        a.*.rmb_y = inp.*.my;
    }
    let rmb_moved: bool = iabs(inp.*.mx - a.*.rmb_x) > 4 || iabs(inp.*.my - a.*.rmb_y) > 4;
    if (a.*.rmb_live && btn_released(inp, 2) && !rmb_moved) {
        a.*.rmb_live = false;
        let hit: i32 = vp_pick_comp(a.*.scene, a.*.cam, vp, inp.*.mx, inp.*.my);
        if (hit >= 0 && !sel_has(a, hit)) { sel_set(a, hit); }
        a.*.ctx_open = true;
        a.*.ctx_comp = hit;
        a.*.ctx_x = inp.*.mx;
        a.*.ctx_y = inp.*.my;
        return;
    }
    if (!btn_down(inp, 2) && !btn_down(inp, 1)) { a.*.rmb_live = false; }

    // Camera navigation deliberately offers both CAD orbit and unconstrained
    // free-look. MMB orbits the current pivot; Shift+MMB pans it. RMB drag
    // keeps the eye fixed and turns the view, so navigation is not forced to
    // revolve around whatever happens to be centered. Wheel zoom is anchored
    // beneath the pointer instead of pulling everything toward screen center.
    if (over || inp.*.capture == 2) {
        let dragging: bool = btn_down(inp, 1) || (btn_down(inp, 2) && (rmb_moved || !a.*.rmb_live));
        a.*.cam_drag = dragging;
        if (dragging) {
            inp.*.capture = 2;
            let dx: f64 = (inp.*.mx - a.*.pmx) as f64;
            let dy: f64 = (inp.*.my - a.*.pmy) as f64;
            if (btn_down(inp, 1) && shift_down(inp)) {
                let s: f64 = a.*.cam.dist * 0.0016;
                let rgt: Vec3 = a.*.cam.right;
                let up: Vec3 = a.*.cam.up;
                let move_r: Vec3 = vscale(rgt, 0.0 - dx * s);
                let move_u: Vec3 = vscale(up, dy * s);
                let t0: Vec3 = vadd(a.*.cam.target, move_r);
                a.*.cam.target = vadd(t0, move_u);
            } else if (btn_down(inp, 2)) {
                // Free-look: rotate the view while preserving the eye. The
                // orbit representation stores a target, so rebuild that target
                // from the new orientation and the unchanged eye position.
                let eye0: Vec3 = a.*.cam.eye;
                a.*.cam.yaw = a.*.cam.yaw + dx * 0.008;
                a.*.cam.pitch = a.*.cam.pitch + dy * 0.006;
                a.*.cam.pitch = clampf(a.*.cam.pitch, 0.02, 1.52);
                let cp: f64 = cos(a.*.cam.pitch);
                let sp: f64 = sin(a.*.cam.pitch);
                let cy: f64 = cos(a.*.cam.yaw);
                let sy: f64 = sin(a.*.cam.yaw);
                let off: Vec3 = v3(cp * cy * a.*.cam.dist,
                                   sp * a.*.cam.dist,
                                   cp * sy * a.*.cam.dist);
                a.*.cam.target = vsub(eye0, off);
            } else {
                a.*.cam.yaw = a.*.cam.yaw + dx * 0.008;
                a.*.cam.pitch = a.*.cam.pitch + dy * 0.006;
            }
        } else if (inp.*.capture == 2) {
            inp.*.capture = 0;
            a.*.cam_drag = false;
        }
        if (over && inp.*.wheel != 0 && btn_down(inp, 2)) {
            let wn: i32 = inp.*.wheel;
            while (wn > 0) { a.*.fly_speed = a.*.fly_speed * 1.2; wn = wn - 1; }
            while (wn < 0) { a.*.fly_speed = a.*.fly_speed / 1.2; wn = wn + 1; }
            a.*.fly_speed = clampf(a.*.fly_speed, 1.0, 160.0);
        } else if (over && inp.*.wheel != 0) {
            let old_dist: f64 = a.*.cam.dist;
            let sx: f64 = (inp.*.mx - (vp.x + vp.w / 2)) as f64;
            let sy: f64 = (inp.*.my - (vp.y + vp.h / 2)) as f64;
            let wr: Vec3 = vscale(a.*.cam.right, sx * old_dist / a.*.cam.flen);
            let wu: Vec3 = vscale(a.*.cam.up, (0.0 - sy) * old_dist / a.*.cam.flen);
            let pointer_offset: Vec3 = vadd(wr, wu);
            let n: i32 = inp.*.wheel;
            while (n > 0) {
                a.*.cam.dist = a.*.cam.dist * 0.9;
                n = n - 1;
            }
            while (n < 0) {
                a.*.cam.dist = a.*.cam.dist * 1.111;
                n = n + 1;
            }
            a.*.cam.dist = clampf(a.*.cam.dist, 4.0, 220.0);
            let anchor_shift: f64 = 1.0 - a.*.cam.dist / old_dist;
            let shifted: Vec3 = vscale(pointer_offset, anchor_shift);
            a.*.cam.target = vadd(a.*.cam.target, shifted);
        }

        // RMB fly mode. Translation moves eye and target together, retaining
        // the free-look orientation established above. Editing shortcuts are
        // suppressed by app_keys while RMB is held.
        if (btn_down(inp, 2)) {
            let fly_keys: bool = key_down(inp, 'w' as i32) || key_down(inp, 'a' as i32) ||
                key_down(inp, 's' as i32) || key_down(inp, 'd' as i32) ||
                key_down(inp, 'q' as i32) || key_down(inp, 'e' as i32);
            if (fly_keys) {
                a.*.rmb_live = false; // movement cannot become a context click
                let speed: f64 = a.*.fly_speed;
                if (shift_down(inp)) { speed = speed * 3.0; }
                if (ctrl_down(inp)) { speed = speed * 0.25; }
                let step: f64 = speed * clampf(dt, 0.0, 0.1);
                let move: Vec3 = v3(0.0, 0.0, 0.0);
                if (key_down(inp, 'w' as i32)) { move = vadd(move, vscale(a.*.cam.fwd, step)); }
                if (key_down(inp, 's' as i32)) { move = vadd(move, vscale(a.*.cam.fwd, 0.0 - step)); }
                if (key_down(inp, 'a' as i32)) { move = vadd(move, vscale(a.*.cam.right, 0.0 - step)); }
                if (key_down(inp, 'd' as i32)) { move = vadd(move, vscale(a.*.cam.right, step)); }
                if (key_down(inp, 'q' as i32)) { move = vadd(move, v3(0.0, 0.0 - step, 0.0)); }
                if (key_down(inp, 'e' as i32)) { move = vadd(move, v3(0.0, step, 0.0)); }
                a.*.cam.target = vadd(a.*.cam.target, move);
                a.*.cam_drag = true;
            }
        }
    }
    cam_update(&a.*.cam, zone_center(a).h);

    if (!over || inp.*.capture == 2) { return; }

    // orientation gizmo intercepts clicks before component picking
    if (btn_pressed(inp, 0)) {
        let gh: i32 = gizmo_hit(a, inp.*.mx, inp.*.my);
        if (gh >= 0) { gizmo_apply(a, gh); return; }
    }

    // status-bar cursor cell (at the active working level)
    let lvl: i32 = 1;
    if (a.*.tool >= tool_place_base()) {
        if (kind_ground_only(app_current_kind(a))) { lvl = 0; }
    }
    let hov: CellHit = vp_cell_at(a.*.cam, vp, inp.*.mx, inp.*.my, lvl);
    if (hov.ok) {
        a.*.hover_ok = true;
        a.*.hover_cell = hov.cell;
    }

    // measure tool (Section 3.4): two picked lattice points
    if (a.*.tool == tool_measure()) {
        let mh0: CellHit = vp_cell_at(a.*.cam, vp, inp.*.mx, inp.*.my, 1);
        if (mh0.ok) {
            a.*.hover_ok = true;
            a.*.hover_cell = mh0.cell;
            if (btn_pressed(inp, 0)) {
                if (a.*.measure_n == 1) {
                    a.*.measure_b = mh0.cell;
                    a.*.measure_n = 2;
                } else {
                    a.*.measure_a = mh0.cell;
                    a.*.measure_n = 1;
                }
            }
        }
        return;
    }

    // move mode
    if (a.*.moving) {
        let mh: CellHit = vp_cell_at(a.*.cam, vp, inp.*.mx, inp.*.my, a.*.move_anchor.y);
        if (mh.ok) {
            a.*.move_delta = vox(mh.cell.x - a.*.move_anchor.x, 0, mh.cell.z - a.*.move_anchor.z);
            a.*.move_ok = group_can_move(a.*.scene, &a.*.sel, a.*.move_delta);
        }
        if (btn_pressed(inp, 0)) {
            if (a.*.move_ok != 0) { a.*.invalid_frame = a.*.frame; }
            app_commit_move(a);
        }
        return;
    }

    // place tools (armed from the library, keys, palette, or a card drag)
    if (a.*.tool >= tool_place_base() || a.*.lib_drag >= 0) {
        let k: Kind = kind_at(0);
        if (a.*.lib_drag >= 0) { k = kind_at(a.*.lib_drag); }
        else { k = app_current_kind(a); }
        let level: i32 = 1;
        if (kind_ground_only(k)) { level = 0; }
        let ch: CellHit = vp_cell_at(a.*.cam, vp, inp.*.mx, inp.*.my, level);
        if (ch.ok) {
            let e: Vox = rot_ext(kind_fp(k), a.*.ghost_rot);
            let origin: Vox = vox(ch.cell.x - e.x / 2, level, ch.cell.z - e.z / 2);
            // object-alignment snapping (Section 3.4): pull the ghost onto a
            // neighbor's lattice row/column when within one cell
            if (a.*.snap_obj) {
                let si: i32 = 0;
                while (si < a.*.scene.*.comps.len) {
                    let sc: Comp = a.*.scene.*.comps.data[si];
                    if (sc.kind == k) {
                        if (a.*.snap_ax == 0 - 1000000 && iabs(origin.x - sc.origin.x) == 1) {
                            origin.x = sc.origin.x;
                            a.*.snap_ax = sc.origin.x;
                        }
                        if (a.*.snap_az == 0 - 1000000 && iabs(origin.z - sc.origin.z) == 1) {
                            origin.z = sc.origin.z;
                            a.*.snap_az = sc.origin.z;
                        }
                    }
                    si = si + 1;
                }
            }
            a.*.ghost_origin = origin;
            a.*.ghost_ok = scene_can_place(a.*.scene, k, origin, a.*.ghost_rot);
            let commit: bool = btn_pressed(inp, 0);
            if (a.*.lib_drag >= 0) { commit = btn_released(inp, 0); }
            if (commit) {
                if (a.*.ghost_ok == 0) {
                    let id: i32 = scene_place(a.*.scene, k, origin, a.*.ghost_rot);
                    if (id > 0) {
                        op_add_comp(&a.*.jrn, a.*.scene, id);
                        sel_set(a, id);
                        app_mark_dirty(a);
                        let ci: i32 = scene_comp_index(a.*.scene, id);
                        let __log_pl: []u8 = s2("placed ", a.*.scene.*.comps.data[ci].name_);
        app_log(a, __log_pl);
        _zag_str_free(__log_pl);
                    }
                } else {
                    let place_msg: []u8 = s2("cannot place: ", place_err_text(a.*.ghost_ok));
                    app_invalid(a, place_msg);
                    _zag_str_free(place_msg);
                }
            }
        }
        if (a.*.lib_drag >= 0 && btn_released(inp, 0)) { a.*.lib_drag = 0 - 1; }
        return;
    }

    // route tool: click-click, or press an output and drag to an input
    if (a.*.tool == tool_route()) {
        let port: i32 = 0;
        let pc: i32 = vp_pick_port(a.*.scene, a.*.cam, vp, inp.*.mx, inp.*.my, &port);
        a.*.hover_pc = pc;
        a.*.hover_pp = port;
        // drag-to-route commit: release over a valid input while armed
        if (btn_released(inp, 0) && a.*.route_c >= 0 && pc >= 0 &&
            !(pc == a.*.route_c && port == a.*.route_p)) {
            let rci: i32 = scene_comp_index(a.*.scene, pc);
            let rcc: Comp = a.*.scene.*.comps.data[rci];
            let rp: Port = kind_port(rcc.kind, port);
            if (!rp.is_output && !scene_port_in_use(a.*.scene, pc, port) && pc != a.*.route_c) {
                let ssci: i32 = scene_comp_index(a.*.scene, a.*.route_c);
                let ssrc: Comp = a.*.scene.*.comps.data[ssci];
                let sstart: Vox = comp_port_attach(ssrc, a.*.route_p);
                let sgoal: Vox = comp_port_attach(rcc, port);
                let spath: list.ArrayList[Vox] = list.make[Vox](32);
                if (route_guide(a.*.scene, sstart, sgoal, &spath)) {
                    let sgid: i32 = scene_add_guide(a.*.scene, a.*.route_c, a.*.route_p, pc, port, spath);
                    op_add_guide(&a.*.jrn, a.*.scene, sgid);
                    a.*.sel_guide = sgid;
                    a.*.sel.len = 0;
                    app_mark_dirty(a);
                    app_log(a, "waveguide routed");
                } else {
                    list.free[Vox](&spath);
                    app_invalid(a, "route: no path through the lattice");
                }
                a.*.route_c = 0 - 1;
                return;
            }
        }
        if (btn_pressed(inp, 0) && pc >= 0) {
            let ci: i32 = scene_comp_index(a.*.scene, pc);
            let c: Comp = a.*.scene.*.comps.data[ci];
            let p: Port = kind_port(c.kind, port);
            if (a.*.route_c < 0) {
                if (!p.is_output) {
                    app_log(a, "route: start from an output port (amber)");
                } else if (scene_port_in_use(a.*.scene, pc, port)) {
                    app_log(a, "route: port already connected");
                } else {
                    a.*.route_c = pc;
                    a.*.route_p = port;
                    app_log(a, "route: select an input port");
                }
            } else {
                if (p.is_output) {
                    app_log(a, "route: target must be an input port");
                } else if (scene_port_in_use(a.*.scene, pc, port)) {
                    app_log(a, "route: input already driven");
                } else if (pc == a.*.route_c) {
                    app_log(a, "route: cannot loop a component to itself");
                } else {
                    let sci: i32 = scene_comp_index(a.*.scene, a.*.route_c);
                    let src: Comp = a.*.scene.*.comps.data[sci];
                    let start: Vox = comp_port_attach(src, a.*.route_p);
                    let goal: Vox = comp_port_attach(c, port);
                    let path: list.ArrayList[Vox] = list.make[Vox](32);
                    if (route_guide(a.*.scene, start, goal, &path)) {
                        let gid: i32 = scene_add_guide(a.*.scene, a.*.route_c, a.*.route_p, pc, port, path);
                        op_add_guide(&a.*.jrn, a.*.scene, gid);
                        a.*.sel_guide = gid;
                        a.*.sel.len = 0;
                        app_mark_dirty(a);
                        app_log(a, "waveguide routed");
                    } else {
                        list.free[Vox](&path);
                        app_log(a, "route: no path through the lattice");
                    }
                    a.*.route_c = 0 - 1;
                }
            }
        }
        return;
    }

    // select tool — track the component under the cursor for hover highlighting
    a.*.hover_comp = vp_pick_comp(a.*.scene, a.*.cam, vp, inp.*.mx, inp.*.my);
    if (a.*.box_sel) { a.*.hover_comp = 0 - 1; }
    if (btn_pressed(inp, 0)) {
        let hit: i32 = a.*.hover_comp;
        let dbl: bool = app_dblclick(a);
        if (hit < 0) {
            // empty press: begin a rubber-band box; clear/commit deferred to release
            a.*.box_sel = true;
            a.*.box_x0 = inp.*.mx;
            a.*.box_y0 = inp.*.my;
        } else {
            a.*.box_sel = false;
            if (shift_down(inp)) { sel_toggle(a, hit); }
            else { sel_set(a, hit); }
            // clicking a grouped part selects the whole group (Section 3.6)
            let gid: i32 = app_group_of(a, hit);
            if (gid >= 0 && !shift_down(inp)) { sel_add_group(a, gid); }
            // double-click frames the part (Section 3.9 behavior, in-viewport too)
            if (dbl) { app_frame_selected(a); }
        }
    }
    if (a.*.box_sel && btn_released(inp, 0)) {
        let dx: i32 = imax(a.*.box_x0 - inp.*.mx, inp.*.mx - a.*.box_x0);
        let dy: i32 = imax(a.*.box_y0 - inp.*.my, inp.*.my - a.*.box_y0);
        if (dx > 3 || dy > 3) {
            app_box_select(a, a.*.box_x0, a.*.box_y0, inp.*.mx, inp.*.my, shift_down(inp));
        } else if (!shift_down(inp)) {
            sel_clear(a);   // a plain click on empty space clears
        }
        a.*.box_sel = false;
    }
}

// ── keyboard ──────────────────────────────────────────────────────────────────

fn ctrl_down(inp: *Input) bool {
    return (inp.*.mods & 2) != 0;
}

fn alt_down(inp: *Input) bool { return (inp.*.mods & 4) != 0; }

fn app_keys(a: *App) void {
    let inp: *Input = &a.*.inp;

    // modal captures all typing
    if (a.*.modal != modal_none()) {
        app_modal_keys(a);
        return;
    }
    // RMB owns WASD/QE for fly navigation. Do not leak those presses into
    // Select/Route or other edit shortcuts.
    if (btn_down(inp, 2)) { return; }

    if (key_hit(inp, key_esc())) {
        if (a.*.ctx_open) { a.*.ctx_open = false; }
        else if (a.*.menu >= 0) { a.*.menu = 0 - 1; }
        else if (a.*.moving) { a.*.moving = false; }
        else if (a.*.measure_n > 0) { a.*.measure_n = 0; }
        else if (a.*.tool != tool_select()) { app_cancel(a); }
        else { sel_clear(a); }
    }


    // Top-level utility controls have direct keyboard access. Their active
    // state is the persistent visible focus/selection ring in the menu bar.
    if (alt_down(inp)) {
        if (key_hit(inp, 'o' as i32)) {
            a.*.opt_open = !a.*.opt_open; a.*.settings_open = false;
            a.*.opt_previewed = false; a.*.opt_details = false;
        }
        if (key_hit(inp, 'b' as i32)) {
            a.*.build_open = !a.*.build_open; a.*.settings_open = false;
            a.*.opt_open = false;
        }
        if (key_hit(inp, 's' as i32)) {
            a.*.settings_open = !a.*.settings_open; a.*.opt_open = false;
        }
        return;
    }

    if (ctrl_down(inp)) {
        if (key_hit(inp, 'k' as i32) || key_hit(inp, 'p' as i32)) {
            a.*.palette_open = true;
            a.*.palette_text.len = 0;
            a.*.palette_sel = 0;
        }
        if (key_hit(inp, 'n' as i32)) { app_new_design(a); }
        if (key_hit(inp, 'o' as i32)) { app_show_open(a); }
        if (key_hit(inp, 's' as i32)) {
            if (shift_down(inp)) { app_show_saveas(a); } else { app_save(a); }
        }
        if (key_hit(inp, 'z' as i32)) { app_undo(a); }
        if (key_hit(inp, 'y' as i32)) { app_redo(a); }
        if (key_hit(inp, 'c' as i32)) { app_copy(a); }
        if (key_hit(inp, 'v' as i32)) { app_paste(a); }
        if (key_hit(inp, 'g' as i32)) {
            if (shift_down(inp)) { app_ungroup_selection(a); }
            else { app_group_selection(a); }
        }
        if (key_hit(inp, 'q' as i32)) { a.*.quit = true; }
        return;
    }

    if (key_hit(inp, 'q' as i32)) { a.*.tool = tool_select(); }
    if (key_hit(inp, 'e' as i32)) {
        a.*.tool = tool_route();
        a.*.route_c = 0 - 1;
    }
    if (key_hit(inp, 'm' as i32)) {
        a.*.tool = tool_measure();
        a.*.measure_n = 0;
    }
    if (key_hit(inp, 'r' as i32)) {
        a.*.ghost_rot = (a.*.ghost_rot + 1) % 4;
        // with a selection in select mode, R rotates the part itself (journaled)
        if (a.*.tool == tool_select() && sel_primary(a) >= 0 && !a.*.moving) {
            if (app_is_locked(a, sel_primary(a))) {
                app_invalid(a, "rotate blocked: part is locked");
            } else {
                let ci_r: i32 = scene_comp_index(a.*.scene, sel_primary(a));
                if (ci_r >= 0) {
                    let nr: i32 = (a.*.scene.*.comps.data[ci_r].rot + 1) % 4;
                    let rv: i32 = op_rotate(&a.*.jrn, a.*.scene, sel_primary(a), nr);
                    if (rv == 0) { app_mark_dirty(a); app_log(a, "rotated"); }
                    else {
                        let rot_msg: []u8 = s2("cannot rotate: ", place_err_text(rv));
                        app_invalid(a, rot_msg);
                        _zag_str_free(rot_msg);
                    }
                }
            }
        }
    }
    // F2 renames the primary selection inline (committed in the outliner)
    if (key_hit(inp, 291) && sel_primary(a) >= 0) {
        a.*.rename_id = sel_primary(a);
        let ci_n: i32 = scene_comp_index(a.*.scene, a.*.rename_id);
        if (ci_n >= 0) {
            textedit_set(&a.*.rename_edit, a.*.scene.*.comps.data[ci_n].name_);
            a.*.rename_edit.focus = true;
        }
    }
    if (key_hit(inp, 'x' as i32) || key_hit(inp, key_del())) { app_delete_selection(a); }
    if (key_hit(inp, 'f' as i32)) { app_frame_selected(a); }
    if (key_hit(inp, key_home())) { app_frame_all(a); }
    if (key_hit(inp, 'g' as i32)) { app_start_move(a); }
    if (key_hit(inp, 'd' as i32) && shift_down(inp)) { app_duplicate(a); }
    if (key_hit(inp, key_space()) && inp.*.focus_index < 0) { a.*.sim.*.playing = !a.*.sim.*.playing; }
    // section (clip) view level (Section 3.5)
    if (a.*.sect_on && key_hit(inp, '[' as i32)) {
        if (a.*.sect_y > 0) { a.*.sect_y = a.*.sect_y - 1; }
        scene_mark_render(a.*.scene);
    }
    if (a.*.sect_on && key_hit(inp, ']' as i32)) {
        a.*.sect_y = a.*.sect_y + 1;
        scene_mark_render(a.*.scene);
    }
    if (key_hit(inp, 't' as i32)) {
        let pid: i32 = sel_primary(a);
        if (pid >= 0) {
            let ci: i32 = scene_comp_index(a.*.scene, pid);
            if (ci >= 0) {
                if (a.*.scene.*.comps.data[ci].kind == Kind.Emitter) {
                    // journaled property edit: preset cycling is a single undo
                    op_set_prop(&a.*.jrn, a.*.scene, pid, prop_preset(),
                                (a.*.scene.*.comps.data[ci].preset + 1) % 4);
                    app_mark_dirty(a);
                    app_log(a, "emitter pattern preset cycled");
                }
            }
        }
    }
    let ki: i32 = 0;
    while (ki < kind_count()) {
        if (key_hit(inp, ('1' as i32) + ki)) { a.*.tool = tool_place_base() + ki; }
        ki = ki + 1;
    }
}

// text entry for the Save As modal
fn app_modal_keys(a: *App) void {
    let inp: *Input = &a.*.inp;
    if (a.*.modal == modal_permission()) {
        if (key_hit(inp, key_enter())) { app_permission_allow_once(a); }
        else if (key_hit(inp, key_esc())) { app_permission_keep_read_only(a); }
        return;
    }
    if (key_hit(inp, key_esc())) {
        a.*.modal = modal_none();
        return;
    }
    if (a.*.modal == modal_saveas()) {
        let i: i32 = 0;
        while (i < inp.*.keys.len) {
            let k: i32 = list.get[i32](inp.*.keys, i);
            if (k == key_backspace()) {
                if (a.*.modal_text.len > 0) { a.*.modal_text.len = a.*.modal_text.len - 1; }
            } else if (k == key_enter()) {
                app_saveas_commit(a);
            } else if (k >= 32 && k < 127 && a.*.modal_text.len < 60) {
                list.push[u8](&a.*.modal_text, k as u8);
            }
            i = i + 1;
        }
    }
}

fn app_saveas_commit(a: *App) void {
    if (a.*.modal_text.len == 0) { return; }
    let name_: []u8 = _zag_strdup(a.*.modal_text.data[0..a.*.modal_text.len]);
    // append .zpa when missing
    let has_ext: bool = false;
    if (name_.len > 4) {
        let e: i32 = name_.len;
        if ((name_[e - 4] as i32) == '.' && (name_[e - 3] as i32) == 'z' &&
            (name_[e - 2] as i32) == 'p' && (name_[e - 1] as i32) == 'a') { has_ext = true; }
    }
    if (!has_ext) {
        let ext: []u8 = s2(name_, ".zpa");
        _zag_str_free(name_);
        name_ = ext;
    }
    _zag_str_free(a.*.file_);
    a.*.file_ = name_;
    a.*.modal = modal_none();
    a.*.title_dirty = true;
    app_save(a);
}
