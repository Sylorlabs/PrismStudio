@import("../src/gpu_isa_raster.zag")

fn check(name_:[]u8,ok:bool,failures:*i32)void{if(ok){_zag_print("  ok  ");}else{_zag_print("  XX  ");failures.*=failures.*+1;}_zag_println(name_);}

fn rng_next(state:*i64)i64{state.*=(state.* * 1103515245+12345)%2147483648;return state.*;}

fn main()i32{
    let failures:i32=0;let cmds:list.ArrayList[GpuRasterCmd]=list.make[GpuRasterCmd](4);
    list.push[GpuRasterCmd](&cmds,GpuRasterCmd{.x=4,.y=3,.w=40,.h=30,.depth=50,.color=rgb(220,30,20),.alpha=256});
    list.push[GpuRasterCmd](&cmds,GpuRasterCmd{.x=12,.y=9,.w=30,.h=25,.depth=20,.color=rgb(20,200,80),.alpha=128});
    list.push[GpuRasterCmd](&cmds,GpuRasterCmd{.x=0-7,.y=35,.w=30,.h=20,.depth=10,.color=rgb(40,80,230),.alpha=64});
    let cpu:FB=fb_new(64,48);gpu_raster_reference(&cpu,rgb(8,10,14),cmds);
    let unit:GpuIsaRaster=gpu_isa_raster_open("examples/gpu_fill_kernel.zgk","examples/gpu_depth_kernel.zgk","examples/gpu_blend_kernel.zgk",8,8,8);
    let unit_fill:bool=gpu_isa_raster_fill_span(&unit,0,8,7,false)&&gpu_isa_raster_fill_span(&unit,0,8,100,true);
    check("color and depth clear spans execute through the fill ISA",unit_fill,&failures);
    check("depth-write span executes through load compare branch and stores",unit_fill&&gpu_isa_raster_depth_span(&unit,0,8,9,50),&failures);
    check("blend span executes compiler-owned packed RGB instructions",unit_fill&&gpu_isa_raster_blend_span(&unit,0,8,rgb(255,0,0),40,128),&failures);
    let out:FB=fb_new(64,48);let r:GpuIsaRaster=gpu_isa_raster_open("examples/gpu_fill_kernel.zgk","examples/gpu_depth_kernel.zgk","examples/gpu_blend_kernel.zgk",64,48,16);
    check("fill depth and blend bundles are independently compiler-owned and validated",r.ok,&failures);
    let ran:bool=gpu_isa_raster_dispatch(&r,rgb(8,10,14),cmds);
    check("real decoded ISA executes tiled clear geometry clipping depth and alpha composite",ran&&r.stage_mask==63,&failures);
    check("every completed tile owns a strictly monotonic fence",gpu_isa_raster_fenced(&r),&failures);
    check("only the complete guarded frame can present",gpu_isa_raster_present(&r,&out),&failures);
    check("compiler-ISA raster frame is pixel-identical to independent CPU oracle",gpu_raster_diff(&cpu,&out)==0,&failures);
    check("depth buffer is also exact after conditional stores",cpu.zb.len==out.zb.len&&gpu_isa_raster_depth_equal(&cpu,&out),&failures);
    let untouched:FB=fb_new(16,16);untouched.px.data[0]=0x55AA33;
    let incomplete:GpuIsaRaster=gpu_isa_raster_open("examples/gpu_fill_kernel.zgk","examples/gpu_depth_kernel.zgk","examples/gpu_blend_kernel.zgk",16,16,8);
    check("incomplete ISA frame cannot modify the retained front buffer",!gpu_isa_raster_present(&incomplete,&untouched)&&untouched.px.data[0]==0x55AA33,&failures);
    let shadow_cpu:FB=fb_new(64,48);gpu_raster_reference(&shadow_cpu,rgb(8,10,14),cmds);let shadow_front:FB=fb_new(64,48);
    let shadow:GpuIsaRaster=gpu_isa_raster_open("examples/gpu_fill_kernel.zgk","examples/gpu_depth_kernel.zgk","examples/gpu_blend_kernel.zgk",64,48,16);
    check("ISA shadow promotes only an exact complete CPU-authoritative frame",gpu_isa_raster_shadow_frame(&shadow,&shadow_cpu,&shadow_front,rgb(8,10,14),cmds,77,9001)&&gpu_raster_diff(&shadow_cpu,&shadow_front)==0,&failures);
    let mismatch_candidate:FB=fb_new(64,48);gpu_isa_raster_copy(&shadow_cpu,&mismatch_candidate);mismatch_candidate.px.data[7]=mismatch_candidate.px.data[7]+1;
    let mismatch_front:FB=fb_new(64,48);let mismatch:GpuIsaRaster=gpu_isa_raster_open("examples/gpu_fill_kernel.zgk","examples/gpu_depth_kernel.zgk","examples/gpu_blend_kernel.zgk",64,48,16);
    check("ISA mismatch captures input images diff logs tuple disables session and falls back to CPU",
        !gpu_isa_raster_shadow_complete(&mismatch,&shadow_cpu,&mismatch_candidate,&mismatch_front,78,9001,
            gpu_isa_raster_input(rgb(8,10,14),cmds),"source=software-vm kernel_driver_logs=not-applicable\n")&&
        !mismatch.ok&&gpu_raster_diff(&shadow_cpu,&mismatch_front)==0&&
        _zag_file_exists("/tmp/prism_gpu_mismatch.txt")==1&&
        _zag_file_exists("/tmp/prism_gpu_mismatch_input.txt")==1&&
        _zag_file_exists("/tmp/prism_gpu_mismatch_logs.txt")==1&&
        _zag_read_file("/tmp/prism_gpu_mismatch_input.txt").len>0&&
        _zag_read_file("/tmp/prism_gpu_mismatch_logs.txt").len>0,&failures);
    let randomized_ok:bool=true;let seed:i64=1234567;let scene:i32=0;
    while(scene<64&&randomized_ok){
        let rc:list.ArrayList[GpuRasterCmd]=list.make[GpuRasterCmd](16);let ci:i32=0;
        while(ci<16){
            let x:i32=(rng_next(&seed)%80) as i32-16;let y:i32=(rng_next(&seed)%64) as i32-16;
            let w:i32=(rng_next(&seed)%32) as i32+1;let h:i32=(rng_next(&seed)%24) as i32+1;
            let z:i64=rng_next(&seed)%200;let color:i64=rng_next(&seed)&0xFFFFFF;let alpha:i32=(rng_next(&seed)%257) as i32;
            list.push[GpuRasterCmd](&rc,GpuRasterCmd{.x=x,.y=y,.w=w,.h=h,.depth=z,.color=color,.alpha=alpha});ci=ci+1;
        }
        let ro:FB=fb_new(48,32);gpu_raster_reference(&ro,scene as i64,rc);let rf:FB=fb_new(48,32);
        let rr:GpuIsaRaster=gpu_isa_raster_open("examples/gpu_fill_kernel.zgk","examples/gpu_depth_kernel.zgk","examples/gpu_blend_kernel.zgk",48,32,16);
        if(!gpu_isa_raster_shadow_frame(&rr,&ro,&rf,scene as i64,rc,seed,9001)||gpu_raster_diff(&ro,&rf)!=0||!gpu_isa_raster_depth_equal(&ro,&rf)){randomized_ok=false;}
        scene=scene+1;
    }
    check("64 seeded randomized alpha depth and clipping scenes match CPU exactly",randomized_ok&&scene==64,&failures);
    // Long but safe software certification: every iteration rebuilds metadata-owned
    // PM4, validates all 59 compiler instruction words, executes them, and crosses
    // an explicit release/submit/exact-fence/acquire ownership boundary.
    let campaign:GpuIsaRaster=gpu_isa_raster_open("examples/gpu_fill_kernel.zgk","examples/gpu_depth_kernel.zgk","examples/gpu_blend_kernel.zgk",8,8,8);
    let dispatch:i64=0;let campaign_ok:bool=true;
    while(dispatch<1000000&&campaign_ok){
        let pixel:i32=(dispatch%64) as i32;let color:i64=(dispatch*2654435761)&0xFFFFFF;
        let z:i64=1000000-dispatch;let alpha:i32=(dispatch%257) as i32;
        campaign_ok=gpu_isa_raster_blend_span(&campaign,pixel,1,color,z,alpha);
        dispatch=dispatch+1;
    }
    check("one million varied decoded raster dispatches retire exact fences with no quarantine",
        campaign_ok&&dispatch==1000000&&campaign.queue.submissions==1000000&&
        campaign.queue.instructions==59000000&&campaign.queue.last_fence==1000000&&
        campaign.queue.owner==0&&!campaign.queue.disabled,&failures);
    let bad:list.ArrayList[GpuRasterCmd]=list.make[GpuRasterCmd](1);list.push[GpuRasterCmd](&bad,GpuRasterCmd{.x=0,.y=0,.w=1,.h=1,.depth=1,.color=1,.alpha=257});
    let r2:GpuIsaRaster=gpu_isa_raster_open("examples/gpu_fill_kernel.zgk","examples/gpu_depth_kernel.zgk","examples/gpu_blend_kernel.zgk",16,16,8);
    check("out-of-contract alpha fails closed before any ISA dispatch",!gpu_isa_raster_dispatch(&r2,0,bad),&failures);
    if(failures==0){_zag_println("GPU ISA RASTER: ALL PASS");return 0;}_zag_println("GPU ISA RASTER: FAILURES");return 1;
}
