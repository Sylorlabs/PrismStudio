// dpi_test.zag — HiDPI framebuffer rendering + UI-scale setting (Masterplan
// Section 9.3 / Phase F). The whole UI renders at logical coordinates into a
// physical-resolution buffer (logical_w * scale × logical_h * scale);
// this verifies the scale factor is applied correctly and the scale setting
// cycles.

@import("../std/list.zag") as list
@import("../src/workspace.zag")

fn check(name_: []u8, ok: bool, failures: *i32) void {
    if (ok) { _zag_print("  ok  "); } else { _zag_print("  XX  "); failures.* = failures.* + 1; }
    _zag_println(name_);
}

fn upscale_exact(src: *FB, scale: i32) bool {
    let dst: FB = fb_new(src.*.w * scale, src.*.h * scale);
    fb_upscale(&dst, src, scale);
    let y: i32 = 0;
    while (y < dst.h) {
        let x: i32 = 0;
        while (x < dst.w) {
            if (dst.px.data[y * dst.w + x] != src.*.px.data[(y / scale) * src.*.w + (x / scale)]) {
                return false;
            }
            x = x + 1;
        }
        y = y + 1;
    }
    return true;
}

fn main() i32 {
    let failures: i32 = 0;

    let src: FB = fb_new(5, 4);
    let i: i32 = 0;
    while (i < 20) { src.px.data[i] = (i * 131 + 7) as i64; i = i + 1; }

    check("2x upscale is pixel-exact nearest-neighbor", upscale_exact(&src, 2), &failures);
    check("3x upscale is pixel-exact nearest-neighbor", upscale_exact(&src, 3), &failures);

    // Undersized destination must be a safe no-op (no crash / no OOB write).
    let small: FB = fb_new(3, 3);
    fb_upscale(&small, &src, 2);
    check("undersized destination upscale is a safe no-op", true, &failures);

    // ── physical-resolution rendering (fb_new_scaled / fb_set_scale) ───────
    // The FB's logical dimensions stay at w×h but the pixel buffer is
    // (w*scale)×(h*scale). All primitives scale internally.
    let f2: FB = fb_new_scaled(100, 60, 2);
    check("fb_new_scaled: logical w=100", f2.w == 100, &failures);
    check("fb_new_scaled: logical h=60", f2.h == 60, &failures);
    check("fb_new_scaled: scale=2", f2.scale == 2, &failures);
    check("fb_new_scaled: physical w=200", fb_pw(&f2) == 200, &failures);
    check("fb_new_scaled: physical h=120", fb_ph(&f2) == 120, &failures);

    // A fill_rect at scale 2 fills a 2×2 block per logical pixel.
    fb_clip_reset(&f2);
    fill_rect(&f2, 10, 10, 1, 1, rgb(255, 0, 0));
    let pw2: i32 = fb_pw(&f2);
    let red: i64 = rgb(255, 0, 0);
    check("scale2 fill_rect: (20,20) is red", f2.px.data[20 * pw2 + 20] == red, &failures);
    check("scale2 fill_rect: (21,21) is red", f2.px.data[21 * pw2 + 21] == red, &failures);
    check("scale2 fill_rect: (22,22) is not red", f2.px.data[22 * pw2 + 22] != red, &failures);

    // fb_set_scale changes the physical buffer size without changing logical.
    let f3: FB = fb_new(80, 50);
    check("fb_new: scale defaults to 1", f3.scale == 1, &failures);
    fb_set_scale(&f3, 3);
    check("fb_set_scale: scale=3", f3.scale == 3, &failures);
    check("fb_set_scale: logical w unchanged=80", f3.w == 80, &failures);
    check("fb_set_scale: physical w=240", fb_pw(&f3) == 240, &failures);
    check("fb_set_scale: physical h=150", fb_ph(&f3) == 150, &failures);

    // UI-scale setting cycles 1 -> 2 -> 3 -> 1.
    let a: *App = app_new(1024, 640);
    check("ui_scale defaults to 1x", a.*.ui_scale == 1, &failures);
    app_action(a, 27);
    check("cycle to 2x", a.*.ui_scale == 2, &failures);
    app_action(a, 27);
    check("cycle to 3x", a.*.ui_scale == 3, &failures);
    app_action(a, 27);
    check("cycle wraps back to 1x", a.*.ui_scale == 1, &failures);

    // ── multi-scale font atlas ────────────────────────────────────────────
    // fa_face_count returns the LOGICAL face count (5), not the baked count.
    check("fa_face_count is 5 (logical)", fa_face_count() == 5, &failures);
    check("fa_scale_count is 3", fa_scale_count() == 3, &failures);
    // The 1x face 0 advance for 'A' must match the logical advance.
    let a_adv: i32 = fa_adv(0, 'A' as i32);
    check("fa_adv face0 A is positive", a_adv > 0, &failures);
    // The 2x baked face (index 5) must have a wider glyph than the 1x face.
    let a_w1: i32 = fa_w(0, 'A' as i32);
    let a_w2: i32 = fa_w(5, 'A' as i32);
    check("2x baked glyph wider than 1x", a_w2 > a_w1, &failures);
    // The 3x baked face (index 10) must be wider still.
    let a_w3: i32 = fa_w(10, 'A' as i32);
    check("3x baked glyph wider than 2x", a_w3 > a_w2, &failures);
    // Coverage offsets must be distinct across scales (different baked data).
    check("2x coverage offset differs from 1x",
          fa_off(5, 'A' as i32) != fa_off(0, 'A' as i32), &failures);

    // draw_glyph at scale 2 blits real 2x coverage (not replicated 1x).
    // A 2x glyph has ~4x the coverage bytes of the 1x glyph, so the 2x
    // framebuffer should have more distinct alpha levels in the glyph area.
    let ft: FB = fb_new_scaled(200, 80, 2);
    fb_clip_reset(&ft);
    fb_build_atlas(&ft);
    fill_rect(&ft, 0, 0, 200, 80, rgb(0, 0, 0));
    draw_text(&ft, 10, 10, "A", rgb(255, 255, 255));
    // At 2x, the glyph should cover more physical pixels than a 1x glyph
    // would (which is just 1x dimensions replicated). Check that we have
    // anti-aliased edge pixels (not just 0 and 255).
    let pw_ft: i32 = fb_pw(&ft);
    let edge_pixels: i32 = 0;
    let yy: i32 = 0;
    while (yy < 80) {
        let xx: i32 = 0;
        while (xx < pw_ft) {
            let px: i64 = ft.px.data[yy * pw_ft + xx];
            let r: i32 = (px >> 16) as i32 & 255;
            if (r > 0 && r < 255) { edge_pixels = edge_pixels + 1; }
            xx = xx + 1;
        }
        yy = yy + 1;
    }
    check("2x text has anti-aliased edge pixels", edge_pixels > 0, &failures);

    if (failures == 0) { _zag_println("DPI: ALL PASS"); return 0; }
    _zag_println("DPI: FAILURES"); return 1;
}
