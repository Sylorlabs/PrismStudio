// Continuous optimizer scheduling soak: alternates active simulation/editing
// with idle slices where the optimizer may run, and proves interaction/save
// budgets remain bounded. The optimizer never executes on a critical path.
@import("../src/workspace.zag")
@import("../src/agent.zag")

fn check(name_: []u8, ok: bool, failures: *i32) void {
    if (ok) { _zag_print("  ok  "); } else { _zag_print("  XX  "); failures.* = failures.* + 1; }
    _zag_println(name_);
}

fn main() i32 {
    let failures: i32 = 0;
    let a: *App = app_new(1024, 640);
    let _p: i32 = scene_place(a.*.scene, Kind.Plate, vox(0, 0, 0), 0);
    let e: i32 = scene_place(a.*.scene, Kind.Emitter, vox(1, 1, 2), 0);
    let c: i32 = scene_place(a.*.scene, Kind.Chamber, vox(4, 1, 3), 0);
    let d: i32 = scene_place(a.*.scene, Kind.Detector, vox(7, 1, 4), 0);
    let _r: bool = flash_route(a.*.scene, e, 0, c, 0) && flash_route(a.*.scene, c, 3, d, 0);
    let _dead_e: i32 = scene_place(a.*.scene, Kind.Emitter, vox(1, 1, 7), 0);
    let _dead_c: i32 = scene_place(a.*.scene, Kind.Chamber, vox(4, 1, 7), 0);
    a.*.opt.*.cpu_budget_pct = 5;
    a.*.opt.*.time_budget_ms = 100;
    a.*.opt.*.quiet_start_hour = 0;
    a.*.opt.*.quiet_end_hour = 0;
    // Establish one verified proposal deterministically, then start a fresh
    // campaign for the frame soak. Host sensor pressure may legitimately
    // suppress later app-driven background slices.
    let warm: i32 = 0;
    while (warm < 128 && !a.*.opt.*.has_pending && !a.*.opt.*.suspended) {
        a.*.opt.*.cpu_window_start_ms = 0;
        let _warm_slice: bool = opt_engine_refresh_keyed(a.*.opt, a.*.scene);
        warm = warm + 1;
    }
    let verified_seen: bool = a.*.opt.*.has_pending;
    opt_engine_clear_pending(a.*.opt);
    scene_mark_render(a.*.scene);
    a.*.opt.*.cpu_window_start_ms = 0;
    let _first_slice: bool = opt_engine_refresh_keyed(a.*.opt, a.*.scene);
    let campaign_started: bool = a.*.opt.*.work_active && a.*.opt.*.work_slices > 0;

    let n: i32 = 1800;
    let over16: i32 = 0;
    let max_ms: i64 = 0;
    let idle_frames: i32 = 0;
    let active_frames: i32 = 0;
    let agent_requests: i32 = 0;
    let max_agent_ms: i64 = 0;
    let f: i32 = 0;
    while (f < n) {
        // 120 frames of simulation/edit activity, then 180 idle frames. The
        // cadence guarantees at least one eligible optimizer slice per cycle.
        let active: bool = (f % 300) < 120;
        a.*.sim.*.playing = active;
        if (active) { active_frames = active_frames + 1; } else { idle_frames = idle_frames + 1; }
        if (f % 300 == 20) {
            a.*.inp.keys.len = 0;
            list.push[i32](&a.*.inp.keys, 'q' as i32); // real input dispatch
        }
        // Dispatch through the same parser and command layer as --agent while
        // the campaign is alive.  This catches accidental optimizer coupling to
        // agent request latency without requiring a second implementation path.
        if (f % 300 == 170) {
            let at0: i64 = _zag_clock_monotonic_ms();
            agent_run_line(a, "status");
            let adt: i64 = _zag_clock_monotonic_ms() - at0;
            if (adt > max_agent_ms) { max_agent_ms = adt; }
            agent_requests = agent_requests + 1;
        }
        let t0: i64 = _zag_clock_monotonic_ms();
        app_frame(a, 0.016);
        let dt: i64 = _zag_clock_monotonic_ms() - t0;
        if (dt > max_ms) { max_ms = dt; }
        if (dt > 16) { over16 = over16 + 1; }
        f = f + 1;
    }

    let save_t0: i64 = _zag_clock_monotonic_ms();
    let saved: bool = design_save(a.*.scene, "/tmp/prism_opt_soak.zpa");
    let save_ms: i64 = _zag_clock_monotonic_ms() - save_t0;
    check("soak exercised both simulation/edit and optimizer-idle windows",
        active_frames > 0 && idle_frames > 0, &failures);
    check("optimizer surfaced verified work without mutating by default",
        verified_seen && campaign_started &&
        !a.*.opt.*.auto_apply && a.*.opt.*.applied_count == 0, &failures);
    check("continuous scheduling caused no dropped interaction frames",
        over16 == 0 && max_ms <= 16, &failures);
    check("save remains responsive while optimizer campaign is active",
        saved && save_ms < 100, &failures);
    check("agent requests remain responsive while optimizer campaign is active",
        agent_requests == 6 && max_agent_ms < 100, &failures);
    check("scene remains valid after the continuous campaign",
        scene_validation_errors(a.*.scene) == 0, &failures);
    if (failures == 0) { _zag_println("OPT SOAK: ALL PASS"); return 0; }
    _zag_println("OPT SOAK: FAILURES"); return 1;
}
